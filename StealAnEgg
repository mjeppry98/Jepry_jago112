-- ═══════════ HATCH ═══════════
local function hatchAll(session)
    local snapshot = Remotes.LiveSnapshot
    local hatchRemote = Remotes.Hatch
    local finishRemote = Remotes.FinishHatch
    if not snapshot or not hatchRemote or not finishRemote then return end

    State.Status = "🥚 Hatching..."
    local ok, data = pcall(function() return snapshot:InvokeServer() end)
    if not ok or type(data) ~= "table" then return end

    local uidList = {}
    for uid, rec in pairs(data) do
        if type(rec) == "table" and rec.OwnerUserId == LocalPlayer.UserId then
            for u in pairs(rec.Records or {}) do
                table.insert(uidList, u)
            end
        end
    end

    for _, uid in ipairs(uidList) do
        if session and State.Session ~= session then return end
        pcall(function()
            if hatchRemote:IsA("RemoteFunction") then
                hatchRemote:InvokeServer(uid)
            else
                hatchRemote:FireServer(uid)
            end
        end)
        task.wait(0.9)
        pcall(function()
            if finishRemote:IsA("RemoteFunction") then
                finishRemote:InvokeServer(uid)
            else
                finishRemote:FireServer(uid)
            end
        end)
        task.wait(0.1)
    end
end

