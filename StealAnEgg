                elseif obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency = 1 table.insert(FpsState.removed, obj)
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Beam") or obj:IsA("Light") then obj.Enabled = false table.insert(FpsState.removed, obj) end
            end)
        end
    else
        for _, obj in ipairs(FpsState.removed) do
            pcall(function()
                if obj and obj.Parent then
                    if obj:IsA("BasePart") then obj.Transparency = 0 obj.CanCollide = true obj.CastShadow = true
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency = 0
                    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Beam") or obj:IsA("Light") then obj.Enabled = true end
                end
            end)
        end
        FpsState.removed = {}
    end
end

local function applyFPSShadows(state)
    if state then
        if not FpsState.lightingSnap then FpsState.lightingSnap = { GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd, Brightness = Lighting.Brightness, Ambient = Lighting.Ambient } end
        Lighting.GlobalShadows = false Lighting.FogEnd = 100000 Lighting.Brightness = 2
        for _, obj in ipairs(Workspace:GetDescendants()) do pcall(function() if obj:IsA("BasePart") then obj.CastShadow = false end end) end
    else
        if FpsState.lightingSnap then
            Lighting.GlobalShadows = FpsState.lightingSnap.GlobalShadows Lighting.FogEnd = FpsState.lightingSnap.FogEnd Lighting.Brightness = FpsState.lightingSnap.Brightness Lighting.Ambient = FpsState.lightingSnap.Ambient
        else Lighting.GlobalShadows = true end
    end
end

local function applyFPSTextures(state)
    if state then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            pcall(function()
                if obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency = 1
                elseif obj:IsA("BasePart") and obj.Material ~= Enum.Material.SmoothPlastic then obj.Material = Enum.Material.SmoothPlastic end
            end)
        end
    end
end

