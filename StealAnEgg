-- ═══════════ FPS BOOST ═══════════
local FpsState = { lightingSnap = nil, removed = {} }

local function isImportant(inst)
    if not inst then return true end
    local n = inst.Name:lower()
    if n:find("egg") or n:find("monster") or n:find("guard") or n:find("npc")
        or n:find("boss") or n:find("pet") or n:find("player") then return true end
    if inst:GetAttribute("IsEgg") or inst:GetAttribute("IsMonster") then return true end
    if inst.Name == "HumanoidRootPart" or inst.Name == "Humanoid" then return true end
    return false
end

local function applyFPSObjects(state)
    if state then
        FpsState.removed = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if isImportant(obj) then continue end
            local isPlayerPart = false
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character and obj:IsDescendantOf(plr.Character) then
                    isPlayerPart = true break
                end
            end
            if isPlayerPart then continue end

            pcall(function()
                if obj:IsA("BasePart") then
                    obj.Transparency = 1
                    obj.CanCollide = false
                    obj.CastShadow = false
                    table.insert(FpsState.removed, obj)
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = 1
                    table.insert(FpsState.removed, obj)
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                    or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
                    or obj:IsA("Beam") or obj:IsA("Light") then
                    obj.Enabled = false
                    table.insert(FpsState.removed, obj)
                end
            end)
        end
    else
        for _, obj in ipairs(FpsState.removed) do
            pcall(function()
                if obj and obj.Parent then
                    if obj:IsA("BasePart") then
                        obj.Transparency = 0
                        obj.CanCollide = true
                        obj.CastShadow = true
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then
                        obj.Transparency = 0
                    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                        or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
                        or obj:IsA("Beam") or obj:IsA("Light") then
                        obj.Enabled = true
                    end
                end
            end)
        end
        FpsState.removed = {}
    end
end

local function applyFPSShadows(state)
    if state then
        if not FpsState.lightingSnap then
            FpsState.lightingSnap = {
                GlobalShadows = Lighting.GlobalShadows,
                FogEnd = Lighting.FogEnd,
                Brightness = Lighting.Brightness,
                Ambient = Lighting.Ambient,
            }
        end
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.Brightness = 2
        for _, obj in ipairs(Workspace:GetDescendants()) do
            pcall(function()
                if obj:IsA("BasePart") then obj.CastShadow = false end
            end)
        end
    else
        if FpsState.lightingSnap then
            Lighting.GlobalShadows = FpsState.lightingSnap.GlobalShadows
            Lighting.FogEnd = FpsState.lightingSnap.FogEnd
            Lighting.Brightness = FpsState.lightingSnap.Brightness
            Lighting.Ambient = FpsState.lightingSnap.Ambient
        else
            Lighting.GlobalShadows = true
        end
    end
end

local function applyFPSTextures(state)
    if state then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            pcall(function()
                if obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = 1
                elseif obj:IsA("BasePart") and obj.Material ~= Enum.Material.SmoothPlastic then
                    obj.Material = Enum.Material.SmoothPlastic
                end
            end)
        end
    end
end

local function applyFPSLowGraphics(state)
    if state then
        applyFPSShadows(true)
        applyFPSTextures(true)
        pcall(function()
            for _, fx in ipairs(Lighting:GetChildren()) do
                if fx:IsA("PostEffect") or fx:IsA("BloomEffect") or fx:IsA("BlurEffect")
                    or fx:IsA("ColorCorrectionEffect") or fx:IsA("SunRaysEffect")
                    or fx:IsA("DepthOfFieldEffect") or fx:IsA("Atmosphere") then
                    fx.Enabled = false
                end
            end
        end)
    end
end

-- ═══════════ GODMODE ═══════════
local function applyGodmode(state)
    local char, hum = getChar()
    if not hum then return end
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, not state)
    if state and hum.Health < 100 then hum.Health = 100 end
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanTouch = not state
            end
        end
    end
end

