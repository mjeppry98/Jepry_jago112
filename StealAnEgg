-- ═══════════ ANTI-DETECTION HELPERS ═══════════
local function randomDelay(base, variance)
    if not Stealth.RandomDelays then return task.wait(base) end
    variance = variance or 0.3
    local jitter = (math.random() * 2 - 1) * variance
    task.wait(math.max(0.05, base + jitter))
end

-- Human-like micro-movement sebelum aksi (mengelabui pattern detection)
local function humanJitter()
    if not Stealth.MovementJitter then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function()
        local jitterX = (math.random() - 0.5) * 0.15
        local jitterZ = (math.random() - 0.5) * 0.15
        hrp.CFrame = hrp.CFrame * CFrame.new(jitterX, 0, jitterZ)
    end)
end

-- Gradual teleport (menggantikan teleport instan yang mencurigakan)
local function safeTeleport(targetCFrame, speed)
    speed = speed or 45
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    if not Stealth.DisableTeleport then
        hrp.CFrame = targetCFrame
        return true
    end

    -- Gerakan bertahap supaya tidak terdeteksi speed hack
    local startPos = hrp.Position
    local endPos = targetCFrame.Position
    local distance = (endPos - startPos).Magnitude
    if distance < 3 then return true end

    local step = 0
    local totalSteps = math.clamp(math.floor(distance / 3), 1, 80)
    while step < totalSteps do
        if not LocalPlayer.Character then break end
        local current = hrp.Position
        local dir = (endPos - current).Unit
        hrp.CFrame = CFrame.new(current + dir * 3) * (targetCFrame - targetCFrame.Position)
        hrp.AssemblyLinearVelocity = Vector3.zero
        step = step + 1
        task.wait(math.max(0.01, 0.015 + math.random() * 0.02))
    end
    hrp.CFrame = targetCFrame
    return true
end

