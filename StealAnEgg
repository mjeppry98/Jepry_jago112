-- ═══════════ REMOTE FINDER ═══════════
local function findRemote(name, alt)
    local roots = {
        ReplicatedStorage,
        ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking"),
        ReplicatedStorage:FindFirstChild("Network"),
    }
    for _, root in ipairs(roots) do
        if root then
            local r = root:FindFirstChild(name) or (alt and root:FindFirstChild(alt))
            if r then return r end
            local d = root:FindFirstChild(name, true) or (alt and root:FindFirstChild(alt, true))
            if d then return d end
        end
    end
    local tail = string.match(name, "[^/]+$")
    if tail then
        return ReplicatedStorage:FindFirstChild(tail, true)
    end
    return nil
end

