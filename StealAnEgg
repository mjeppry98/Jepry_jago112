local function buildTargetHUD()
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    local old = pg:FindFirstChild("JepryTargetHUD")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "JepryTargetHUD"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 100
    gui.Parent = pg

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 290, 0, 240)
    frame.Position = UDim2.new(0, 15, 0.5, -120)
    frame.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
    frame.BackgroundTransparency = 0.08
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(70, 70, 90)
    stroke.Thickness = 1.2
    stroke.Parent = frame

    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 32)
    titleBar.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    titleBar.BorderSizePixel = 0
    titleBar.Parent = frame
    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(0, 12)
    tc.Parent = titleBar

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 1, 0)
    title.Position = UDim2.new(0, 12, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = "🎯 JEPRY TARGET"
    title.TextColor3 = Color3.fromRGB(240, 240, 250)
    title.TextSize = 13
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = titleBar

    local body = Instance.new("Frame")
    body.Size = UDim2.new(1, 0, 1, -32)
    body.Position = UDim2.new(0, 0, 0, 32)
    body.BackgroundTransparency = 1
    body.Parent = frame

    local function row(order, label)
        local r = Instance.new("Frame")
        r.Size = UDim2.new(1, -20, 0, 24)
        r.Position = UDim2.new(0, 10, 0, order * 24 + 6)
        r.BackgroundTransparency = 1
        r.Parent = body

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.42, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = label
        lbl.TextColor3 = Color3.fromRGB(130, 130, 145)
        lbl.TextSize = 11
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = r

        local val = Instance.new("TextLabel")
        val.Size = UDim2.new(0.58, 0, 1, 0)
        val.Position = UDim2.new(0.42, 0, 0, 0)
        val.BackgroundTransparency = 1
        val.Text = "—"
        val.TextColor3 = Color3.fromRGB(240, 240, 250)
        val.TextSize = 11
        val.Font = Enum.Font.GothamBold
        val.TextXAlignment = Enum.TextXAlignment.Right
        val.TextTruncate = Enum.TextTruncate.AtEnd
        val.Parent = r
        return val
    end

    local vTarget   = row(0, "🥚 Target")
    local vRarity   = row(1, "✨ Rarity")
    local vZone     = row(2, "🌍 Zone")
    local vScore    = row(3, "🏆 Priority")
    local vFilters  = row(4, "⚙️ Filters")
    local vMode     = row(5, "📡 Mode")
    local vFound    = row(6, "🔍 Matches")

    return {
        gui = gui, frame = frame,
        vTarget = vTarget, vRarity = vRarity, vZone = vZone,
        vScore = vScore, vFilters = vFilters, vMode = vMode, vFound = vFound,
    }
end

local TargetHUD = buildTargetHUD()

task.spawn(function()
    while TargetHUD.gui.Parent do
        task.wait(0.4)
        pcall(function()
            local target = State.CurrentTarget

            -- Filters
            local zCount, rCount = 0, 0
            for _, v in pairs(CONFIG.SelectedZones) do if v then zCount = zCount + 1 end end
            for _, v in pairs(CONFIG.SelectedRarities) do if v then rCount = rCount + 1 end end
            TargetHUD.vFilters.Text = string.format("%d/12 · %d/10", zCount, rCount)
            TargetHUD.vFilters.TextColor3 = (zCount == 0 and rCount == 0)
                and Color3.fromRGB(255, 200, 80)
                or Color3.fromRGB(80, 220, 120)

            if target then
                TargetHUD.vTarget.Text = tostring(target.name or "Egg"):sub(1, 22)
                TargetHUD.vTarget.TextColor3 = Color3.fromRGB(255, 235, 130)

                TargetHUD.vRarity.Text = tostring(target.rarity)
                TargetHUD.vRarity.TextColor3 = RarityColors[target.rarity] or Color3.fromRGB(200, 200, 200)

                TargetHUD.vZone.Text = tostring(target.realZone or target.zone)
                TargetHUD.vZone.TextColor3 = Color3.fromRGB(150, 230, 255)

                TargetHUD.vScore.Text = tostring(target.score or 0)
                TargetHUD.vScore.TextColor3 = (target.score or 0) >= 400000
                    and Color3.fromRGB(255, 100, 100)
                    or Color3.fromRGB(255, 180, 100)
            else
                TargetHUD.vTarget.Text = "—"
                TargetHUD.vRarity.Text = "—"
                TargetHUD.vZone.Text = "—"
                TargetHUD.vScore.Text = "—"
            end

            -- Matches count
            local _, mcount = findBestTarget()
            TargetHUD.vFound.Text = tostring(mcount or 0)

            -- Status
            TargetHUD.vMode.Text = State.Status or "Idle"
        end)
    end
end)

