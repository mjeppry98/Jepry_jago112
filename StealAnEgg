local function getChar()
    local char = LocalPlayer.Character
    if not char or not char.Parent then char = LocalPlayer.CharacterAdded:Wait() end
    return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

local function isEgg(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local n = string.lower(tool.Name)
    if n:find("sword") or n:find("radar") or n:find("basket") then return false end
    return tool:GetAttribute("EggUid") or tool:GetAttribute("UID") or n:find("egg") or tool:GetAttribute("ItemType") == "Egg"
end

local function getAllEggsFromWorld()
    local eggs = {}
    local slots = Workspace:FindFirstChild("AreaEggSlotsClient")
    if slots then
        for _, model in ipairs(slots:GetChildren()) do
            local ok, pivot = pcall(function() return model:GetPivot() end)
            if ok and pivot and pivot.Position.X >= 530 and not tostring(model.Name):find("FirstArea") then
                local zone = model:GetAttribute("AreaId") or model:GetAttribute("Area") or "Unknown"
                local rarity = model:GetAttribute("Rarity") or model:GetAttribute("RarityTier") or "Common"
                local scale = tonumber(model:GetAttribute("Scale") or model:GetAttribute("AssetScale")) or 1
                table.insert(eggs, { name = model.Name, model = model, zone = tostring(zone), rarity = tostring(rarity), scale = scale, position = pivot.Position, cframe = pivot })
            end
        end
    end
    return eggs
end

local function detectZoneFromPosition(pos, name)
    local x = pos.X
    if x >= 5200 then return "Light Dark" end
    if x >= 4750 then return "Titan Temple" end
    if x >= 4000 then return "Cherry Blossom" end
    if x >= 3350 then return "Cosmic" end
    if x >= 2780 then return "Prehistoric" end
    if x >= 2250 then return "Abyss Ocean" end
    if x >= 1850 then return "Volcano" end
    if x >= 1450 then return "Snow" end
    if x >= 1150 then return "Jungle" end
    if x >= 920 then return "Desert" end
    if x >= 720 then return "Lake" end
    if string.lower(tostring(name or "")):find("lake") then return "Lake" end
    return "Forest"
end

local function findBestTarget()
    local _, _, hrp = getChar()
    if not hrp then return nil, 0 end
    local eggs = getAllEggsFromWorld()
    if #eggs == 0 then return nil, 0 end
    local best, bestScore = nil, -math.huge
    local matching = 0
    for _, egg in ipairs(eggs) do
        local realZone = detectZoneFromPosition(egg.position, egg.zone)
        local tier = RarityTier[egg.rarity] or 0
        local zw = ZoneWeight[realZone] or 50
        local score = tier >= 4 and (400000 + tier * 10000 + zw) or (zw * 11 + tier * 1000)
        score = math.floor(score * egg.scale)
        local zonePass = CONFIG.SelectedZones[realZone] == true
        local rarityPass = CONFIG.SelectedRarities[egg.rarity] == true
        if tier >= 4 and CONFIG.AlwaysSecretPlus then rarityPass = true end
        if zonePass and rarityPass then
            matching = matching + 1
            local dist = (egg.position - hrp.Position).Magnitude
            if score > bestScore then egg.score = score egg.distance = dist egg.realZone = realZone best = egg bestScore = score end
        end
    end
    return best, matching
end

