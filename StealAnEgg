    State.Status = "🔒 Lifting egg..."
    local deadline = os.clock() + 3.5
    while os.clock() < deadline and State.Running do
        if session and State.Session ~= session then return false end
        hrp.CFrame = egg.cframe * CFrame.new(0, 0.4, 0)
        local carryRemote = Remotes.FieldCarry
        if carryRemote and egg.name then
            pcall(function()
                if carryRemote:IsA("RemoteFunction") then
                    carryRemote:InvokeServer({ Uid = egg.name })
                else
                    carryRemote:FireServer({ Uid = egg.name })
                end
            end)
        end
        task.wait(0.15)
        local _, carriedUid = nil, nil
        local ch = LocalPlayer.Character
        if ch then
            for _, c in ipairs(ch:GetChildren()) do
                if isEgg(c) then return true end
            end
        end
    end

    -- Phase 2: Guard Strike
    State.Status = "⚔️ Guard Strike..."
    local strikeRemote = Remotes.ForestStrike
    if strikeRemote then
        pcall(function()
            if strikeRemote:IsA("RemoteFunction") then strikeRemote:InvokeServer()
            else strikeRemote:FireServer() end
        end)
    end
    task.wait(1.5)

    -- Phase 3: Re-grab
    State.Status = "🎯 Re-grabbing..."
    deadline = os.clock() + 3
    while os.clock() < deadline and State.Running do
        if session and State.Session ~= session then return false end
        hrp.CFrame = egg.cframe * CFrame.new(0, 0.4, 0)
        local carryRemote = Remotes.FieldCarry
        if carryRemote and egg.name then
            pcall(function()
                if carryRemote:IsA("RemoteFunction") then
                    carryRemote:InvokeServer({ Uid = egg.name })
                else
                    carryRemote:FireServer({ Uid = egg.name })
                end
            end)
        end
        task.wait(0.15)
        local ch = LocalPlayer.Character
        if ch then
            for _, c in ipairs(ch:GetChildren()) do
                if isEgg(c) then return true end
            end
        end
    end
    return false
end

