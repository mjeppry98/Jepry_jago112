local StealthMovement = {
    JitterMin = 0.3,
    JitterMax = 0.7,
    SpeedLimit = 60, -- Batas kecepatan agar tidak trigger speedhack
    MicroJitter = true,
}

local function humanJitter()
    local char = game:GetService("Players").LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function()
        local jx = (math.random() - 0.5) * 0.12
        local jz = (math.random() - 0.5) * 0.12
        hrp.CFrame = hrp.CFrame * CFrame.new(jx, 0, jz)
    end)
end

local function randomDelay(base, variance)
    variance = variance or 0.35
    local jitter = (math.random() * 2 - 1) * variance
    task.wait(math.max(0.05, base + jitter))
end

-- ═══════════════════════════════════════════════════════════════
-- LAYER 4: SAFE TELEPORT (Gradual, bukan snap)
-- ═══════════════════════════════════════════════════════════════

local function safeGlide(targetPos, speed, session)
    speed = speed or StealthMovement.SpeedLimit
    local char = game:GetService("Players").LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local startTime = os.clock()
    local lastJitter = 0

    while os.clock() - startTime < 20 do
        if session and State.Session ~= session then return false end
        local pos = hrp.Position
        local delta = targetPos - pos
        if delta.Magnitude <= 5 then break end

        local adaptiveSpeed = speed
        if delta.Magnitude > 200 then adaptiveSpeed = speed * 1.5
        elseif delta.Magnitude < 30 then adaptiveSpeed = speed * 0.6 end

        local step = delta.Unit * math.min(delta.Magnitude, adaptiveSpeed * game:GetService("RunService").Heartbeat:Wait())
        hrp.CFrame = CFrame.lookAt(pos + step, targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        if StealthMovement.MicroJitter and os.clock() - lastJitter > (StealthMovement.JitterMin + math.random() * (StealthMovement.JitterMax - StealthMovement.JitterMin)) then
            lastJitter = os.clock()
            humanJitter()
        end
    end
    hrp.CFrame = CFrame.new(targetPos)
    return true
end

