local function getAllEggsFromWorld()
    local eggs = {}
    local slots = Workspace:FindFirstChild("AreaEggSlotsClient")
    if slots then
        for _, model in ipairs(slots:GetChildren()) do
            local ok, pivot = pcall(function() return model:GetPivot() end)
            if ok and pivot and pivot.Position.X >= 530 and not tostring(model.Name):find("FirstArea") then
                local zone = model:GetAttribute("AreaId") or model:GetAttribute("Area") or "Unknown"
                local rarity = model:GetAttribute("Rarity") or model:GetAttribute("RarityTier") or "Common"
                local scale = tonumber(model:GetAttribute("Scale") or model:GetAttribute("AssetScale")) or 1
                table.insert(eggs, {
                    name = model.Name,
                    model = model,
                    zone = tostring(zone),
                    rarity = tostring(rarity),
                    scale = scale,
                    position = pivot.Position,
                    cframe = pivot,
                })
            end
        end
    end
    return eggs
end

local function detectZoneFromPosition(pos, name)
    local x = pos.X
    local lname = string.lower(tostring(name or ""))
    if x >= 5200 then return "Light Dark" end
    if x >= 4750 then return "Titan Temple" end
    if x >= 4000 then return "Cherry Blossom" end
    if x >= 3350 then return "Cosmic" end
    if x >= 2780 then return "Prehistoric" end
    if x >= 2250 then return "Abyss Ocean" end
    if x >= 1850 then return "Volcano" end
    if x >= 1450 then return "Snow" end
    if x >= 1150 then return "Jungle" end
    if x >= 920 then return "Desert" end
    if x >= 720 then return "Lake" end
    if lname:find("lake") then return "Lake" end
    return "Forest"
end

local function findBestTarget()
    local char, hum, hrp = getChar()
    if not hrp then return nil end

    local eggs = getAllEggsFromWorld()
    if #eggs == 0 then return nil end

    local best, bestScore = nil, -math.huge
    local matchingCount = 0

    for _, egg in ipairs(eggs) do
        local realZone = detectZoneFromPosition(egg.position, egg.zone)
        local tier = RarityTier[egg.rarity] or 0
        local zw = ZoneWeight[realZone] or 50

        -- Priority score
        local score
        if tier >= 4 then
            score = 400000 + tier * 10000 + zw
        else
            score = zw * 11 + tier * 1000
        end
        score = math.floor(score * egg.scale)

        local zonePass = CONFIG.SelectedZones[realZone] == true
        local rarityPass = CONFIG.SelectedRarities[egg.rarity] == true
        if tier >= 4 and CONFIG.AlwaysSecretPlus then rarityPass = true end

        if zonePass and rarityPass then
            matchingCount = matchingCount + 1
            local dist = (egg.position - hrp.Position).Magnitude
            if score > bestScore or (score == bestScore and dist < (best and (best.position - hrp.Position).Magnitude or math.huge)) then
                egg.score = score
                egg.distance = dist
                egg.realZone = realZone
                best = egg
                bestScore = score
            end
        end
    end

    return best, matchingCount
end

-- ═══════════ TELEPORT / GLIDE ═══════════
local function glideTo(targetPos, speed, session)
    local char, hum, hrp = getChar()
    if not hrp or not hum then return false end
    speed = speed or 350
    local startTime = os.clock()
    while State.Running and os.clock() - startTime < 15 do
        if session and State.Session ~= session then return false end
        local pos = hrp.Position
        local delta = targetPos - pos
        if delta.Magnitude <= 6 then break end
        local step = delta.Unit * math.min(delta.Magnitude, speed * RunService.Heartbeat:Wait())
        hrp.CFrame = CFrame.lookAt(pos + step, targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    hrp.CFrame = CFrame.new(targetPos)
    return true
end

local function returnToBase(session)
    local char, hum, hrp = getChar()
    if not hrp then return false end
    local target = Vector3.new(SAFE_LINE_X, 70, CORRIDOR_Z)
    local ok, _ = pcall(glideTo, target, 400, session)
    if hrp then
        hrp.CFrame = CFrame.new(SAFE_LINE_X, math.max(68, hrp.Position.Y), CORRIDOR_Z)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    return ok
end

