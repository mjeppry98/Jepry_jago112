local function surface(cg, radius)
    radius = radius or 14
    cg.BackgroundTransparency = 1
    corner(cg, UDim.new(0, radius))
    local bg = new("Frame", { BackgroundColor3 = rgb(30, 30, 34), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, cg)
    corner(bg, UDim.new(0, radius))
    new("UIGradient", { Color = ColorSequence.new(U.WHITE, rgb(92, 92, 96)), Rotation = 90 }, bg)
    local rim = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, cg)
    corner(rim, UDim.new(0, radius))
    local st = new("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = U.WHITE, Thickness = 2 }, rim)
    local rimGrad = new("UIGradient", { Color = ColorSequence.new(rgb(190, 190, 196), rgb(28, 28, 32)), Rotation = 90 }, st)
    return rimGrad
end

local function popIn(scale, group)
    scale.Scale = 0.001
    if group then group.GroupTransparency = 1; tween(group, 0.14, { GroupTransparency = 0 }) end
    tween(scale, 0.25, { Scale = 1.1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    task.delay(0.25, function()
        if scale.Parent then tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut) end
    end)
end

