function loadItems(query, append)
    if append and U.isLoading then return end
    U.reqId += 1
    local my = U.reqId
    U.isLoading = true
    local cat = CATEGORIES[currentCategoryIndex]
    setStatus(("Loading %s..."):format(cat.label:lower()))
    if not append then
        clearList(); removeLoadMore()
    end

    task.spawn(function()
        local params
        if cat.source == "catalog" then
            params = { action = "catalog", keyword = query or "", salesTypeFilter = 1, limit = 120 }
            local tax = CATALOG_TAXONOMY[currentSubCategory or "All"]
            if tax then params.taxonomy = tax end
        else
            params = { action = "search", searchCategoryType = cat.type, query = query or "", maxPageSize = 30, searchView = "Core" }
        end
        if append and U.nextToken then params.pageToken = U.nextToken end

        local data, err = apiGet(params)
        if my ~= U.reqId then return end
        U.isLoading = false
        if err then
            setStatus("Failed: " .. tostring(err))
            showNotice("Failed to load: " .. tostring(err))
            if append then showLoadMore() end
            return
        end
        showNotice(nil)
        U.nextToken = data.next
        if type(U.nextToken) ~= "string" or U.nextToken == "" then U.nextToken = nil end
        local items = data.items or {}
        displayItems(items, append)
        if #items == 0 and not append then showNotice("No results found.") end
        setStatus(("Found %d %s%s"):format(#items, cat.label:lower(), U.nextToken and " (more available)" or ""))
    end)
end

