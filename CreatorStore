local function applyWhiteIcon(label, id, token)
    label.ImageColor3 = U.WHITE
    label.Image = id
    local cached = U.invCache[id]
    if cached == nil then
        local ok, editable = pcall(function()
            local e = AssetService:CreateEditableImageAsync(Content.fromUri(id))
            local size = e.Size
            local buf = e:ReadPixelsBuffer(Vector2.new(0, 0), size)
            for i = 0, buffer.len(buf) - 4, 4 do
                buffer.writeu8(buf, i, 255 - buffer.readu8(buf, i))
                buffer.writeu8(buf, i + 1, 255 - buffer.readu8(buf, i + 1))
                buffer.writeu8(buf, i + 2, 255 - buffer.readu8(buf, i + 2))
            end
            e:WritePixelsBuffer(Vector2.new(0, 0), size, buf)
            return e
        end)
        cached = (ok and editable) or false
        U.invCache[id] = cached
    end
    if U.voteToken ~= token then return end
    if cached then
        local okSet = pcall(function() label.ImageContent = Content.fromObject(cached) end)
        if not okSet then label.Image = U.iconFallback[id] or id end
    else
        label.Image = U.iconFallback[id] or id
    end
end

