local function selectSubCategory(subName)
    currentSubCategory = subName
    currentQuery = (subName == "All") and "" or subName
    
    subCatContainer.Visible = false
    leftPanel.Visible = true
    
    nextPageToken = nil
    loadModels(currentQuery, false)
end

local function showSubCategories(catIndex)
    currentCategoryIndex = catIndex
    currentSubCategory = nil
    
    -- Hide panels
    leftPanel.Visible = false
    rightPanel.Visible = false
    subCatContainer.Visible = true
    subCatScroll.CanvasPosition = Vector2.new(0, 0)
    
    -- Populate Grid
    for _, child in ipairs(subCatScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    local cat = CATEGORIES[catIndex]
    
    -- SAFEGUARD: Ensure subs exists to prevent UI crash
    local subs = cat.subs
    if not subs or #subs == 0 then
        subs = {"All"}
    end

    for i, subName in ipairs(subs) do
        local btn = raised(subCatScroll, UDim2.new(1, 0, 1, 0), UDim2.new(), TONE_OFF, 3)
        btn.Label.Text = subName
        btn.Label.TextSize = 14
        
        -- Give sub-categories some color variations
        if i % 3 == 0 then btn.SetTone(rgb(120, 50, 100), WHITE) -- Pinkish
        elseif i % 3 == 1 then btn.SetTone(rgb(50, 100, 150), WHITE) -- Bluish
        else btn.SetTone(rgb(40, 120, 80), WHITE) end -- Greenish
        
        btn.Face.Activated:Connect(function()
            selectSubCategory(subName)
        end)
    end
end

local function setActiveCategory(idx)
    if currentCategoryIndex == idx and subCatContainer.Visible == false then return end
    currentCategoryIndex = idx

    for i, btnData in ipairs(categoryButtons) do
        local isActive = (i == idx)
        btnData.api.SetTone(isActive and TONE_ON or TONE_OFF, isActive and TEXT_DARK or TEXT_LIGHT)
    end

    if detailOpen then setDetailOpen(false) end
    showSubCategories(idx)
end

for i, btnData in ipairs(categoryButtons) do
    btnData.api.Face.Activated:Connect(function() setActiveCategory(i) end)
end

