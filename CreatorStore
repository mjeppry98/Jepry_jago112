playBtn.Face.Activated:Connect(function()
    if not selectedModel then return end
    if currentSound then 
        stopAudio() 
        return 
    end
    
    local snd = Instance.new("Sound")
    snd.SoundId = "rbxassetid://" .. tostring(selectedModel.id)
    snd.Volume = 1
    snd.Parent = SoundService
    
    if pcall(function() snd:Play() end) then
        currentSound = snd
        playLabel.Text = "STOP"
        playBtn.SetTone(TONE_SUCCESS, WHITE)
        
        snd.Ended:Connect(function()
            stopAudio()
        end)
        
        task.delay(60, function() 
            if currentSound == snd then 
                stopAudio() 
            end 
        end)
    else
        snd:Destroy()
    end
end)

local function showCloseConfirm()
    if gui:FindFirstChild("CloseConfirm") then return end
    local backdrop = new("TextButton", { Name="CloseConfirm", Text="", BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=1, Size=UDim2.fromScale(1,1), ZIndex=200 }, gui)
    tween(backdrop, 0.2, { BackgroundTransparency = 0.5 })
    local card = new("CanvasGroup", { AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), Size=UDim2.fromOffset(math.min(320, FRAME_W-40), 180), BackgroundTransparency=1, Active=true, ZIndex=201 }, backdrop)
    surface(card, 14)
    local cardScale = new("UIScale", { Scale = 0.001 }, card)
    txt(card, "CLOSE ASSET STORE", 13, WHITE, GOTHAM_K, UDim2.new(1,-32,0,22), UDim2.fromOffset(16,14), CENTER)
    txt(card, "Are you sure you want to close this UI?", 11, TEXT_DIM, GOTHAM, UDim2.new(1,-32,0,40), UDim2.fromOffset(16,44), CENTER, {TextWrapped=true, TextYAlignment=Enum.TextYAlignment.Top, TextTruncate=Enum.TextTruncate.None})
    local yesBtn = raised(card, UDim2.new(0.5,-12,0,36), UDim2.new(0,16,1,-54), TONE_DANGER, 3)
    yesBtn.Label.Text = "YES, CLOSE"; yesBtn.Label.TextColor3 = TEXT_LIGHT
    local noBtn = raised(card, UDim2.new(0.5,-12,0,36), UDim2.new(0.5,4,1,-54), TONE_OFF, 3)
    noBtn.Label.Text = "NO, KEEP IT"; noBtn.Label.TextColor3 = TEXT_LIGHT
    popIn(cardScale, card)
    local dismissed = false
    local function dismiss(cb)
        if dismissed then return end
        dismissed = true
        tween(cardScale, 0.15, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        tween(card, 0.2, { GroupTransparency = 1 })
        tween(backdrop, 0.2, { BackgroundTransparency = 1 })
        task.delay(0.22, function() backdrop:Destroy(); if cb then cb() end end)
    end
    noBtn.Face.Activated:Connect(function() dismiss() end)
    backdrop.Activated:Connect(function() dismiss() end)
    yesBtn.Face.Activated:Connect(function()
        dismiss(function()
            stopAudio()
            local t1 = tween(body, 0.25, { GroupTransparency = 1, Size = UDim2.fromOffset(FRAME_W*0.85, FRAME_H*0.85) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tween(shadow, 0.25, { BackgroundTransparency = 1 })
            t1.Completed:Connect(function() gui:Destroy() end)
        end)
    end)
end

closeBtn.MouseButton1Click:Connect(showCloseConfirm)
