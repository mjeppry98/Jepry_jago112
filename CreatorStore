local loadMoreState = { visible = false, shrunk = false, lastY = 0 }
local LOAD_MORE_FADE = 0.28

local function setScrollShrunk(shrunk)
    if loadMoreState.shrunk == shrunk then return end
    loadMoreState.shrunk = shrunk
    local targetSize = UDim2.new(1, -INNER*2, 0, shrunk and SHRUNK_SCROLL_H or FULL_SCROLL_H)
    tween(scrollList, LOAD_MORE_FADE, { Size = targetSize }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
end

local function setLoadMoreVisible(visible)
    if loadMoreState.visible == visible then return end
    loadMoreState.visible = visible
    if visible then
        loadMoreBtn.Holder.Visible = true
        tween(loadMoreBtn.Face, LOAD_MORE_FADE, { BackgroundTransparency = 0 })
        tween(loadMoreBtn.Base, LOAD_MORE_FADE, { BackgroundTransparency = 0 })
        tween(loadMoreBtn.Stroke, LOAD_MORE_FADE, { Transparency = 0 })
        tween(loadMoreBtn.Label, LOAD_MORE_FADE, { TextTransparency = 0 })
        loadMoreBtn.Scale.Scale = 0.8
        tween(loadMoreBtn.Scale, 0.3, {Scale = 1}, Enum.EasingStyle.Back)
    else
        tween(loadMoreBtn.Face, LOAD_MORE_FADE, { BackgroundTransparency = 1 })
        tween(loadMoreBtn.Base, LOAD_MORE_FADE, { BackgroundTransparency = 1 })
        tween(loadMoreBtn.Stroke, LOAD_MORE_FADE, { Transparency = 1 })
        tween(loadMoreBtn.Label, LOAD_MORE_FADE, { TextTransparency = 1 })
        tween(loadMoreBtn.Scale, 0.2, {Scale = 0.8})
        task.delay(LOAD_MORE_FADE + 0.02, function()
            if not loadMoreState.visible then loadMoreBtn.Holder.Visible = false end
        end)
    end
end

local scrollDebounce = false
scrollList:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
    if scrollDebounce then return end
    scrollDebounce = true
    task.defer(function()
        scrollDebounce = false
        
        if isLoading or not nextPageToken then
            if loadMoreState.visible then setLoadMoreVisible(false) end
            if loadMoreState.shrunk then setScrollShrunk(false) end
            return
        end

        local y = scrollList.CanvasPosition.Y
        local cH = scrollList.AbsoluteCanvasSize.Y
        local wH = scrollList.AbsoluteWindowSize.Y
        
        local isAtBottom = (y + wH) >= (cH - 15)
        
        if isAtBottom and not loadMoreState.shrunk then
            loadMoreState.lastY = y
            setScrollShrunk(true)
            setLoadMoreVisible(true)
        elseif not isAtBottom and loadMoreState.shrunk then
            if y < loadMoreState.lastY - 20 then
                setScrollShrunk(false)
                setLoadMoreVisible(false)
            end
        end
    end)
end)

