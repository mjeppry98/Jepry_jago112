local function instanceSummary(t)
    if type(t) ~= "table" then return nil end
    local parts = {}
    for k, v in pairs(t) do
        if type(v) == "number" then
            table.insert(parts, tostring(k) .. ": " .. fmtNum(v))
        elseif type(v) == "table" then
            local name = v.className or v.name or v.type or tostring(k)
            local cnt = v.count or v.total
            if type(cnt) == "number" then table.insert(parts, tostring(name) .. ": " .. fmtNum(cnt)) end
        end
    end
    table.sort(parts)
    if #parts == 0 then return nil end
    return table.concat(parts, ", ")
end

