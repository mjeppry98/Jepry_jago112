    txt(card, "CLOSE ASSET STORE", 13, U.WHITE, U.GOTHAM_K, UDim2.new(1, -32, 0, 22), UDim2.fromOffset(16, 14), U.CENTER)
    txt(card, "Are you sure you want to close this UI?", 11, U.TEXT_DIM, U.GOTHAM, UDim2.new(1, -32, 0, 40), UDim2.fromOffset(16, 44), U.CENTER, { TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.None })
    local yesBtn = raised(card, UDim2.new(0.5, -22, 0, 36), UDim2.new(0, 16, 1, -54), U.TONE_DANGER, 3)
    yesBtn.Label.Text = "YES, CLOSE"
    local noBtn = raised(card, UDim2.new(0.5, -22, 0, 36), UDim2.new(0.5, 6, 1, -54), U.TONE_OFF, 3)
    noBtn.Label.Text = "NO, KEEP IT"
    popIn(cardScale, card)
    local dismissed = false
    local function dismiss(cb)
        if dismissed then return end
        dismissed = true
        tween(cardScale, 0.15, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        tween(card, 0.2, { GroupTransparency = 1 })
        tween(backdrop, 0.2, { BackgroundTransparency = 1 })
        task.delay(0.22, function() backdrop:Destroy(); if cb then cb() end end)
    end
    noBtn.Face.Activated:Connect(function() dismiss() end)
    backdrop.Activated:Connect(function() dismiss() end)
    yesBtn.Face.Activated:Connect(function()
        dismiss(function()
            local t1 = tween(body, 0.25, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tween(U.bodyScale, 0.25, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            t1.Completed:Connect(destroyAll)
        end)
    end)
end
U.closeBtn.Activated:Connect(showCloseConfirm)

local function runIntro()
    local overlay = new("Frame", { Name = "Intro", BackgroundColor3 = U.BLACK, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 300, Active = true }, U.gui)
    tween(overlay, 0.3, { BackgroundTransparency = 0.45 })

    local cardH = 112
    local cardW = math.clamp(U.FRAME_W - 20, 330, 410)
    local card = new("CanvasGroup", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(cardH, cardH), BackgroundTransparency = 1, GroupTransparency = 1, ZIndex = 301
    }, overlay)
    surface(card, 20)
    local cardScale = new("UIScale", { Scale = 0.001 }, card)

    local logo = new("ImageLabel", {
        BackgroundTransparency = 1, Image = ICON.LOGO, ImageColor3 = U.WHITE, Size = UDim2.fromOffset(72, 72),
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 20, 0.5, -6)
    }, card)
    local logoScale = new("UIScale", { Scale = 1 }, logo)

    local avatar = new("ImageLabel", {
        BackgroundColor3 = rgb(16, 16, 18), BorderSizePixel = 0, Image = ICON.CREATOR, ImageTransparency = 1,
        Size = UDim2.fromOffset(64, 64), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 114, 0.5, -6)
    }, card)
    corner(avatar, UDim.new(1, 0))
    local avatarStroke = new("UIStroke", { Color = U.WHITE, Thickness = 2, Transparency = 1 }, avatar)
    new("UIGradient", { Color = ColorSequence.new(U.ACCENT_A, U.ACCENT_B), Rotation = 45 }, avatarStroke)
    local madeBy = txt(card, "MADE BY", 9, U.TEXT_DIM, U.GOTHAM_B, UDim2.new(1, -196, 0, 12), UDim2.new(0, 190, 0.5, -26), U.LEFT, { TextTransparency = 1 })
    local nameLabel = txt(card, CREATOR_NAME, 14, U.WHITE, U.GOTHAM_K, UDim2.new(1, -196, 0, 20), UDim2.new(0, 190, 0.5, -12), U.LEFT, { TextTransparency = 1 })

    local barTrack = new("Frame", { BackgroundColor3 = rgb(16, 16, 18), BorderSizePixel = 0, Size = UDim2.new(1, -40, 0, 5), Position = UDim2.new(0, 20, 1, -16) }, card)
    corner(barTrack, UDim.new(1, 0))
    local barFill = new("Frame", { BackgroundColor3 = U.WHITE, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, barTrack)
    corner(barFill, UDim.new(1, 0))
    new("UIGradient", { Color = ColorSequence.new(U.ACCENT_A, U.ACCENT_B) }, barFill)

    task.spawn(function()
        local uid
        pcall(function() uid = Players:GetUserIdFromNameAsync(CREATOR_NAME) end)
        if not uid then
            local d = apiGet({ action = "user", username = CREATOR_NAME })
            if d and d.id then uid = d.id end
        end
        if uid and avatar.Parent then
            safeSetImage(avatar, "rbxthumb://type=AvatarHeadShot&id=" .. tostring(uid) .. "&w=150&h=150")
        end
    end)

    popIn(cardScale, card)
    tween(barFill, 2.6, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Linear)
    task.wait(0.4)
    tween(logoScale, 0.25, { Scale = 1.15 }, Enum.EasingStyle.Back)
    task.wait(0.25)
    tween(logoScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Sine)
    task.wait(0.2)

    tween(card, 0.75, { Size = UDim2.fromOffset(cardW, cardH) }, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
    task.wait(0.35)
    tween(avatar, 0.5, { ImageTransparency = 0 })
    tween(avatarStroke, 0.5, { Transparency = 0 })
    tween(madeBy, 0.5, { TextTransparency = 0 })
    tween(nameLabel, 0.5, { TextTransparency = 0 })
    task.wait(1.65)

    tween(cardScale, 0.3, { Scale = 0.001 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    tween(card, 0.3, { GroupTransparency = 1 })
    tween(overlay, 0.35, { BackgroundTransparency = 1 })
    task.wait(0.35)
    overlay:Destroy()
end

if BASE_URL:find("YOUR%-APP") then
    setStatus("Replace BASE_URL at the top of the script with your Vercel URL!")
end
showSubCategories(1)
runIntro()
if U.gui.Parent then
    body.Visible = true
    popIn(U.bodyScale, body)
end
