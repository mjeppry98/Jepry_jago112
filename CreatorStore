local function bindPress(btn, scale, getTone, downExtra, upExtra, restExtra)
    local hover, down, token = false, false, 0
    local function rest()
        local c = getTone()
        tween(btn, 0.18, { BackgroundColor3 = hover and c:Lerp(U.WHITE, 0.12) or c })
        if restExtra then restExtra() end
    end
    btn.InputBegan:Connect(function(i)
        if not isPress(i) then return end
        down = true
        token += 1
        local c = getTone()
        tween(scale, 0.09, { Scale = 0.82 }, Enum.EasingStyle.Quad)
        tween(btn, 0.09, { BackgroundColor3 = c:Lerp(U.BLACK, 0.55) })
        if downExtra then downExtra() end
        playClick()
    end)
    local function release()
        if not down then return end
        down = false
        token += 1
        local my = token
        rest()
        if upExtra then upExtra() end
        tween(scale, 0.16, { Scale = 1.14 }, Enum.EasingStyle.Back)
        task.delay(0.16, function()
            if token == my and scale.Parent then
                tween(scale, 0.2, { Scale = hover and 1.05 or 1 }, Enum.EasingStyle.Back)
            end
        end)
    end
    btn.InputEnded:Connect(function(i) if isPress(i) then release() end end)
    btn.MouseEnter:Connect(function()
        hover = true
        if not down then
            tween(scale, 0.18, { Scale = 1.05 }, Enum.EasingStyle.Back)
            rest()
        end
    end)
    btn.MouseLeave:Connect(function()
        hover = false
        down = false
        token += 1
        tween(scale, 0.15, { Scale = 1 })
        rest()
    end)
end

local function raised(parent, size, position, tone, depth, radius, gradientSeq)
    depth = depth or 3
    radius = radius or UDim.new(0, 8)
    local holder = new("Frame", { BackgroundTransparency = 1, Size = size, Position = position }, parent)
    local base = new("Frame", { BackgroundColor3 = rgb(4, 4, 5), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, holder)
    corner(base, radius)
    local restPos = UDim2.new(0.5, 0, 0.5, -depth / 2)
    local downPos = UDim2.new(0.5, 0, 0.5, depth / 2 - 1)
    local face = new("TextButton", {
        AutoButtonColor = false, Text = "", BackgroundColor3 = tone, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5), Position = restPos, Size = UDim2.new(1, 0, 1, -depth)
    }, holder)
    corner(face, radius)
    local grad = new("UIGradient", { Color = gradientSeq or U.SHADE, Rotation = 90 }, face)
    local stroke = new("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = U.WHITE, Thickness = 1 }, face)
    new("UIGradient", { Color = U.BEVEL, Rotation = 90 }, stroke)
    local label = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = U.GOTHAM_B, TextSize = 11, Text = "",
        TextColor3 = U.TEXT_LIGHT, TextXAlignment = U.CENTER, TextYAlignment = Enum.TextYAlignment.Center
    }, face)
    local scale = new("UIScale", { Scale = 1 }, face)
    local api = { Holder = holder, Base = base, Face = face, Stroke = stroke, Label = label, Tone = tone, Scale = scale, Grad = grad }
    bindPress(face, scale, function() return api.Tone end,
        function()
            tween(face, 0.09, { Position = downPos })
            tween(grad, 0.09, { Rotation = 270 })
        end,
        nil,
        function()
            tween(face, 0.18, { Position = restPos })
            tween(grad, 0.18, { Rotation = 90 })
        end)
    api.SetTone = function(c, tc)
        api.Tone = c
        tween(face, 0.2, { BackgroundColor3 = c })
        if tc then tween(label, 0.2, { TextColor3 = tc }) end
    end
    return api
end

