local function showSubCategories(catIndex)
    U.reqId += 1
    U.isLoading = false
    showNotice(nil)
    currentCategoryIndex = catIndex
    currentSubCategory = nil
    stopAudio()
    if U.detailOpen then
        U.detailOpen = false
        if U.is3D then set3D(false) end
        U.rightPanel.Visible = false
        U.rightPanel.Position = U.RIGHT_HIDDEN
        U.leftPanel.Size = U.LEFT_CLOSED
    end
    U.leftPanel.Visible = false
    U.subCatContainer.Visible = true
    U.subCatScroll.CanvasPosition = Vector2.new()

    for _, child in ipairs(U.subCatScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local cat = CATEGORIES[catIndex]
    local subs = cat.subs or { "All" }
    local count = #subs

    local function getLayout(i)
        local gap, h1 = 8, 160
        if count == 1 then return UDim2.new(1, 0, 0, h1 * 2), UDim2.new() end
        if count == 2 then
            if i == 1 then return UDim2.new(0.5, -gap / 2, 0, h1 * 2), UDim2.new() end
            return UDim2.new(0.5, -gap / 2, 0, h1 * 2), UDim2.new(0.5, gap / 2, 0, 0)
        end
        if count == 3 then
            if i == 1 then return UDim2.new(0.5, -gap / 2, 0, h1 * 2), UDim2.new() end
            if i == 2 then return UDim2.new(0.5, -gap / 2, 0, h1), UDim2.new(0.5, gap / 2, 0, 0) end
            return UDim2.new(0.5, -gap / 2, 0, h1), UDim2.new(0.5, gap / 2, 0, h1 + gap)
        end
        if i == 1 then return UDim2.new(0.4, -gap * 2 / 3, 0, h1 * 2 + gap), UDim2.new()
        elseif i == 2 then return UDim2.new(0.3, -gap * 2 / 3, 0, h1), UDim2.new(0.4, gap / 3, 0, 0)
        elseif i == 3 then return UDim2.new(0.3, -gap * 2 / 3, 0, h1), UDim2.new(0.4, gap / 3, 0, h1 + gap)
        elseif i == 4 then return UDim2.new(0.3, 0, 0, h1 * 2 + gap), UDim2.new(0.7, gap, 0, 0)
        elseif i == 5 then return UDim2.new(0.5, -gap / 2, 0, h1), UDim2.new(0, 0, 0, h1 * 2 + gap * 2)
        elseif i == 6 then return UDim2.new(0.5, -gap / 2, 0, h1), UDim2.new(0.5, gap / 2, 0, h1 * 2 + gap * 2)
        end
        local row, col = math.floor((i - 7) / 2), (i - 7) % 2
        return UDim2.new(0.5, -gap / 2, 0, h1), UDim2.new(col * 0.5, (col == 0 and 0 or gap / 2), 0, h1 * 3 + gap * 3 + row * (h1 + gap))
    end

    local SUBCOLORS = {
        rgb(45, 175, 255), rgb(220, 60, 255), rgb(255, 110, 70), rgb(45, 230, 90),
        rgb(255, 60, 140), rgb(255, 170, 50), rgb(150, 70, 255), rgb(60, 200, 200)
    }
    local maxHeight = 0

    for i, subName in ipairs(subs) do
        local size, pos = getLayout(i)
        local baseColor = SUBCOLORS[(i - 1) % #SUBCOLORS + 1]
        local gradColor = ColorSequence.new(baseColor:Lerp(U.WHITE, 0.35), baseColor:Lerp(U.BLACK, 0.25))
        local btn = raised(U.subCatScroll, size, pos + UDim2.new(0, 0, 0, 20), baseColor, 4, UDim.new(0, 12), gradColor)
        btn.Holder.ZIndex = 10
        btn.Label.Text = string.upper(subName)
        btn.Label.TextColor3 = U.WHITE
        btn.Label.Font = U.GOTHAM_K
        btn.Label.TextScaled = true
        new("UITextSizeConstraint", { MaxTextSize = 20, MinTextSize = 10 }, btn.Label)
        new("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12) }, btn.Face)

        local iconId = SUB_ICONS[subName]
        if iconId then
            local icn = new("ImageLabel", {
                BackgroundTransparency = 1, Image = iconId, ImageColor3 = U.WHITE, Size = UDim2.fromOffset(44, 44),
                Position = UDim2.fromOffset(12, 12), ZIndex = 15, ImageTransparency = 1
            }, btn.Face)
            task.delay(i * 0.06 + 0.1, function() if icn.Parent then tween(icn, 0.4, { ImageTransparency = 0 }) end end)
        end

        btn.Scale.Scale = 0.8
        btn.Face.BackgroundTransparency = 1; btn.Base.BackgroundTransparency = 1
        btn.Stroke.Transparency = 1; btn.Label.TextTransparency = 1
        task.delay(i * 0.06, function()
            if btn.Holder.Parent then
                tween(btn.Holder, 0.4, { Position = pos }, Enum.EasingStyle.Back)
                tween(btn.Face, 0.4, { BackgroundTransparency = 0 })
                tween(btn.Base, 0.4, { BackgroundTransparency = 0 })
                tween(btn.Stroke, 0.4, { Transparency = 0 })
                tween(btn.Label, 0.4, { TextTransparency = 0 })
                tween(btn.Scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
            end
        end)
        btn.Face.Activated:Connect(function() selectSubCategory(subName) end)
        maxHeight = math.max(maxHeight, pos.Y.Offset + size.Y.Offset)
    end
    U.subCatScroll.CanvasSize = UDim2.new(0, 0, 0, maxHeight + 20)
    setStatus("Choose a sub-category.")
end

