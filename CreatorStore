function loadModels(query, append)
    if isLoading then return end
    isLoading = true
    local cat = CATEGORIES[currentCategoryIndex]
    setStatus(("Loading %s..."):format(cat.label:lower()))
    loadMoreBtn.Label.Text = append and "LOADING..." or "LOAD MORE"

    task.spawn(function()
        local url = "https://apis.roblox.com/toolbox-service/v2/assets:search"
        local bodyReq = {
            searchCategoryType = cat.key,
            query = query or "",
            maxPageSize = 30
        }
        if append and nextPageToken then bodyReq.pageToken = nextPageToken end

        local data, err, raw = httpPost(url, API_KEYS[currentKeyMode].store, bodyReq)
        if err then
            isLoading = false
            setStatus("Failed: " .. tostring(err))
            loadMoreBtn.Label.Text = "LOAD MORE"
            return
        end

        debugBox.Text = raw or "Empty"
        local results, newToken = parseModelsFromResponse(data, cat.key)
        nextPageToken = newToken
        lastQuery = query
        displayModels(results, append)
        isLoading = false
        setStatus(("Found %d %s"):format(#results, cat.label:lower()))
        loadMoreBtn.Label.Text = "LOAD MORE"

        loadMoreState.lastY = scrollList.CanvasPosition.Y
        task.defer(function()
            if not nextPageToken then
                setLoadMoreVisible(false)
                if loadMoreState.shrunk then setScrollShrunk(false) end
            end
        end)
    end)
end

