local function updateViewportTransform()
    if not vpModel then return end
    local rot = CFrame.fromEulerAnglesYXZ(math.rad(currentRotX), math.rad(currentRotY), 0)
    local dist = 15
    local targetPos = Vector3.new(0, 0, 0)
    
    if vpModel:IsA("Model") then
        local cf, size = vpModel:GetBoundingBox()
        targetPos = cf.Position
        dist = math.max(size.X, size.Y, size.Z) * 3.5
    else
        local size = vpModel.Size
        dist = math.max(size.X, size.Y, size.Z) * 3.5
    end

    local camPos = targetPos + rot:VectorToWorldSpace(Vector3.new(0, 0, dist))
    vpCamera.CFrame = CFrame.new(camPos, targetPos)
end

local function loadMeshToViewport(id)
    for _, child in ipairs(viewportFrame:GetChildren()) do
        if child:IsA("BasePart") or child:IsA("Model") then
            child:Destroy()
        end
    end
    
    vpModel = nil
    local loaded = false

    if not loaded then
        local success = pcall(function()
            local mesh = AssetService:CreateMeshPartAsync("rbxassetid://"..tostring(id))
            mesh.Anchored = true
            mesh.Parent = viewportFrame
            vpModel = mesh
            loaded = true
        end)
    end

    if not loaded then
        pcall(function()
            local model = InsertService:LoadAsset(tonumber(id))
            if model then
                model.Parent = viewportFrame
                vpModel = model
                for _, p in ipairs(model:GetDescendants()) do
                    if p:IsA("BasePart") then p.Anchored = true end
                end
                loaded = true
            end
        end)
    end

    if not loaded then
        pcall(function()
            local objs = game:GetObjects("rbxassetid://"..tostring(id))
            if objs and #objs > 0 then
                local obj = objs[1]
                obj.Parent = viewportFrame
                vpModel = obj
                if obj:IsA("Model") then
                    for _, p in ipairs(obj:GetDescendants()) do
                        if p:IsA("BasePart") then p.Anchored = true end
                    end
                elseif obj:IsA("BasePart") then
                    obj.Anchored = true
                end
                loaded = true
            end
        end)
    end

    if not vpModel then
        local block = Instance.new("Part")
        block.Shape = Enum.PartType.Block
        block.Size = Vector3.new(4, 4, 4)
        block.Anchored = true
        block.Material = Enum.Material.SmoothPlastic
        block.Color = Color3.fromRGB(100, 100, 100)
        block.Parent = viewportFrame
        vpModel = block
        
        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 150, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = block
        
        local warningTxt = Instance.new("TextLabel")
        warningTxt.Size = UDim2.new(1, 0, 1, 0)
        warningTxt.BackgroundTransparency = 1
        warningTxt.Text = "Mesh Blocked by Roblox\n(Client Security Limit)"
        warningTxt.TextColor3 = Color3.fromRGB(255, 100, 100)
        warningTxt.TextStrokeTransparency = 0
        warningTxt.TextScaled = true
        warningTxt.Font = Enum.Font.GothamBold
        warningTxt.Parent = billboard
    end

    currentRotX = 20
    currentRotY = -30
    updateViewportTransform()
end

local draggingThumb = false
viewportFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingThumb = true
        lastMousePos = input.Position
    end
end)
viewportFrame.InputChanged:Connect(function(input)
    if draggingThumb and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - lastMousePos
        currentRotY = currentRotY + (delta.X * 0.5)
        currentRotX = currentRotX - (delta.Y * 0.5)
        updateViewportTransform()
        lastMousePos = input.Position
    end
end)
viewportFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingThumb = false
    end
end)

