    corner(b, UDim.new(0, 6))
    new("UIGradient", { Color = U.SHADE, Rotation = 90 }, b)
    local icon
    if iconId then
        icon = new("ImageLabel", {
            BackgroundTransparency = 1, Image = iconId, ImageColor3 = U.WHITE, Size = UDim2.fromOffset(14, 14),
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5)
