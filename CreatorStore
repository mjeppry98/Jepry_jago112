-- Drag handler for zoom
local zoomDrag = false
local zoomLastPos = Vector2.new()
zoomViewport.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        zoomDrag = true; zoomLastPos = i.Position
    end
end)
zoomViewport.InputChanged:Connect(function(i)
    if zoomDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - zoomLastPos
        currentRotY = currentRotY + (d.X * 0.6)
        currentRotX = currentRotX - (d.Y * 0.6)
        
        local zoomClone = zoomViewport:FindFirstChildOfClass("MeshPart") or zoomViewport:FindFirstChildOfClass("Part") or zoomViewport:FindFirstChildWhichIsA("Model")
        if zoomClone then
            local rot = CFrame.fromEulerAnglesYXZ(math.rad(currentRotX), math.rad(currentRotY), 0)
            local targetPos = Vector3.new(0,0,0)
            local dist = 15
            if zoomClone:IsA("Model") then
                local cf, size = zoomClone:GetBoundingBox()
                targetPos = cf.Position
                dist = math.max(size.X, size.Y, size.Z) * 1.8
            else
                local size = zoomClone.Size
                dist = math.max(size.X, size.Y, size.Z) * 1.8
            end
            local camPos = targetPos + rot:VectorToWorldSpace(Vector3.new(0, 0, dist))
            zoomCam.CFrame = CFrame.new(camPos, targetPos)
        end
        zoomLastPos = i.Position
    end
end)
zoomViewport.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        zoomDrag = false
    end
end)

