        if type(item.lowestResalePrice) == "number" then addRow("Lowest resale", "R$ " .. fmtNum(item.lowestResalePrice)) end
        addRow("Favorites", fmtNum(item.favorites or 0))
        if item.unitsAvailable and item.unitsAvailable > 0 then addRow("Units available", fmtNum(item.unitsAvailable)) end
        if item.totalQuantity and item.totalQuantity > 0 then addRow("Total quantity", fmtNum(item.totalQuantity)) end
        addRow("Collectible", yesNo(item.collectible))
        addRow("Has resellers", yesNo(item.hasResellers))
        addRow("Recolorable", yesNo(item.recolorable))
        addRow("Sale location", item.saleLocation)
        addRow("Off-sale deadline", fmtDate(item.offSaleDeadline))
        if item.bundleType ~= nil then addRow("Bundle type", item.bundleType) end
        if item.assetType ~= nil then addRow("Asset type", item.assetType) end
        addRow("Product ID", item.productId)
