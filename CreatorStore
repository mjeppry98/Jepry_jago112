local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do inst[k] = v end
    inst.Parent = parent
    return inst
end

local function tween(inst, duration, props, style, direction)
    local tw = TweenService:Create(inst, TweenInfo.new(
        duration, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out
    ), props)
    tw:Play()
    return tw
end

local function corner(inst, radius)
    return new("UICorner", { CornerRadius = radius or UDim.new(0, 8) }, inst)
end

local function isPress(i)
    return (i.UserInputType == Enum.UserInputType.MouseButton1)
        or (i.UserInputType == Enum.UserInputType.Touch)
end

local function txt(parent, text, size, color, font, boxSize, pos, alignX, extra)
    local t = new("TextLabel", {
        BackgroundTransparency = 1, Text = text, TextSize = size,
        TextColor3 = color or WHITE, Font = font or GOTHAM,
        Size = boxSize or UDim2.fromScale(1, 1),
        Position = pos or UDim2.new(),
        TextXAlignment = alignX or LEFT,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, parent)
    if extra then for k, v in pairs(extra) do t[k] = v end end
    return t
end

local function measureText(text, size, font)
    local ok, result = pcall(function()
        return TextService:GetTextSize(text, size, font, Vector2.new(10000, 100))
    end)
    if ok and result then return result.X end
    return #text * (size * 0.6)
end

local function raised(parent, size, position, tone, depth, radius, isStatic)
    depth = depth or 3
    radius = radius or UDim.new(0, 8)
    local holder = new("Frame", {
        BackgroundTransparency = 1, Size = size, Position = position
    }, parent)
    local base = new("Frame", {
        BackgroundColor3 = rgb(4, 4, 5), BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1)
    }, holder)
    corner(base, radius)
    local face = new("TextButton", {
        AutoButtonColor = false, Text = "",
        BackgroundColor3 = tone, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, -depth)
    }, holder)
    corner(face, radius)
    local grad = new("UIGradient", { Color = SHADE, Rotation = 90 }, face)
    local stroke = new("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = WHITE, Thickness = 1
    }, face)
    new("UIGradient", { Color = BEVEL, Rotation = 90 }, stroke)
    local label = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
        Font = GOTHAM_B, TextSize = 11, Text = "", TextColor3 = TEXT_LIGHT,
        TextXAlignment = Enum.TextXAlignment.Center
    }, face)
    
    local api = { Holder = holder, Base = base, Face = face, Stroke = stroke, Label = label, Tone = tone }
    
    if not isStatic then
        local scale = new("UIScale", {Scale = 1}, face)
        api.Scale = scale
        local hover, down = false, false
        local function render()
            local c = api.Tone
            if down then
                tween(scale, 0.1, {Scale = 0.92})
                tween(face, 0.08, {
                    Position = UDim2.fromOffset(0, depth - 1),
                    BackgroundColor3 = c:Lerp(Color3.new(0, 0, 0), 0.25)
                })
                tween(grad, 0.08, { Rotation = 270 })
            else
                tween(scale, 0.2, {Scale = hover and 1.04 or 1}, Enum.EasingStyle.Back)
                tween(face, 0.2, {
                    Position = UDim2.fromOffset(0, 0),
                    BackgroundColor3 = (hover and c:Lerp(WHITE, 0.12)) or c
                })
                tween(grad, 0.2, { Rotation = 90 })
            end
        end
        
        face.InputBegan:Connect(function(i) if isPress(i) then down = true; render() end end)
        face.InputEnded:Connect(function(i) if isPress(i) then down = false; render() end end)
        face.MouseEnter:Connect(function() hover = true; render() end)
        face.MouseLeave:Connect(function() hover = false; down = false; render() end)
        
        api.SetTone = function(c, tc)
            api.Tone = c; render()
            if tc then tween(label, 0.2, { TextColor3 = tc }) end
        end
    else
        api.SetTone = function(c, tc)
            api.Tone = c
            face.BackgroundColor3 = c
            if tc then label.TextColor3 = tc end
        end
    end
    return api
end

