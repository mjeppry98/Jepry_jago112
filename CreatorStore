U.viewportFrame.InputBegan:Connect(function(i)
    if isPress(i) then
        U.dragMode = "rotate"; U.lastPos = i.Position
        U.rightScroll.ScrollingEnabled = false
    elseif i.UserInputType == Enum.UserInputType.MouseButton2 or i.UserInputType == Enum.UserInputType.MouseButton3 then
        U.dragMode = "pan"; U.lastPos = i.Position
    end
end)

U.viewportFrame.InputChanged:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseWheel then
        setZoom(U.zoom * ((i.Position.Z > 0) and 1.12 or (1 / 1.12)))
    end
end)

keep(UserInputService.InputChanged:Connect(function(i)
    if not U.dragMode or not U.is3D or not isMove(i) then return end
    if U.pinching then U.lastPos = i.Position; return end
    local d = i.Position - U.lastPos
    U.lastPos = i.Position
    if U.dragMode == "rotate" then
        U.rotY += d.X * 0.5
        U.rotX = math.clamp(U.rotX - d.Y * 0.5, -89, 89)
    else
        local dist = U.vpBaseDist / U.zoom
        local f = (2 * dist * math.tan(math.rad(U.vpCamera.FieldOfView / 2))) / math.max(U.viewportFrame.AbsoluteSize.Y, 1)
        local lim = U.vpBaseDist * 2
        U.panX = math.clamp(U.panX - d.X * f, -lim, lim)
        U.panY = math.clamp(U.panY + d.Y * f, -lim, lim)
    end
    updateCamera()
end))

keep(UserInputService.InputEnded:Connect(function(i)
    if isPress(i) or i.UserInputType == Enum.UserInputType.MouseButton2 or i.UserInputType == Enum.UserInputType.MouseButton3 then
        U.dragMode = nil
