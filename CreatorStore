local function computeBounds(root)
    local minV, maxV
    local function consider(p)
        local cf, s = p.CFrame, p.Size
        for x = -1, 1, 2 do
            for y = -1, 1, 2 do
                for z = -1, 1, 2 do
                    local c = cf:PointToWorldSpace(Vector3.new(x * s.X / 2, y * s.Y / 2, z * s.Z / 2))
                    if not minV then
                        minV, maxV = c, c
                    else
                        minV = Vector3.new(math.min(minV.X, c.X), math.min(minV.Y, c.Y), math.min(minV.Z, c.Z))
                        maxV = Vector3.new(math.max(maxV.X, c.X), math.max(maxV.Y, c.Y), math.max(maxV.Z, c.Z))
                    end
                end
            end
        end
    end
    if root:IsA("BasePart") then consider(root) end
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("BasePart") then consider(d) end
    end
    if not minV then return nil end
    return (minV + maxV) / 2, maxV - minV
end

local function fetch3D(id, kind)
    local uri = "rbxassetid://" .. tostring(id)
    local obj
    if kind == "MeshPart" then
        pcall(function() obj = AssetService:CreateMeshPartAsync(uri) end)
        if not obj then pcall(function() obj = AssetService:CreateMeshPartAsync(Content.fromUri(uri)) end) end
    end
    if not obj then
        pcall(function()
            local o = game:GetObjects(uri)
            obj = o and o[1]
        end)
    end
    if not obj then pcall(function() obj = InsertService:LoadAsset(tonumber(id)) end) end
    return obj
end

