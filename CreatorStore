        tween(toggleScale, 0.15, { Scale = 1.08 })
    else
        tween(toggleBtnFace, 0.2, { Position = UDim2.fromOffset(0, 0), BackgroundColor3 = TONE_OFF })
        tween(toggleScale, 0.2, { Scale = 1 })
    end
end
