local function httpGet(url)
    local lastErr = "No HTTP method available in this executor."
    for _, f in ipairs(U.REQUESTERS) do
        local ok, res = pcall(f, { Url = url, Method = "GET", Headers = { ["Accept"] = "application/json" } })
        if ok and type(res) == "table" then
            if type(res.Body) == "string" and res.Body ~= "" then return res.Body end
            lastErr = "Empty response."
        elseif not ok then
            lastErr = tostring(res)
        end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and body ~= "" then return body end
    ok, body = pcall(function() return HttpService:GetAsync(url) end)
    if ok and type(body) == "string" and body ~= "" then return body end
    return nil, lastErr
end

local function apiGet(params)
    local q = {}
    for k, v in pairs(params) do
        table.insert(q, HttpService:UrlEncode(tostring(k)) .. "=" .. HttpService:UrlEncode(tostring(v)))
    end
    local url = BASE_URL .. "?" .. table.concat(q, "&")
    local body, err
    for _ = 1, 2 do
        body, err = httpGet(url)
        if body then break end
        task.wait(0.4)
    end
    if not body then return nil, err or "No response." end
    local okJ, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not okJ or type(data) ~= "table" then
        return nil, "Invalid JSON response. Check BASE_URL and your Vercel deployment."
    end
    if data.error then
        return nil, type(data.error) == "string" and data.error or HttpService:JSONEncode(data.error)
    end
    return data, nil, body
end

