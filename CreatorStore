local function sunken(parent, size, position, padLeft)
    local box = new("TextBox", {
        BackgroundColor3 = rgb(16, 16, 18), BorderSizePixel = 0,
        Size = size, Position = position,
        Font = GOTHAM, TextSize = 11, Text = "",
        TextColor3 = rgb(230, 230, 235),
        PlaceholderColor3 = rgb(112, 112, 118),
        ClearTextOnFocus = false, TextXAlignment = LEFT
    }, parent)
    corner(box, UDim.new(0, 8))
    new("UIGradient", { Color = SHADE_INV, Rotation = 90 }, box)
    new("UIPadding", {
        PaddingLeft = UDim.new(0, padLeft or 10),
        PaddingRight = UDim.new(0, 10)
    }, box)
    local stroke = new("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = WHITE, Thickness = 1
    }, box)
    new("UIGradient", { Color = BEVEL_INV, Rotation = 90 }, stroke)
    return box, stroke
end

local function surface(cg, radius)
    radius = radius or 14
    cg.BackgroundTransparency = 1
    corner(cg, UDim.new(0, radius))
    local bg = new("Frame", {
        BackgroundColor3 = rgb(30, 30, 34), BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1)
    }, cg)
    corner(bg, UDim.new(0, radius))
    new("UIGradient", { Color = ColorSequence.new(WHITE, rgb(92, 92, 96)), Rotation = 90 }, bg)
    local rim = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, cg)
    corner(rim, UDim.new(0, radius))
    local st = new("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Color = WHITE, Thickness = 2
    }, rim)
    new("UIGradient", {
        Color = ColorSequence.new(rgb(190, 190, 196), rgb(28, 28, 32)), Rotation = 90
    }, st)
end

local function popIn(scale, group)
    scale.Scale = 0.001
    if group then group.GroupTransparency = 1; tween(group, 0.14, { GroupTransparency = 0 }) end
    tween(scale, 0.2, { Scale = 1.12 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    task.delay(0.2, function()
        if scale.Parent then tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut) end
    end)
end

local function getHttpFunc()
    if syn and syn.request then return syn.request end
    if http and http.request then return http.request end
    if request then return request end
    if http_request then return http_request end
    return nil
end
local HTTP = getHttpFunc()

local function httpPost(url, apiKey, bodyTable)
    if not HTTP then return nil, "Executor does not support HTTP requests." end
    local ok, res = pcall(HTTP, {
        Url = url, Method = "POST",
        Headers = {
            ["x-api-key"] = apiKey,
            ["Content-Type"] = "application/json",
            ["Accept"] = "application/json"
        },
        Body = HttpService:JSONEncode(bodyTable)
    })
    if not ok then return nil, tostring(res) end
    if not res or not res.Body then return nil, "Empty response" end
    local decodeOk, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not decodeOk then return nil, "Invalid JSON" end
    return data, nil, res.Body
end

local function parseModelsFromResponse(data, category)
    if not data then return {}, nil end
    local models = {}
    local list = data.creatorStoreAssets or {}
    if type(list) ~= "table" then list = {} end
    for _, entry in ipairs(list) do
        if type(entry) == "table" then
            local asset = entry.asset or {}
            local creatorObj = entry.creator or {}
            local id = asset.id or asset.assetId
            if id then
                local name = asset.name or asset.assetName or ("Asset " .. tostring(id))
                local desc = asset.description or "No description available."
                local creatorName = "?"
                if type(creatorObj) == "table" then
                    creatorName = creatorObj.name or creatorObj.username or creatorObj.displayName or "?"
                elseif type(creatorObj) == "string" then
                    creatorName = creatorObj
                end
                table.insert(models, {
                    id = tostring(id), name = name, description = desc,
                    creator = creatorName, category = category,
                    thumbnail = "rbxthumb://type=Asset&id=" .. tostring(id) .. "&w=150&h=150"
                })
            end
        end
    end
    return models, data.data and data.data.nextPageToken or data.nextPageToken
end

