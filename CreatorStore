    end
end))

keep(UserInputService.TouchPinch:Connect(function(positions, scale, _, state)
    if not U.is3D then return end
    if state == Enum.UserInputState.Begin then
        if positions[1] and insideViewport(positions[1]) then U.pinching = true; U.pinchBase = U.zoom end
    elseif state == Enum.UserInputState.Change then
        if U.pinching then setZoom(U.pinchBase * scale) end
    else
        U.pinching = false
    end
end))

