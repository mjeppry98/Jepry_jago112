                if n <= 12 then addTag(t, U.ACCENT_B) end
            end
        end
        if item.duration and item.duration > 0 then addRow("Duration", fmtTime(item.duration)) end
        if item.stats then
            if item.stats.triangles then addRow("Triangles", fmtNum(item.stats.triangles)) end
            if item.stats.vertices then addRow("Vertices", fmtNum(item.stats.vertices)) end
        end
        if item.hasScripts ~= nil then
