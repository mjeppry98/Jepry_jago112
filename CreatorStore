local function buildDummy()
    local model
    pcall(function()
        local desc = Instance.new("HumanoidDescription")
        model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
    end)
    if not model then return nil end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("LuaSourceContainer") then
            pcall(function() d:Destroy() end)
        end
    end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then pcall(function() d.Anchored = true end) end
    end
    -- remove any default clothing so items are visible clearly
    for _, d in ipairs(model:GetChildren()) do
        if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
            pcall(function() d:Destroy() end)
        end
    end
    return model
end

local function placeAccessory(dummy, acc)
    local handle = acc:FindFirstChild("Handle")
    if not (handle and handle:IsA("BasePart")) then return false end
    local att1 = handle:FindFirstChildOfClass("Attachment")
    local placed = false
    if att1 then
        for _, p in ipairs(dummy:GetDescendants()) do
            if p:IsA("Attachment") and p.Name == att1.Name and p.Parent ~= handle and p.Parent:IsA("BasePart") and not p.Parent:IsDescendantOf(acc) then
                handle.CFrame = p.Parent.CFrame * p.CFrame * att1.CFrame:Inverse()
                placed = true
                break
            end
        end
    end
    if not placed then
        local head = dummy:FindFirstChild("Head")
        if head then
            handle.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2 + handle.Size.Y / 2, 0)
        end
    end
    handle.Anchored = true
    acc.Parent = dummy
    return true
end

local function applyToDummy(dummy, obj)
    local applied = false
    local list = { obj }
    for _, d in ipairs(obj:GetDescendants()) do table.insert(list, d) end
    for _, d in ipairs(list) do
        if d:IsA("Accessory") then
            local ok = placeAccessory(dummy, d)
            applied = applied or ok
        elseif d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
            for _, old in ipairs(dummy:GetChildren()) do
                if old.ClassName == d.ClassName then old:Destroy() end
            end
            d.Parent = dummy
            applied = true
        end
    end
    -- face decal
    local head = dummy:FindFirstChild("Head")
    if head then
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("Decal") and not d:IsDescendantOf(head) then
                local face = head:FindFirstChildOfClass("Decal")
                if face then face.Texture = d.Texture else d.Parent = head end
                applied = true
                break
            end
        end
        if obj:IsA("Decal") then
            local face = head:FindFirstChildOfClass("Decal")
            if face then face.Texture = obj.Texture else obj.Parent = head end
            applied = true
        end
    end
    -- body part meshes (match by name)
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("MeshPart") and not d:FindFirstAncestorOfClass("Accessory") then
            local target = dummy:FindFirstChild(d.Name)
            if target and target:IsA("MeshPart") then
                pcall(function()
                    target.MeshId = d.MeshId
                    if d.TextureID ~= "" then target.TextureID = d.TextureID end
                end)
                applied = true
            end
        end
    end
    return applied
end

local function catalogIds(item)
    local ids = {}
    if item.bundledItems and #item.bundledItems > 0 then
        for n, b in ipairs(item.bundledItems) do
            if n > 12 then break end
            if b.id and (b.type == nil or b.type == "" or b.type == "Asset") then
                table.insert(ids, b.id)
            end
        end
    end
    if #ids == 0 and item.kind ~= "Bundle" then ids[1] = item.id end
    return ids
end

-- returns object (or nil) and optional message
local function loadCatalog3D(item, my)
    local ids = catalogIds(item)
    if #ids == 0 then return nil, "3D preview unavailable for this bundle" end

    local dummy
    if U.useDummy then
        dummy = buildDummy()
        if not dummy then return nil, "Dummy could not be created in this executor" end
    end

    local loaded = {}
    for _, id in ipairs(ids) do
        if my ~= U.vpToken then
            if dummy then dummy:Destroy() end
            return nil
        end
        local obj = fetch3D(id, "Model")
        if obj then table.insert(loaded, obj) end
    end
    if my ~= U.vpToken then
        if dummy then dummy:Destroy() end
        for _, o in ipairs(loaded) do pcall(function() o:Destroy() end) end
        return nil
    end
    if #loaded == 0 then
        if dummy then dummy:Destroy() end
        return nil, "3D preview unavailable for this asset"
    end

    if dummy then
        local any = false
        for _, o in ipairs(loaded) do
            for _, d in ipairs(o:GetDescendants()) do
                if d:IsA("LuaSourceContainer") then pcall(function() d:Destroy() end) end
            end
            for _, d in ipairs(o:GetDescendants()) do
                if d:IsA("BasePart") then pcall(function() d.Anchored = true end) end
            end
            if applyToDummy(dummy, o) then any = true end
            pcall(function() o:Destroy() end)
        end
        if not any then
            return dummy, nil
        end
        return dummy, nil
    end

    -- no dummy: show the first loaded object that has visible geometry
    for _, o in ipairs(loaded) do
        local center = computeBounds(o)
        if center then
            for _, other in ipairs(loaded) do
                if other ~= o then pcall(function() other:Destroy() end) end
            end
            return o, nil
        end
    end
    for _, o in ipairs(loaded) do pcall(function() o:Destroy() end) end
    return nil, "No 3D geometry. Turn DUMMY on to preview this item"
end

local function load3D(item)
    U.vpToken += 1
    local my = U.vpToken
    clearViewport()
    U.vpStatus.Text = "Loading 3D preview..."
    U.vpStatus.Visible = true
    task.spawn(function()
        local obj, msg
        if item.source == "catalog" then
            obj, msg = loadCatalog3D(item, my)
        else
            obj = fetch3D(item.id, item.kind)
        end
        if my ~= U.vpToken or not U.is3D then
            if obj then pcall(function() obj:Destroy() end) end
            return
        end
        if not obj then
            U.vpStatus.Text = msg or "3D preview unavailable for this asset"
            return
        end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then
                pcall(function() d:Destroy() end)
            elseif d:IsA("BasePart") then
                pcall(function() d.Anchored = true end)
            end
        end
        if obj:IsA("BasePart") then pcall(function() obj.Anchored = true end) end
        obj.Parent = U.viewportFrame
        local center, size = computeBounds(obj)
        if not center then
            obj:Destroy()
            U.vpStatus.Text = msg or "3D preview unavailable for this asset"
            return
        end
        U.vpModel = obj
        U.vpCenter = center
        local radius = math.max(size.Magnitude / 2, 0.5)
        U.vpBaseDist = radius / math.sin(math.rad(U.vpCamera.FieldOfView / 2))
        U.vpStatus.Visible = false
        resetCamera()
    end)
end

