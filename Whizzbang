local HUD_OPACITY = 0.30

local TANK_KW = {"tank","vehicle","armor","apc","truck","car","mech","walker","artillery"}
local FLAME_KW = {"flame","flamer","flamethrower","pyro","fire","burn","torch"}
local HOSTILE_KW = {"enemy","hostile","soldier","infantry","grunt","troop","rifleman","tank","flamer",
    "flamethrower","pyro","artillery","boss","mob","attacker","raider","invader","zombie","monster","bot"}
local NEUTRAL_KW = {"shop","vendor","shopkeeper","merchant","trader","medic","doctor","nurse","quest",
    "giver","guide","npc_","service","blacksmith","smith","trainer","sign","statue","mannequin","dummy",
    "display","prop","decoration"}
local ENEMY_FOLDERS = {"enemies","hostiles","mobs","npcs","ai","bots","monsters"}

local function kwFind(s, list)
    for _, kw in ipairs(list) do
        if s:find(kw, 1, true) then return true end
    end
    return false
end

local function isLargeModel(m)
    local ok, sz = pcall(function() return m:GetExtentsSize() end)
    return ok and sz and (sz.X > 8 or sz.Y > 8 or sz.Z > 8)
end

local function hasFire(m)
    if m:FindFirstChildOfClass("Fire") then return true end
    for _, o in ipairs(m:GetDescendants()) do
        if o:IsA("Fire") then return true end
        if o:IsA("ParticleEmitter") then
            local n = string.lower(o.Name)
            if n:find("fire") or n:find("flame") or n:find("burn") then return true end
            local t = string.lower(tostring(o.Texture or ""))
            if t:find("fire") or t:find("flame") then return true end
        end
    end
    return false
end

local function isInEnemyFolder(m)
    local node, d = m.Parent, 0
    while node and node ~= game and d < 6 do
        local n = string.lower(node.Name)
        for _, f in ipairs(ENEMY_FOLDERS) do
            if n:find(f, 1, true) then return true end
        end
        node = node.Parent
        d = d + 1
    end
    return false
end

local function hasWeapon(m)
    for _, c in ipairs(m:GetChildren()) do
        if c:IsA("Tool") then return true end
        if c:IsA("Accessory") then
            local n = string.lower(c.Name)
            if n:find("gun") or n:find("weapon") or n:find("rifle") or n:find("sword") or n:find("knife") then
                return true
            end
        end
    end
    return false
end

local function hasCombatTag(m)
    for _, a in ipairs({"Enemy","Hostile","IsEnemy","IsHostile","Faction","Team","isEnemy","isHostile"}) do
        local ok, v = pcall(function() return m:GetAttribute(a) end)
        if ok and v ~= nil then
            if type(v) == "boolean" and v == true then return true end
            if type(v) == "string" then
                local s = string.lower(v)
                if s == "enemy" or s == "hostile" or s == "monster" or s == "axis" then return true end
            end
        end
    end
    for _, t in ipairs(CollectionService:GetTags(m)) do
        local tl = string.lower(t)
        if tl:find("enemy") or tl:find("hostile") or tl:find("mob") then return true end
    end
    return false
end

local function hasEnemyTeam(m)
    local myName = LP.Team and LP.Team.Name or nil
    local tv = m:GetAttribute("Team") or m:GetAttribute("team")
    if tv and myName and tostring(tv) ~= myName then return true end
    for _, c in ipairs(m:GetChildren()) do
        if c:IsA("StringValue") and string.lower(c.Name) == "team" then
            if myName and c.Value ~= myName then return true end
        end
    end
    return false
end

local function isHostileNPC(m)
    if not m or not m.Parent or not m:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(m) then return false end
    local name = string.lower(m.Name)
    for _, kw in ipairs(NEUTRAL_KW) do
        if name:find(kw, 1, true) and not kwFind(name, HOSTILE_KW) then return false end
    end
    if isInEnemyFolder(m) then return true end
    if hasCombatTag(m) then return true end
    if hasWeapon(m) then return true end
    if kwFind(name, HOSTILE_KW) then return true end
    if hasEnemyTeam(m) then return true end
    return false
end

local function isAliveModel(m)
    if not m or not m.Parent or not m:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(m) then return false end
    local h = m:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function categorize(m)
    local n = string.lower(m.Name)
    if kwFind(n, FLAME_KW) or hasFire(m) then return "Flamethrower" end
    if kwFind(n, TANK_KW) or isLargeModel(m) then return "Tank" end
    return "Infantry"
end

local function countEnemies()
    local c = {Tank = 0, Flamethrower = 0, Infantry = 0}
    local total = 0
    local roots = {}
    for _, f in ipairs({"Enemies","enemies","Hostiles","hostiles","NPCs","npcs","Mobs","mobs","AI","ai","Bots","bots"}) do
        local obj = workspace:FindFirstChild(f)
        if obj then table.insert(roots, obj) end
    end
    if #roots == 0 then table.insert(roots, workspace) end
    for _, r in ipairs(roots) do
        pcall(function()
            for _, o in ipairs(r:GetDescendants()) do
                if o:IsA("Model") and isAliveModel(o) and isHostileNPC(o) then
                    local cat = categorize(o)
                    c[cat] = c[cat] + 1
                    total = total + 1
                end
            end
        end)
    end
    return total, c
end

