-- ===== INSTANT PROXIMITY PROMPT =====
local PROTECTED_KEYWORDS = {
    "adjust", "bake", "cook", "hold", "charge", "channel",
    "wind", "pull", "grind", "sharpen", "pour", "stir"
}

local function isProtectedPrompt(prompt)
    if not prompt then return false end
    local combined = string.lower(
        (prompt.Name or "") .. " " .. (prompt.ActionText or "") .. " " .. (prompt.ObjectText or "")
    )
    for _, kw in ipairs(PROTECTED_KEYWORDS) do
        if combined:find(kw, 1, true) then return true end
    end
    return false
end

local originalHoldDurations = {}

local function applyInstantPrompt(prompt)
    if not prompt or not prompt.Parent then return end
    if not prompt:IsA("ProximityPrompt") then return end
    if isProtectedPrompt(prompt) then return end
    if originalHoldDurations[prompt] == nil then
        originalHoldDurations[prompt] = prompt.HoldDuration
    end
    pcall(function() prompt.HoldDuration = 0 end)
end

local function restoreInstantPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    if originalHoldDurations[prompt] ~= nil then
        pcall(function() prompt.HoldDuration = originalHoldDurations[prompt] end)
        originalHoldDurations[prompt] = nil
    end
end

local function applyAllPrompts()
    pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then applyInstantPrompt(obj) end
        end
    end)
end

local function restoreAllPrompts()
    pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then restoreInstantPrompt(obj) end
        end
    end)
end

local function startInstantPrompt()
    applyAllPrompts()
    pcall(function()
        if _G.InstantPromptConn then _G.InstantPromptConn:Disconnect() end
        _G.InstantPromptConn = workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("ProximityPrompt") and WhizConfig.InstantPrompt then
                task.wait(0.05)
                applyInstantPrompt(obj)
            end
        end)
    end)
    task.spawn(function()
        while WhizConfig.InstantPrompt do
            applyAllPrompts()
            task.wait(1)
        end
    end)
end

local function stopInstantPrompt()
    pcall(function()
        if _G.InstantPromptConn then
            _G.InstantPromptConn:Disconnect()
            _G.InstantPromptConn = nil
        end
    end)
    restoreAllPrompts()
end

-- ===== AUTO MAKE BREAD =====
local BREAD_KEYWORDS = {
    "bread", "roti", "dough", "adonan", "flour", "tepung", "loaf",
    "bake", "cook", "masak", "make", "buat", "craft", "mix", "campur",
    "prepare", "siapkan", "put", "place", "taruh", "insert", "load",
    "knead", "uleni", "roll", "shape", "bentuk",
    "oven", "bakery", "kitchen", "stove", "furnace", "kiln", "toaster",
    "dapur", "tungku", "panggangan"
}

local function matchesBread(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    local combined = string.lower(
        (prompt.Name or "") .. " " .. (prompt.ActionText or "") .. " " .. (prompt.ObjectText or "")
    )
    local node = prompt.Parent
    local depth = 0
    while node and node ~= workspace and depth < 6 do
        combined = combined .. " " .. string.lower(node.Name or "")
        node = node.Parent
        depth = depth + 1
    end
    for _, kw in ipairs(BREAD_KEYWORDS) do
        if combined:find(kw, 1, true) then return true end
    end
    return false
end

local function triggerPrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    if not prompt:IsA("ProximityPrompt") then return false end
    if prompt.Enabled == false then return false end

    local fired = false
    if type(fireproximityprompt) == "function" then
        local ok = pcall(fireproximityprompt, prompt)
        if ok then fired = true end
    end
    local ok2 = pcall(function()
        local originalHold = tonumber(prompt.HoldDuration) or 0
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
        task.wait(0.02)
        prompt.HoldDuration = originalHold
    end)
    if ok2 then fired = true end
    pcall(function()
        local hold = tonumber(prompt.HoldDuration) or 0
        if hold > 0.2 then
            prompt:InputHoldBegin()
            task.wait(hold + 0.08)
            prompt:InputHoldEnd()
        end
    end)
    return fired
end

local function collectBreadPrompts()
    local found = {}
    pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled and matchesBread(obj) then
                table.insert(found, obj)
            end
        end
    end)
    return found
end

local function autoMakeBreadOnce()
    local prompts = collectBreadPrompts()
    if #prompts == 0 then return false end
    for _, p in ipairs(prompts) do
        triggerPrompt(p)
        task.wait(0.12)
    end
    return true
end

local function startAutoMakeBread()
    if _G.AutoMakeThread then return end
    _G.AutoMakeThread = true
    task.spawn(function()
        while WhizConfig.AutoMakeBread do
            pcall(autoMakeBreadOnce)
            task.wait(0.3)
        end
        _G.AutoMakeThread = false
    end)
end

local function stopAutoMakeBread()
    WhizConfig.AutoMakeBread = false
    _G.AutoMakeThread = false
    print("[WHIZZBANG] Auto Make Bread OFF")
end

