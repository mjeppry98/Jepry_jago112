-- ===== AUTO WRESTLE =====
local function isGreenish(color)
    if not color then return false end
    local r, g, b = color.R, color.G, color.B
    return g > 0.35 and g > r * 1.2 and g > b * 1.2
end

local function getColor(obj)
    if obj:IsA("ImageLabel") then
        local c = obj.ImageColor3
        if c and (c.R + c.G + c.B) > 0.01 then return c end
    end
    return obj.BackgroundColor3
end

local function isVisible(obj)
    if not obj.Visible then return false end
    if obj.BackgroundTransparency >= 0.9 and not obj:IsA("ImageLabel") then return false end
    if obj.AbsoluteSize.X <= 0 or obj.AbsoluteSize.Y <= 0 then return false end
    return true
end

local function findGreenZones(root)
    local zones = {}
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("GuiObject") and isVisible(obj) then
            if isGreenish(getColor(obj)) then
                table.insert(zones, {
                    x1 = obj.AbsolutePosition.X,
                    x2 = obj.AbsolutePosition.X + obj.AbsoluteSize.X,
                })
            end
        end
    end
    return zones
end

local function findMarker(root)
    local trackers = _G.WrestleTrackers
    local now = tick()
    local best, bestSpeed = nil, 0
    local active = {}
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("GuiObject") and isVisible(obj) then
            active[obj] = true
            local t = trackers[obj]
            local x = obj.AbsolutePosition.X
            if not t then
                trackers[obj] = { lastX = x, lastTime = now, speed = 0 }
            else
                local dt = now - t.lastTime
                if dt > 0.01 then
                    local speed = math.abs(x - t.lastX) / dt
                    t.speed = t.speed * 0.6 + speed * 0.4
                    t.lastX = x
                    t.lastTime = now
                    if t.speed > bestSpeed then
                        bestSpeed = t.speed
                        best = obj
                    end
                end
            end
        end
    end
    for obj, _ in pairs(trackers) do
        if not active[obj] and not obj.Parent then trackers[obj] = nil end
    end
    if bestSpeed > 40 then return best end
    return nil
end

local lastClickAt = 0
local function wrestleClick(x, y)
    local now = tick()
    if now - lastClickAt < 0.03 then return end
    lastClickAt = now
    pcall(function() VirtualUser:ClickButton1(Vector2.new(x, y)) end)
    if mouse1click then pcall(mouse1click) end
    if mouse1press and mouse1release then
        pcall(mouse1press)
        task.wait(0.02)
        pcall(mouse1release)
    end
end

local function startAutoWrestle()
    if _G.WrestleConn then _G.WrestleConn:Disconnect() end
    _G.WrestleConn = RS.Heartbeat:Connect(function()
        if not WhizConfig.AutoWrestle then return end
        pcall(function()
            local gui
            for _, child in ipairs(LP.PlayerGui:GetChildren()) do
                if child:IsA("ScreenGui") and child.Enabled then
                    local n = string.lower(child.Name)
                    if n:find("wrestle") or n:find("armwrestle") or n:find("arm_wrestle") then
                        gui = child
                        break
                    end
                end
            end
            if not gui then return end
            local zones = findGreenZones(gui)
            if #zones == 0 then return end
            local marker = findMarker(gui)
            if not marker then return end
            local mx = marker.AbsolutePosition.X + marker.AbsoluteSize.X * 0.5
            local my = marker.AbsolutePosition.Y + marker.AbsoluteSize.Y * 0.5
            for _, zone in ipairs(zones) do
                if mx >= zone.x1 and mx <= zone.x2 then
                    wrestleClick(mx, my)
                    return
                end
            end
        end)
    end)
end

local function stopAutoWrestle()
    if _G.WrestleConn then _G.WrestleConn:Disconnect(); _G.WrestleConn = nil end
    _G.WrestleTrackers = {}
end

-- ===== WOUNDED PLAYER MARKER =====
local WOUNDED_MAX_HP_THRESHOLD = 0.85
local woundedTags = {}

local function hasMissingLimbs(character)
    if not character then return false end
    local isR15 = character:FindFirstChild("UpperTorso") ~= nil
    local coreParts
    if isR15 then
        coreParts = {"Head","UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"}
    else
        coreParts = {"Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg"}
    end
    for _, name in ipairs(coreParts) do
        if not character:FindFirstChild(name) then return true end
    end
    return false
end

local function isWounded(plr)
    if not plr or plr == LP then return false end
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if hum.Health <= 0 then return false end
    local maxHp = hum.MaxHealth > 0 and hum.MaxHealth or 100
    local ratio = hum.Health / maxHp
    if ratio <= WOUNDED_MAX_HP_THRESHOLD then return true end
    if hasMissingLimbs(char) then return true end
    return false
end

