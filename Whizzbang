local EXPECTED_PLACE_ID = 14234703115

if game.PlaceId ~= EXPECTED_PLACE_ID then
    local TeleportService = game:GetService("TeleportService")
    local HttpService     = game:GetService("HttpService")
    local StarterGui      = game:GetService("StarterGui")
    local LP_LOCK         = game:GetService("Players").LocalPlayer

    -- Show "Wrong game fam" message (kick-style notification)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title    = "WHIZZBANG",
            Text     = "Wrong game fam",
            Duration = 3,
        })
    end)

    -- Also attempt a real client-side kick (may or may not work depending on executor)
    pcall(function()
        LP_LOCK:Kick("Wrong game fam")
    end)

    -- In a separate thread: find the server with the most players & teleport
    task.spawn(function()
        local bestJobId   = nil
        local bestCount   = -1

        pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. EXPECTED_PLACE_ID ..
                        "/servers/Public?sortOrder=Desc&limit=100"
            local raw = game:HttpGet(url)
            local data = HttpService:JSONDecode(raw)
            if data and data.data then
                for _, srv in ipairs(data.data) do
                    if type(srv) == "table"
                        and type(srv.playing) == "number"
                        and type(srv.id) == "string"
                        and srv.playing > bestCount then
                        bestCount = srv.playing
                        bestJobId = srv.id
                    end
                end
            end
        end)

        -- Let the notification display for a moment
        task.wait(1.3)

        if bestJobId then
            pcall(function()
                TeleportService:TeleportToPlaceInstance(EXPECTED_PLACE_ID, bestJobId, LP_LOCK)
            end)
        else
            -- Fallback: normal teleport (Roblox will assign a server)
            pcall(function()
                TeleportService:Teleport(EXPECTED_PLACE_ID, LP_LOCK)
            end)
        end
    end)

    return
end
