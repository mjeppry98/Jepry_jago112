local woundedThread = false
local function startWoundedUpdater()
    if woundedThread then return end
    woundedThread = true
    task.spawn(function()
        while WhizConfig.WoundedPlayer do
            pcall(function()
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LP then
                        if isWounded(plr) then
                            if not woundedTags[plr] then
                                buildWoundedTag(plr)
                            else
                                local data = woundedTags[plr]
                                local char = plr.Character
                                local hum = char and char:FindFirstChildOfClass("Humanoid")
                                if data and data.hpLabel and hum then
                                    data.hpLabel.Text = string.format("HP: %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
                                end
                            end
                        else
                            if woundedTags[plr] then removeWoundedTag(plr) end
                        end
                    end
                end
            end)
            task.wait(0.4)
        end
        woundedThread = false
    end)
end

local function stopWoundedUpdater()
    for plr, _ in pairs(woundedTags) do
        removeWoundedTag(plr)
    end
    woundedTags = {}
    pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "WoundedTag" or obj.Name == "WoundedHighlight" then
                obj:Destroy()
            end
        end
    end)
end

