        if not changed and lastCounts then
            if (counts.Tank ~= lastCounts.Tank)
            or (counts.Flamethrower ~= lastCounts.Flamethrower)
            or (counts.Infantry ~= lastCounts.Infantry)
            or (counts.Others ~= lastCounts.Others) then
                changed = true
