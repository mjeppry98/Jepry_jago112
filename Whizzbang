local TARGET_PART_RESOLVERS = {
    ["Head"]  = function(model) return model:FindFirstChild("Head") end,
    ["Torso"] = function(model)
        return model:FindFirstChild("UpperTorso")
            or model:FindFirstChild("Torso")
