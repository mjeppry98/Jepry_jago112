local function UniversalReload()
    pcall(function()
        local char = LP.Character
        if not char then return end
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local r = tool:FindFirstChild("RemoteEvent", true)
                if r and r.Parent and r.Parent.Name == "prompt" then
                    r:FireServer()
                end
            end
        end
        local fastList = {"lee", "web", "cow", "spring", "flare"}
        for _, name in pairs(fastList) do
            local w = char:FindFirstChild(name)
            if w and w:FindFirstChild("Handle") then
                pcall(function()
                    w.Handle.wood.promptload.prompt.RemoteEvent:FireServer()
                end)
            end
        end
    end)
end

-- ===== AUTO MAKE BREAD =====
local BREAD_KEYWORDS = {
    "bread", "roti", "dough", "adonan", "flour", "tepung",
    "bake", "cook", "masak", "make", "buat", "craft", "mix", "campur",
    "prepare", "siapkan", "put", "place", "taruh", "insert", "load",
    "oven", "bakery", "kitchen", "stove", "furnace", "kiln"
}

local function matchesBread(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    local combined = string.lower(
        (prompt.Name or "") .. " " .. (prompt.ActionText or "") .. " " .. (prompt.ObjectText or "")
    )
    local node = prompt.Parent
    local depth = 0
    while node and node ~= workspace and depth < 5 do
        combined = combined .. " " .. string.lower(node.Name or "")
        node = node.Parent
        depth = depth + 1
    end
    for _, kw in ipairs(BREAD_KEYWORDS) do
        if combined:find(kw, 1, true) then return true end
    end
    return false
end

local function firePromptRobust(prompt)
    if not prompt or not prompt.Parent then return false end
    if prompt.Enabled == false then return false end
    if type(fireproximityprompt) == "function" then
        local ok = pcall(fireproximityprompt, prompt)
        if ok then return true end
    end
    local ok = pcall(function()
        local hold = tonumber(prompt.HoldDuration) or 0
        prompt:InputHoldBegin()
        if hold > 0 then task.wait(hold + 0.05) else task.wait(0.05) end
        prompt:InputHoldEnd()
    end)
    return ok
end

local function collectBreadPrompts()
    local found = {}
    pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                if matchesBread(obj) then table.insert(found, obj) end
            end
        end
    end)
    return found
end

local function autoMakeBreadOnce()
    local prompts = collectBreadPrompts()
    if #prompts == 0 then return false end
    for _, p in ipairs(prompts) do
        firePromptRobust(p)
        task.wait(0.08)
    end
    return true
end

local function startAutoMakeBread()
    if _G.AutoMakeThread then return end
    _G.AutoMakeThread = true
    task.spawn(function()
        while WhizConfig.AutoMakeBread do
            local ok = pcall(autoMakeBreadOnce)
            if not ok then task.wait(0.5) end
            task.wait(0.35)
        end
        _G.AutoMakeThread = false
    end)
end

local function stopAutoMakeBread()
    WhizConfig.AutoMakeBread = false
    _G.AutoMakeThread = false
    print("[WHIZZBANG] Auto Make Bread OFF")
end

