local function createPersonalityChips()
    for key, data in pairs(Personalities) do
        local chip = Instance.new("TextButton")
        chip.Name = key
        chip.Size = UDim2.new(0, 0, 0, 28)
        chip.BackgroundColor3 = Color3.fromRGB(255,255,255)
        chip.BackgroundTransparency = 0.9
        chip.BorderSizePixel = 0
        chip.Text = data.emoji .. " " .. data.label
        chip.TextColor3 = Color3.fromRGB(200,200,200)
        chip.TextSize = 12
        chip.Font = Enum.Font.GothamBold
        chip.AutoButtonColor = true
        chip.Parent = chipContainer2

        local chipCorner = Instance.new("UICorner")
        chipCorner.CornerRadius = UDim.new(1, 0)
        chipCorner.Parent = chip

        if key == currentPersonality then
            chip.BackgroundColor3 = orange500
            chip.BackgroundTransparency = 0.2
            chip.TextColor3 = Color3.fromRGB(255,255,255)
        end

        chip.MouseButton1Click:Connect(function()
            for _, c in pairs(chipContainer2:GetChildren()) do
                if c:IsA("TextButton") then
                    c.BackgroundColor3 = Color3.fromRGB(255,255,255)
                    c.BackgroundTransparency = 0.9
                    c.TextColor3 = Color3.fromRGB(200,200,200)
                end
            end
            chip.BackgroundColor3 = orange500
            chip.BackgroundTransparency = 0.2
            chip.TextColor3 = Color3.fromRGB(255,255,255)
            currentPersonality = key
            badgeLabel.Text = data.emoji .. " " .. data.label
            if isActive then
                addMessage(BotName .. ": Personality changed to **" .. data.label .. "**! " .. data.emoji, true)
            end
        end)
    end
end
createPersonalityChips()

