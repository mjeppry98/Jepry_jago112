function addMessage(text, isBot)
    typingFrame.Visible = false

    local msgFrame = Instance.new("Frame")
    msgFrame.Size = UDim2.new(1, -10, 0, 0)
    msgFrame.BackgroundTransparency = 1
    msgFrame.Parent = messagesFrame

    local bubble = Instance.new("TextLabel")
    bubble.Size = UDim2.new(0, 0, 0, 0)
    bubble.BackgroundColor3 = isBot and Color3.fromRGB(50,40,30) or orange500
    bubble.BackgroundTransparency = isBot and 0.1 or 0.2
    bubble.BorderSizePixel = 0
    bubble.Text = text
    bubble.TextColor3 = isBot and Color3.fromRGB(240,240,240) or Color3.fromRGB(255,255,255)
    bubble.TextSize = 14
    bubble.Font = Enum.Font.Gotham
    bubble.TextWrapped = true
    bubble.AutomaticSize = Enum.AutomaticSize.Y
    bubble.TextXAlignment = Enum.TextXAlignment.Left
    bubble.Parent = msgFrame

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 12)
    bCorner.Parent = bubble

    if isBot then
        bubble.Position = UDim2.new(0, 8, 0, 0)
        bubble.Size = UDim2.new(0, math.min(300, bubble.TextBounds.X + 20), 0, 0)
    else
        bubble.Position = UDim2.new(1, -8 - bubble.TextBounds.X, 0, 0)
        bubble.Size = UDim2.new(0, math.min(300, bubble.TextBounds.X + 20), 0, 0)
    end

    wait(0.05)
    messagesFrame.CanvasSize = UDim2.new(0, 0, 0, msgLayout.AbsoluteContentSize.Y + 20)
    messagesFrame.CanvasPosition = Vector2.new(0, messagesFrame.CanvasSize.Y.Offset)
end

function showTyping()
    typingFrame.Visible = true
    wait(0.05)
    messagesFrame.CanvasSize = UDim2.new(0, 0, 0, msgLayout.AbsoluteContentSize.Y + 40)
    messagesFrame.CanvasPosition = Vector2.new(0, messagesFrame.CanvasSize.Y.Offset)
end

function hideTyping()
    typingFrame.Visible = false
    wait(0.05)
    messagesFrame.CanvasSize = UDim2.new(0, 0, 0, msgLayout.AbsoluteContentSize.Y + 20)
    messagesFrame.CanvasPosition = Vector2.new(0, messagesFrame.CanvasSize.Y.Offset)
end

function processUserMessage(msg)
    if msg == "" then return end
    addMessage("You: " .. msg, false)
    -- Check trigger
    local lower = string.lower(msg)
    if not string.find(lower, string.lower(triggerWord), 1, true) then
        addMessage(BotName .. ": Sorry, I only respond to the trigger '" .. triggerWord .. "'", true)
        return
    end
    -- Check range
    if not isInRange() then
        addMessage(BotName .. ": Sorry, you are too far from me! (max range " .. maxRange .. " studs)", true)
        return
    end
    -- Process
    showTyping()
    wait(0.5 + math.random() * 1.0)
    local reply = getBotResponse(msg)
    hideTyping()
    addMessage(BotName .. ": " .. reply, true)
end

