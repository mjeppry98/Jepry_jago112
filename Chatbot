function updateActiveUI()
    local active = isActive
    toggleActive.BackgroundColor3 = active and orange500 or Color3.fromRGB(60,60,80)
    thumb2.Position = active and UDim2.new(0, 27, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    statusLabel.Text = active and "Online" or "Inactive"
    textBox.Enabled = active
    sendBtn.Enabled = active
    disabledOverlay.Visible = not active
    if active then
        -- Show greeting if no messages yet
        if messagesFrame:FindFirstChildWhichIsA("Frame") == nil then
            addMessage(BotName .. ": " .. Personalities[currentPersonality].greeting, true)
        end
    end
end

toggleActive.MouseButton1Click:Connect(function()
    isActive = not isActive
    updateActiveUI()
end)

triggerBox.FocusLost:Connect(function(enter)
    if enter then
        local newTrigger = triggerBox.Text
        if newTrigger ~= "" then
            triggerWord = newTrigger
            addMessage(BotName .. ": Trigger word changed to '" .. triggerWord .. "'", true)
        else
            triggerBox.Text = triggerWord
        end
    end
end)

rangeSlider.FocusLost:Connect(function(enter)
    if enter then
        local val = tonumber(rangeSlider.Text)
        if val and val > 0 and val <= 100 then
            maxRange = val
            addMessage(BotName .. ": Response range changed to " .. maxRange .. " studs", true)
        else
            rangeSlider.Text = tostring(maxRange)
        end
    end
end)

