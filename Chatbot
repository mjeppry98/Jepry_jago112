-- === CREATE BOT PART ===
local function ensureBotPart()
    local part = workspace:FindFirstChild(BotPartName)
    if not part then
        part = Instance.new("Part")
        part.Name = BotPartName
        part.Size = Vector3.new(2, 2, 2)
        part.Anchored = true
        part.CanCollide = false
        part.Transparency = 0.8
        part.BrickColor = BrickColor.new("Bright orange")
        part.Position = Vector3.new(0, 5, 0)  -- default position
        part.Parent = workspace
        -- Add a highlight effect (optional)
        local highlight = Instance.new("Highlight")
        highlight.FillColor = Color3.fromRGB(249, 115, 22)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.Parent = part
    end
    return part
end
local botPart = ensureBotPart()

-- === GET PLAYER POSITION ===
local function getPlayerPosition()
    local char = game.Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    return char.HumanoidRootPart.Position
end

-- === CHECK DISTANCE ===
local function isInRange()
    local playerPos = getPlayerPosition()
    if not playerPos then return false end
    local dist = (playerPos - botPart.Position).Magnitude
    return dist <= maxRange
end

-- === BASE RESPONSES (English) ===
local BaseResponses = {
    ["hi"] = {"Hello! How can I help?", "Hi! How are you?", "Welcome!"},
    ["hello"] = {"Hello! Nice to meet you.", "Hi there!"},
    ["how are you"] = {"I'm fine, thanks! And you?", "Doing great! You?"},
    ["what is your name"] = {"My name is " .. BotName .. ". Nice to meet you!", "I'm " .. BotName .. ", your virtual assistant."},
    ["who are you"] = {"I'm " .. BotName .. ", here to assist you.", "I'm your friendly chatbot, " .. BotName .. "."},
    ["thank you"] = {"You're welcome! Glad to help.", "Anytime! :)"},
    ["thanks"] = {"You're welcome!", "Anytime!"},
    ["help"] = {"Ask me anything, I'll try to answer.", "Try saying 'hello' or 'how are you'."},
    ["help me"] = {"Sure! What can I do for you?", "I'm here to help."},
    ["bye"] = {"Goodbye! Have a great day.", "See you later! Take care."},
    ["goodbye"] = {"Goodbye! See you soon.", "Bye! Have a nice day."},
    ["roblox"] = {"Roblox is an amazing gaming platform!", "I love Roblox! So many fun games."},
    ["game"] = {"My favorite game is ... all Roblox games! :D", "Try playing something fun!"}
}

-- Function to get response
function getBotResponse(input)
    local lower = string.lower(input)
    for keyword, responses in pairs(BaseResponses) do
        if string.find(lower, keyword, 1, true) then
            local reply = responses[math.random(1, #responses)]
            local style = Personalities[currentPersonality].style
            return style(reply)
        end
    end
    local defaults = {
        "Sorry, I don't understand. Can you explain?",
        "Hmm, I haven't learned that yet. Try something else.",
        "I'm just a simple bot, but I'll try to help.",
        "Good question! Unfortunately I don't have the answer yet.",
        "Try asking 'hello' or 'how are you' to start."
    }
    local reply = defaults[math.random(1, #defaults)]
    return Personalities[currentPersonality].style(reply)
end

