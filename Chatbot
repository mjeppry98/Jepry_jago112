player.Chatted:Connect(function(msg)
    if not isActive then return end
    -- Only if contains trigger
    if string.find(string.lower(msg), string.lower(triggerWord), 1, true) then
        -- Show in UI and process
        addMessage("You (chat): " .. msg, false)
        if isInRange() then
            showTyping()
            wait(0.5 + math.random() * 1.0)
            local reply = getBotResponse(msg)
            hideTyping()
            addMessage(BotName .. ": " .. reply, true)
        else
            addMessage(BotName .. ": Sorry, you are too far!", true)
        end
    end
end)

