local function Round(n, d)
    local m = 10^(d or 0)
    return math.floor(n * m + 0.5) / m
end

local function GetAnswerText(q, key)
    return (key=="A" and q.a) or (key=="B" and q.b) or (key=="C" and q.c) or q.d
end

-- ================================================================
--  MISTRAL API
-- ================================================================
local function MistralChat(apiKey, prompt)
    local ok, res = pcall(HttpService.RequestAsync, HttpService, {
        Url    = MISTRAL_URL,
        Method = "POST",
        Headers = {
            ["Content-Type"]  = "application/json",
            ["Authorization"] = "Bearer " .. apiKey,
        },
        Body = HttpService:JSONEncode({
            model       = MISTRAL_MODEL,
            max_tokens  = 4096,
            temperature = 0.8,
            messages    = { { role="user", content=prompt } },
        }),
    })
    if not ok then return nil, "Network error: "..tostring(res) end
    if res.StatusCode ~= 200 then
        local detail = ""
        pcall(function()
            local d = HttpService:JSONDecode(res.Body)
            detail  = d.message or d.error or ""
        end)
        return nil, ("HTTP %d %s"):format(res.StatusCode, detail)
    end
    local jok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if not jok then return nil, "JSON parse error" end
    local c = data.choices and data.choices[1]
    if not (c and c.message and c.message.content) then return nil, "Unexpected API shape" end
    return c.message.content, nil
end

local function ValidateKey(key)
    Log("Contacting Mistral to validate key…", "info")
    local txt, err = MistralChat(key, "Reply with only the word: VALID")
    if err then return false, err end
    if txt  then return true,  nil  end
    return false, "No response received"
end

-- ================================================================
--  QUESTION PARSER
-- ================================================================
local function ParseQuestions(raw)
    local qs, cur = {}, nil
    for line in (raw.."\n"):gmatch("([^\n]*)\n") do
        line = line:match("^%s*(.-)%s*$")
        if line:match("^Q%d+[%.:%)] ?") or line:match("^Q%d+:") then
            if cur and cur.q and cur.a and cur.b and cur.c and cur.d and cur.ans then
                table.insert(qs, cur)
            end
            cur = { q=line:gsub("^Q%d+[%.:%)]%s*",""), a=nil, b=nil, c=nil, d=nil, ans=nil }
        elseif cur then
            if    line:match("^A[%.:%)]")            then cur.a  = line:gsub("^A[%.:%)]%s*","")
            elseif line:match("^B[%.:%)]")           then cur.b  = line:gsub("^B[%.:%)]%s*","")
            elseif line:match("^C[%.:%)]")           then cur.c  = line:gsub("^C[%.:%)]%s*","")
            elseif line:match("^D[%.:%)]")           then cur.d  = line:gsub("^D[%.:%)]%s*","")
            elseif line:upper():match("^ANSWER[%.:%)]") then
                local a = line:gsub("^[Aa][Nn][Ss][Ww][Ee][Rr][%.:%)]%s*",""):upper():sub(1,1)
                if a=="A" or a=="B" or a=="C" or a=="D" then cur.ans = a end
            end
        end
    end
    if cur and cur.q and cur.a and cur.b and cur.c and cur.d and cur.ans then
        table.insert(qs, cur)
    end
    return qs
end

local function GenerateQuestions(apiKey, category, difficulty)
    local ckey = category.."|"..difficulty
    if S.Cache[ckey] and #S.Cache[ckey] >= 10 then
        Log("Loaded "..#S.Cache[ckey].." questions from cache.", "info")
        return S.Cache[ckey], nil
    end

    local prompt = ([[
You are a professional quiz question generator.
Generate exactly 20 multiple-choice questions about "%s" at %s difficulty level.

Use this EXACT format for every question — no markdown, no bold, no asterisks, no extra text:

Q1: [question text]
A: [option]
B: [option]
C: [option]
D: [option]
ANSWER: [A or B or C or D]

Q2: [question text]
A: [option]
B: [option]
C: [option]
D: [option]
ANSWER: [A or B or C or D]

Repeat through Q20. Strict rules:
- All four options must be plausible
- Only one option is correct
- Difficulty: Easy=common knowledge, Medium=requires study, Hard=expert/trivia
- Apply %s difficulty to ALL 20 questions
- No repeated questions, no intro/closing text, no numbered lists outside Q1-Q20
]]):format(category, difficulty, difficulty)

    Log(("Generating 20 Qs: %s / %s…"):format(category, difficulty), "info")
    local txt, err = MistralChat(apiKey, prompt)
    if err then Log("Mistral error: "..err, "error") ; return nil, err end

    local qs = ParseQuestions(txt)
    local n  = #qs
    Log(("Parsed %d / 20 questions."):format(n), n >= 10 and "success" or "warn")
    if n < 5 then return nil, ("Only %d questions parsed. Try again."):format(n) end

    S.Cache[ckey] = qs
    return qs, nil
end

