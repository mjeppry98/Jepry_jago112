local function InitScores()
    S.Scores  = {}
    S.Streaks = {}
    S.Stats   = {}
    for _, p in ipairs(Players:GetPlayers()) do
        S.Scores[p.Name]  = 0
        S.Streaks[p.Name] = 0
        S.Stats[p.Name]   = { correct=0, wrong=0, bestStreak=0 }
    end
end

local function GetLeaderText()
    local rows = {}
    for name, score in pairs(S.Scores) do
        local st = S.Stats[name] or {}
        local tot = (st.correct or 0) + (st.wrong or 0)
        local acc = tot > 0 and Round((st.correct or 0)/tot*100, 1) or 0
        table.insert(rows, { name=name, score=score, acc=acc, best=st.bestStreak or 0 })
    end
    table.sort(rows, function(a,b) return a.score > b.score end)

    local medals = {"🥇","🥈","🥉"}
    local lines  = {
        "🏆  LEADERBOARD",
        ("Category: %s  |  Difficulty: %s"):format(S.Category, S.Difficulty),
        string.rep("─", 44),
        ("%-20s %5s  %6s  %6s"):format("PLAYER","SCORE","ACC %","STREAK"),
        string.rep("─", 44),
    }
    for i, r in ipairs(rows) do
        local rank = medals[i] or ("  #"..i)
        lines[#lines+1] = ("%s %-16s %5d  %5s%%  🔥x%d"):format(
            rank, r.name, r.score, r.acc, r.best)
    end
    if #rows == 0 then lines[#lines+1] = "(no players yet)" end
    return table.concat(lines, "\n")
end

local function RefreshLeader()
    SP(R.Leader, "🏆 Leaderboard", GetLeaderText())
end

local function GetStatsText()
    local lines = { "📊  PLAYER STATISTICS", string.rep("─",40) }
    local any = false
    for name, st in pairs(S.Stats) do
        any = true
        local tot = (st.correct or 0) + (st.wrong or 0)
        local acc = tot > 0 and Round((st.correct or 0)/tot*100, 1) or 0
        lines[#lines+1] = ("👤 %s"):format(name)
        lines[#lines+1] = ("   Score      : %d pts"):format(S.Scores[name] or 0)
        lines[#lines+1] = ("   Correct     : %d / %d"):format(st.correct or 0, tot)
        lines[#lines+1] = ("   Accuracy    : %s%%"):format(acc)
        lines[#lines+1] = ("   Best Streak : 🔥 x%d"):format(st.bestStreak or 0)
        lines[#lines+1] = ""
    end
    if not any then lines[#lines+1] = "(no data yet — complete a quiz)" end
    return table.concat(lines, "\n")
end

local function RefreshStats()
    SP(R.Stats, "📊 Player Stats", GetStatsText())
end

-- ================================================================
--  TIMER
