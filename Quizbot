TQuiz:CreateButton({
    Name = "🔁  Repeat Question",
    Callback = function()
        if not S.Active then Notify("⚠️ No Quiz", "No quiz running.", 2) ; return end
        S.Answered = {}
        S.Locked   = false
        ShowQuestion()
        Log(("Q%d repeated."):format(S.Current), "info")
        Notify("🔁 Repeated", ("Q%d shown again with fresh timer."):format(S.Current), 2)
    end,
})

TQuiz:CreateButton({
    Name = "📊  My Current Score",
    Callback = function()
        local name   = LocalPlayer.Name
        local score  = S.Scores[name]  or 0
        local st     = S.Stats[name]   or {}
        local streak = S.Streaks[name] or 0
        local tot    = (st.correct or 0) + (st.wrong or 0)
        local acc    = tot > 0 and Round((st.correct or 0)/tot*100,1) or 0
        Notify("📊 Your Score",
            ("%d pts  |  %d%% acc  |  🔥 x%d streak"):format(score, acc, streak), 5)
    end,
})

TQuiz:CreateButton({
    Name = "💡  50/50 Hint  (removes 2 wrong options)",
    Callback = function()
        if not S.Active then Notify("⚠️ No Quiz", "No quiz running.", 2) ; return end
        local q = S.Questions[S.Current]
        if not q then return end
        local wrongs = {}
        for _, k in ipairs({"A","B","C","D"}) do
            if k ~= q.ans then table.insert(wrongs, k) end
        end
        -- Fisher-Yates shuffle and pick 2 to eliminate
        for i = #wrongs, 2, -1 do
            local j = math.random(i)
            wrongs[i], wrongs[j] = wrongs[j], wrongs[i]
        end
        local e1, e2 = wrongs[1], wrongs[2]
        Log(("50/50: eliminated %s and %s"):format(e1, e2), "info")
        Notify("💡 50/50 Hint",
            ("Options %s and %s have been eliminated.\nChoose between the remaining two!"):format(e1, e2), 7)
    end,
})

