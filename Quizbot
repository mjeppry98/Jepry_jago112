local function StopTimer()
    if S.TimerThread then
        pcall(task.cancel, S.TimerThread)
        S.TimerThread = nil
    end
end

local function MakeTimerBar(left, total)
    local pct    = math.max(left / total, 0)
    local barLen = 18
    local filled = math.floor(pct * barLen)
    local bar    = string.rep("█", filled) .. string.rep("░", barLen - filled)
    local icon   = left > CFG.TimerWarningAt and "🟢" or (left > 5 and "🟡" or "🔴")
    return ("%s [%s] %ds"):format(icon, bar, left)
end

local function StartTimer(seconds, onExpire)
    StopTimer()
    S.TimeLeft    = seconds
    S.TimerThread = task.spawn(function()
        while S.TimeLeft > 0 do
            task.wait(1)
            S.TimeLeft = S.TimeLeft - 1
            SP(R.Timer, "⏱️ Time Remaining", MakeTimerBar(S.TimeLeft, seconds))
        end
        SP(R.Timer, "⏱️ Time Remaining", "🔴 [░░░░░░░░░░░░░░░░░░] 0s  —  ⏰ Time's up!")
        onExpire()
    end)
end

-- ================================================================
--  QUIZ ENGINE
-- ================================================================
local function ShowQuestion()
    if not S.Active then return end
    local q = S.Questions[S.Current]
    if not q then return end

    S.Locked   = false
    S.Answered = {}

    local qtext = ("❓  Question %d of %d\n\n%s\n\nA)  %s\nB)  %s\nC)  %s\nD)  %s"):format(
        S.Current, #S.Questions, q.q, q.a, q.b, q.c, q.d)

    SP(R.Question, "❓ Question", qtext)
    SP(R.Status,   "📊 Status",  ("🟢 Active  │  %s  │  %s  │  Q%d/%d"):format(
        S.Category, S.Difficulty, S.Current, #S.Questions))
    SP(R.Timer, "⏱️ Time Remaining", MakeTimerBar(CFG.TimePerQuestion, CFG.TimePerQuestion))

    Log(("Q%d: %s"):format(S.Current, q.q:sub(1, 70)), "info")

    StartTimer(CFG.TimePerQuestion, function()
        if not S.Active then return end
        -- Reveal answer if configured
        if CFG.ShowAnswerOnTimeout then
            local cq = S.Questions[S.Current]
            if cq then
                SP(R.Question, "❓ Question",
                    qtext.."\n\n⏰ Time's up!\nCorrect answer: "..cq.ans..") "..GetAnswerText(cq, cq.ans))
            end
        end
        Log(("Q%d timed out."):format(S.Current), "warn")
        Notify("⏰ Time's Up!", "No more answers for this question.", 3)
        task.delay(2, NextQuestion)
    end)
end

function NextQuestion()
    StopTimer()
    S.Current  = S.Current + 1
    S.Answered = {}
    S.Locked   = false

    if S.Current > #S.Questions then
        S.Active = false
        S.Locked = true
        Log("Quiz complete!", "success")
        RefreshLeader()
        RefreshStats()
        SP(R.Status,   "📊 Status",   "✅  Quiz complete! See Leaderboard & Stats tabs.")
        SP(R.Question, "❓ Question", "🎉 All done!\n\nCheck Leaderboard & Stats tabs for results.\nStart a new quiz from the Setup tab.")
        SP(R.Timer,    "⏱️ Time Remaining", "✅  Quiz complete!")
        SP(R.Streak,   "🔥 Streak", "Quiz ended. Start a new one to keep your streak!")
        Notify("🏆 Quiz Complete!", "All questions answered! Check Leaderboard & Stats.", 7)
    else
        task.delay(0.5, ShowQuestion)
    end
end

local function SubmitAnswer(playerName, choice)
    if not S.Active  then Notify("⚠️ No Quiz",         "No quiz is running.", 2)         ; return end
    if S.Locked      then Notify("⏳ Wait",             "Moving to next question…", 2)    ; return end
    if S.Answered[playerName] then Notify("✋ Already Answered","Wait for next question!", 2); return end

    local q       = S.Questions[S.Current]
    local correct = (choice == q.ans)
    S.Answered[playerName] = choice

    -- Ensure stat tables exist
    if not S.Stats[playerName]  then S.Stats[playerName]  = { correct=0, wrong=0, bestStreak=0 } end
    if not S.Scores[playerName] then S.Scores[playerName] = 0 end
    if not S.Streaks[playerName]then S.Streaks[playerName]= 0 end

    local st = S.Stats[playerName]

    if correct then
        S.Streaks[playerName] = S.Streaks[playerName] + 1
        local streak = S.Streaks[playerName]
        local bonus  = math.min(streak - 1, CFG.MaxStreakBonus) * CFG.PointsStreakBonus
        local pts    = CFG.PointsCorrect + bonus
        S.Scores[playerName] = S.Scores[playerName] + pts
        st.correct    = (st.correct or 0) + 1
        st.bestStreak = math.max(st.bestStreak or 0, streak)

        local sMsg = streak > 1 and (" 🔥 x%d streak, +%d bonus!"):format(streak, bonus) or ""
        Log(("%s → %s ✅ +%d pts%s"):format(playerName, choice, pts, sMsg), "success")
        Notify("✅ Correct!", ("%s +%d pts%s"):format(playerName, pts, sMsg), 3)
    else
        S.Streaks[playerName] = 0
        st.wrong = (st.wrong or 0) + 1
        Log(("%s → %s ❌ (ans: %s)"):format(playerName, choice, q.ans), "error")
        Notify("❌ Wrong!", ("Correct: %s) %s"):format(q.ans, GetAnswerText(q, q.ans):sub(1,42)), 4)
    end

    -- Update streak display
    local sv = S.Streaks[playerName] or 0
    SP(R.Streak, "🔥 Streak",
        sv >= 2 and ("🔥 Streak x%d  %s  (+%d bonus next correct!)"):format(
            sv, string.rep("⭐", math.min(sv, 5)), math.min(sv, CFG.MaxStreakBonus) * CFG.PointsStreakBonus)
        or (sv == 1 and "🔥 Streak started! Keep going for bonus points!")
        or "No streak. Answer correctly to earn bonus points!")

    -- Auto-advance
    if CFG.AutoAdvance then
        local total = math.max(#Players:GetPlayers(), 1)
        local count = 0
        for _ in pairs(S.Answered) do count = count + 1 end
        if count >= total then
            S.Locked = true
            task.delay(2.5, NextQuestion)
        end
    end
end

