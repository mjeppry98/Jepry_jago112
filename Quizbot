local LogBuf = {}
local function Log(msg, kind)
    local icons = { info="ℹ️", success="✅", error="❌", warn="⚠️" }
    local line  = ("[%s] %s %s"):format(os.date("%H:%M:%S"), icons[kind] or "•", msg)
    table.insert(LogBuf, line)
    if #LogBuf > 100 then table.remove(LogBuf, 1) end
    if R.Log then
        pcall(function() R.Log:Set({ Title="📋 Activity Log", Content=table.concat(LogBuf,"\n") }) end)
    end
end

