local function findPianoKeys()
    local keys = {}
    local function scan(c)
        for _, o in ipairs(c:GetDescendants()) do
            if o:IsA("GuiButton") then
                if not keys[o.Name] then keys[o.Name] = o end
                local l = o.Name:lower()
                if not keys[l] then keys[l] = o end
            end
        end
    end
    pcall(scan, workspace)
    local plr = Players.LocalPlayer
    if plr then pcall(function() scan(plr:WaitForChild("PlayerGui", 5)) end) end
    return keys
end

-- ============================================================
--  🎹 KEY PRESS
-- ============================================================
local function keyDown(char)
    local kc, s = getKeyInfo(char)
    if not kc then return false end
    if s then VIM:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game) end
    VIM:SendKeyEvent(true, kc, false, game)
    return true, kc, s
end
local function keyUp(kc, s)
    if kc then VIM:SendKeyEvent(false, kc, false, game) end
    if s then VIM:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game) end
end
local function pressChord(chars, keysTable)
    local dbs, dks = {}, {}
    for _, c in ipairs(chars) do
        local btn = keysTable[c] or keysTable[c:lower()]
        if btn then
            pcall(function() btn:InputBegan(Enum.UserInputType.Touch) end)
            table.insert(dbs, btn)
        else
            local ok, kc, s = keyDown(c)
            if ok then table.insert(dks, {kc=kc, s=s}) end
        end
    end
    task.wait(0.03)
    for _, b in ipairs(dbs) do pcall(function() b:InputEnded(Enum.UserInputType.Touch) end) end
    for _, i in ipairs(dks) do keyUp(i.kc, i.s) end
end

-- ============================================================
--  📝 PARSER
-- ============================================================
local function parseSheet(text)
    local notes, i, len = {}, 1, #text
    while i <= len do
        local ch = text:sub(i, i)
        if ch == "[" then
            local e = text:find("]", i, true)
            if e then
                local g = text:sub(i+1, e-1)
                local ks = {}
                for c in g:gmatch(".") do table.insert(ks, c) end
                table.insert(notes, {type="chord", keys=ks})
                i = e + 1
            else i = i + 1 end
        elseif ch == "|" then
            table.insert(notes, {type="rest"}); i = i + 1
        elseif ch:match("%s") then i = i + 1
        else
            table.insert(notes, {type="single", keys={ch}}); i = i + 1
        end
    end
    return notes
end

