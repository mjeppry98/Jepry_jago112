UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not hotkeysEnabled then return end
    if input.KeyCode == Enum.KeyCode.F1 then
        local t = sheetInput and sheetInput.Value or ""
        if t ~= "" then playSheet(t) end
    elseif input.KeyCode == Enum.KeyCode.F2 then
        stopPlaying()
    elseif input.KeyCode == Enum.KeyCode.F3 then
        if isPaused then resumePlaying() else pausePlaying() end
    elseif input.KeyCode == Enum.KeyCode.F4 then
        local rand = DB[math.random(1, #DB)]
        loadAndPlay(rand.s, rand.n, rand.d)
    end
end)

