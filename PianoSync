-- ============================================================
--  🎼 TRANSPOSE
-- ============================================================
local chromaticOrder = {"1","2","3","4","5","6","7","8","9","0","q","w","e","r","t","y","u","i","o","p","a","s","d","f","g","h","j","k","l","z","x","c","v","b","n","m"}
local function transposeSheet(text, semitones)
    if semitones == 0 then return text end
    local map = {}
    for idx, key in ipairs(chromaticOrder) do
        local t = idx + semitones
        while t > #chromaticOrder do t = t - #chromaticOrder end
        while t < 1 do t = t + #chromaticOrder end
        map[key] = chromaticOrder[t]
    end
    return (text:gsub("%a", function(c) return map[c:lower()] or c end))
end

-- ============================================================
--  ✅ VALIDATION
-- ============================================================
local function validateSheet(text)
    local errors = {}
    local opens = 0
    for i = 1, #text do
        local c = text:sub(i, i)
        if c == "[" then opens = opens + 1
        elseif c == "]" then
            opens = opens - 1
            if opens < 0 then
                table.insert(errors, "Unexpected ']' at position " .. i)
                opens = 0
            end
        end
    end
    if opens > 0 then table.insert(errors, opens .. " unclosed '[' bracket(s)") end
    local notes = parseSheet(text)
    if #notes == 0 then table.insert(errors, "Sheet contains no playable notes") end
    return #errors == 0, errors, #notes
end

