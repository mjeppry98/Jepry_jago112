    u=Enum.KeyCode.U,v=Enum.KeyCode.V,w=Enum.KeyCode.W,x=Enum.KeyCode.X,
    y=Enum.KeyCode.Y,z=Enum.KeyCode.Z,
    ["0"]=Enum.KeyCode.Zero,["1"]=Enum.KeyCode.One,["2"]=Enum.KeyCode.Two,
    ["3"]=Enum.KeyCode.Three,["4"]=Enum.KeyCode.Four,["5"]=Enum.KeyCode.Five,
    ["6"]=Enum.KeyCode.Six,["7"]=Enum.KeyCode.Seven,["8"]=Enum.KeyCode.Eight,
    ["9"]=Enum.KeyCode.Nine,
}
local shiftMap = {
    ["!"]="1",["@"]="2",["#"]="3",["$"]="4",["%"]="5",["^"]="6",
    ["&"]="7",["*"]="8",["("]="9",[")"]="0",["_"]="-",["+"]="=",
    ["{"]="[",["}"]="]",[":"]=";",['"']="'",["<"]=",",[">"]=".",
    ["?"]="/",["~"]="`",
}
local function getKeyInfo(c)
    if shiftMap[c] then return keyCodeMap[shiftMap[c]], true end
    return keyCodeMap[c:lower()], false
end

-- ============================================================
--  PIANO KEY DISCOVERY
-- ============================================================
local function findPianoKeys()
    local keys = {}
    local function scan(c)
        for _, o in ipairs(c:GetDescendants()) do
            if o:IsA("GuiButton") then
                if not keys[o.Name] then keys[o.Name] = o end
                local l = o.Name:lower()
                if not keys[l] then keys[l] = o end
            end
        end
    end
    pcall(scan, workspace)
    local plr = Players.LocalPlayer
    if plr then pcall(function() scan(plr:WaitForChild("PlayerGui", 5)) end) end
    return keys
end

-- ============================================================
--  KEY PRESS
-- ============================================================
local function keyDown(char)
    local kc, s = getKeyInfo(char)
    if not kc then return false end
    if s then VIM:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game) end
    VIM:SendKeyEvent(true, kc, false, game)
    return true, kc, s
end
local function keyUp(kc, s)
    if kc then VIM:SendKeyEvent(false, kc, false, game) end
    if s then VIM:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game) end
end
local function pressChord(chars, keysTable)
    local dbs, dks = {}, {}
    for _, c in ipairs(chars) do
        local btn = keysTable[c] or keysTable[c:lower()]
        if btn then
            pcall(function() btn:InputBegan(Enum.UserInputType.Touch) end)
            table.insert(dbs, btn)
        else
            local ok, kc, s = keyDown(c)
            if ok then table.insert(dks, {kc=kc, s=s}) end
        end
    end
    task.wait(0.03)
    for _, b in ipairs(dbs) do pcall(function() b:InputEnded(Enum.UserInputType.Touch) end) end
    for _, i in ipairs(dks) do keyUp(i.kc, i.s) end
end

-- ============================================================
--  PARSER
-- ============================================================
local function parseSheet(text)
    local notes, i, len = {}, 1, #text
    while i <= len do
        local ch = text:sub(i, i)
        if ch == "[" then
            local e = text:find("]", i, true)
            if e then
                local g = text:sub(i+1, e-1)
                local ks = {}
                for c in g:gmatch(".") do table.insert(ks, c) end
                table.insert(notes, {type="chord", keys=ks})
                i = e + 1
            else i = i + 1 end
        elseif ch == "|" then
            table.insert(notes, {type="rest"}); i = i + 1
        elseif ch:match("%s") then i = i + 1
        else
            table.insert(notes, {type="single", keys={ch}}); i = i + 1
        end
    end
    return notes
end

-- ============================================================
--  PLAYER
-- ============================================================
local function stopPlaying()
    if not isPlaying then return end
    isPlaying = false
    if playThread then pcall(task.cancel, playThread); playThread = nil end
end
local function playSheet(text)
    stopPlaying()
    task.wait(0.1)
    local notes = parseSheet(text)
    if #notes == 0 then
        Window:Notify({title="PianoSync", content="Sheet is empty!"})
        return
    end
    cachedKeys = findPianoKeys()
    local total = 0
    for _ in pairs(cachedKeys) do total = total + 1 end
    if total == 0 then
        Window:Notify({title="PianoSync", content="No piano keys found. Click 'Refresh Keys'."})
        return
    end
    isPlaying = true
    playThread = task.spawn(function()
        for _, n in ipairs(notes) do
            if not isPlaying then break end
            if n.type == "chord" or n.type == "single" then
                pressChord(n.keys, cachedKeys); task.wait(currentSpeed)
            elseif n.type == "rest" then
                task.wait(currentSpeed * restMult)
            end
        end
        isPlaying = false
        Window:Notify({title="PianoSync", content="Finished: "..#notes.." notes."})
    end)
end

