    {name = "Advanced Difficulty Only", match = nil, filter = function(s) return s.d == "Advanced" end},
    {name = "Beginner Friendly",        match = nil, filter = function(s) return s.d == "Beginner" or s.d == "Easy" end},
}

for _, cat in ipairs(categories) do
    LibraryTab:CreateButton({
        name = cat.name,
        callback = function()
            filtered = {}
            for _, s in ipairs(DB) do
                local ok = false
                if cat.match and s.n:find(cat.match) then ok = true end
                if cat.filter and cat.filter(s) then ok = true end
                if ok then table.insert(filtered, s) end
            end
            currentPage = 1
            renderPage(filtered, cat.name)
        end,
    })
end

