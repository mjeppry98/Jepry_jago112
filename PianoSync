-- ============================================================
--  🎬 ADVANCED PLAYBACK ENGINE
-- ============================================================
local function stopPlaying()
    if not isPlaying then return end
    isPlaying = false
    isPaused = false
    if playThread then pcall(task.cancel, playThread); playThread = nil end
    if pauseSignal then pauseSignal:Fire(); pauseSignal = nil end
end
local function pausePlaying()
    if not isPlaying or isPaused then return end
    isPaused = true
    Window:Notify({ title = "⏸️ Paused", content = "Click Resume to continue.", duration = 2 })
end
local function resumePlaying()
    if not isPlaying or not isPaused then return end
    isPaused = false
    if pauseSignal then pauseSignal:Fire(); pauseSignal = nil end
    Window:Notify({ title = "▶️ Resumed", content = "Playback resumed.", duration = 2 })
end
local function waitWhilePaused()
    while isPaused and isPlaying do
        local sig = Instance.new("BindableEvent")
        pauseSignal = sig
        sig.Event:Wait()
        task.wait(0.05)
    end
end

local function playSheet(text)
    stopPlaying()
    task.wait(0.1)
    local transposed = transposeSheet(text, transposeSemitones)
    local notes = parseSheet(transposed)
    if #notes == 0 then
        Window:Notify({ title = "⚠️ PianoSync", content = "Sheet is empty!", duration = 3 })
        return
    end
    cachedKeys = findPianoKeys()
    local total = 0
    for _ in pairs(cachedKeys) do total = total + 1 end
    if total == 0 then
        Window:Notify({ title = "🚫 PianoSync", content = "No piano keys found!", duration = 4 })
        return
    end

    isPlaying = true
    isPaused = false
    stats.played = stats.played + 1
    stats.totalNotes = stats.totalNotes + #notes
    playbackState.currentIndex = 0
    playbackState.totalNotes = #notes
    playbackState.loopCount = 0
    playbackState.startTime = tick()

    playThread = task.spawn(function()
        if showCountdown then
            for i = 3, 1, -1 do
                if not isPlaying then return end
                Window:Notify({ title = "🎬 Starting in " .. i, content = "Get ready!", duration = 1 })
                task.wait(1)
            end
        end

        local loopMax = (loopMode == "infinite") and math.huge
            or (loopMode == "2x") and 2
            or (loopMode == "3x") and 3
            or 1

        while playbackState.loopCount < loopMax and isPlaying do
            playbackState.loopCount = playbackState.loopCount + 1

            for i, n in ipairs(notes) do
                if not isPlaying then break end
                waitWhilePaused()
                if not isPlaying then break end
                playbackState.currentIndex = i

                if n.type == "chord" or n.type == "single" then
                    pressChord(n.keys, cachedKeys)
                    task.wait(currentSpeed)
                elseif n.type == "rest" then
                    task.wait(currentSpeed * restMult)
                end

                if progressNotify and i % 25 == 0 then
                    local pct = math.floor((i / #notes) * 100)
                    Window:Notify({
                        title = "🎵 Progress " .. pct .. "%",
                        content = "Note " .. i .. "/" .. #notes,
                        duration = 1.5,
                    })
                end
            end

            if loopMode ~= "once" and isPlaying and playbackState.loopCount < loopMax then
                Window:Notify({
                    title = "🔁 Loop " .. playbackState.loopCount,
                    content = "Replaying...",
                    duration = 2,
                })
                task.wait(0.5)
            end
        end

        local totalTime = tick() - playbackState.startTime
        isPlaying = false
        Window:Notify({
            title = "✅ Finished",
            content = "🎼 " .. #notes .. " notes   •   🔁 " .. playbackState.loopCount ..
                      " loop(s)   •   ⏱️ " .. string.format("%.1f", totalTime) .. "s",
            duration = 4,
        })

        if currentSheetInfo.sheet ~= "" then
            table.insert(SongHistory, 1, {
                name = currentSheetInfo.name,
                sheet = currentSheetInfo.sheet,
                d = currentSheetInfo.d,
                time = os.time(),
            })
            if #SongHistory > 20 then table.remove(SongHistory, 21) end
            saveHistory()
        end
    end)
end

