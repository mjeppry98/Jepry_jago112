    placeholderText = "Paste sheet here or pick a song from the Library tab",
    removeTextAfterFocusLost = false,
    callback = function() end,
})

PlayTab:CreateSlider({
    name = "Playback Speed (seconds per note)",
    range = { 0.03, 1.0 }, increment = 0.01, currentValue = 0.15, suffix = "s",
    callback = function(v) currentSpeed = v end,
})

PlayTab:CreateSlider({
    name = "Rest Duration Multiplier",
    range = { 0.5, 5.0 }, increment = 0.1, currentValue = 2.0, suffix = "x",
    callback = function(v) restMult = v end,
})

PlayTab:CreateButton({
    name = "Play",
    callback = function()
        local t = sheetInput.Value or ""
        if t == "" then
            Window:Notify({title="PianoSync", content="Please paste a sheet first!"})
            return
        end
        playSheet(t)
    end,
})

PlayTab:CreateButton({
    name = "Stop",
    callback = function()
        stopPlaying()
        Window:Notify({title="PianoSync", content="Playback stopped."})
    end,
})

PlayTab:CreateButton({
    name = "Refresh Piano Keys",
    callback = function()
        cachedKeys = findPianoKeys()
        local c = 0
        for _ in pairs(cachedKeys) do c = c + 1 end
        Window:Notify({title="PianoSync", content="Found "..c.." piano keys."})
    end,
})

