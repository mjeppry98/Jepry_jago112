    {name = "Pop & Modern Hits",        match = "BTS|BLACKPINK|TWICE|aespa|NewJeans|Adele|Ed Sheeran|Weeknd|Dua Lipa|Queen|AC/DC|MJ"},
    {name = "Memes & Viral",            match = "Meme|Skibidi|Rizz|Rickroll|Baby Shark|Nyan|Crab|Among|Sigma|Ohio|Poggers"},
