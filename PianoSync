-- ============================================================
--  UI — LIBRARY TAB (English)
-- ============================================================
local sheetInput
local allButtons = {}
local filtered = DB
local itemsPerPage = 30
local currentPage = 1

local function loadAndPlay(sheetText, songName)
    if sheetInput then sheetInput:Set(sheetText) end
    Window:Notify({ title = "PianoSync", content = "Now playing: " .. songName, duration = 3 })
    playSheet(sheetText)
end

local function clearList()
    for _, b in ipairs(allButtons) do pcall(function() b:Destroy() end) end
    allButtons = {}
end

local function renderPage(list, headerText)
    clearList()
    local totalPages = math.max(1, math.ceil(#list / itemsPerPage))
    if currentPage > totalPages then currentPage = totalPages end
    local startIdx = (currentPage - 1) * itemsPerPage + 1
    local endIdx   = math.min(startIdx + itemsPerPage - 1, #list)

    LibraryTab:CreateSection({ name = headerText .. "  [Page " .. currentPage .. "/" .. totalPages .. "]  (" .. #list .. " songs total)" })

    if #list == 0 then
        local btn = LibraryTab:CreateButton({ name = "No results found. Try a different keyword.", callback = function() end })
        table.insert(allButtons, btn)
        return
    end

    for i = startIdx, endIdx do
        local song = list[i]
        local btn = LibraryTab:CreateButton({
            name = "[" .. song.d .. "]  " .. song.n,
            callback = function() loadAndPlay(song.s, song.n) end,
        })
        table.insert(allButtons, btn)
    end

    -- Pagination controls
    local prevBtn = LibraryTab:CreateButton({
        name = "<< Previous Page",
        callback = function()
            if currentPage > 1 then currentPage = currentPage - 1 end
            renderPage(filtered, "Sheet Library")
        end,
    })
    local nextBtn = LibraryTab:CreateButton({
        name = "Next Page >>",
        callback = function()
            if currentPage < totalPages then currentPage = currentPage + 1 end
            renderPage(filtered, "Sheet Library")
        end,
    })
    table.insert(allButtons, prevBtn)
    table.insert(allButtons, nextBtn)
end

