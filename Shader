function UI.ripple(host, input)
	if Store:Get("reduced") then return end
	local ap, as = host.AbsolutePosition, host.AbsoluteSize
	if as.X < 1 or as.Y < 1 then return end
	local fx, fy = 0.5, 0.5
	if input then
		-- [FIX] GuiService:GetGuiInset bisa error di beberapa executor
		local inset = Vector2.zero
		pcall(function() inset = GuiService:GetGuiInset() end)
		fx = math.clamp((input.Position.X - ap.X) / as.X, 0, 1)
		fy = math.clamp((input.Position.Y + inset.Y - ap.Y) / as.Y, 0, 1)
	end
	local r = Util.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(fx, fy), Size = UDim2.fromScale(0, 0),
		BackgroundColor3 = C.lavender, BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 1,
	}, host)
	Util.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, r)
	Animate.tween(r, { Size = UDim2.fromScale(2.4, 2.4), BackgroundTransparency = 1 }, 0.55, "Quint").Completed:Once(function()
		r:Destroy()
	end)
end

function UI.bind(btn, o)
	o = o or {}
	local target = o.target or btn
	local sc = (not o.noScale) and Util.new("UIScale", { Scale = 1 }, target) or nil
	local st = o.stroke
	local baseTh, baseTr = st and st.Thickness or 0, st and st.Transparency or 0
	local inside = false
	btn.MouseEnter:Connect(function()
		inside = true
		Sound.play("hover")
		Util.cursor(true)
		if sc then Animate.tween(sc, { Scale = 1.04 }, 0.18, "Quint") end
		if st then Animate.tween(st, { Thickness = baseTh + 1.5, Transparency = math.max(0, baseTr - 0.3) }, 0.18, "Sine") end
	end)
	btn.MouseLeave:Connect(function()
		if inside then Util.cursor(false) end
		inside = false
		if sc then Animate.tween(sc, { Scale = 1 }, 0.22, "Quint") end
		if st then Animate.tween(st, { Thickness = baseTh, Transparency = baseTr }, 0.22, "Sine") end
	end)
	btn.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			if sc then Animate.tween(sc, { Scale = 0.96 }, 0.08, "Sine") end
			UI.ripple(target, i)
		end
	end)
	btn.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			if sc then Animate.tween(sc, { Scale = inside and 1.04 or 1 }, 0.25, "Quint") end
		end
	end)
	if not o.noActivate then
		btn.Activated:Connect(function()
			Sound.play("click")
			if o.onClick then o.onClick() end
		end)
	end
end

