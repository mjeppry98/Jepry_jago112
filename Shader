function UI.refreshCards()
	local act = Store:Get("shader")
	for n, c in pairs(UI.cards) do
		local on = act == n
		if c.switch.on ~= on then c.switch.set(on, true) end
		Animate.tween(c.stroke, {
			Color = on and C.magenta or C.electric,
			Thickness = on and 2 or 1,
			Transparency = on and 0.1 or 0.55
		}, 0.3, "Sine")
	end
	if UI.status then
		UI.status.Text = act and ("> " .. string.upper(act) .. " ACTIVE") or "> IDLE"
	end
end

function UI.setOpen(on)
	if Store:Get("open") == on or not UI.holder then return end
	Store:Set("open", on)
	local h = UI.holder
	Sound.play(on and "open" or "close")
	Animate.tween(UI.tCorner, { CornerRadius = UDim.new(0, on and 12 or Config.ToggleSize / 2) }, 0.4, "Quint")
	Animate.tween(UI.tGlowCorner, { CornerRadius = UDim.new(0, on and 16 or (Config.ToggleSize + 18) / 2) }, 0.4, "Quint")
	Animate.tween(UI.tIcon, { Rotation = on and 45 or 0 }, 0.45, "Expo")
	if on then
		h.Visible = true
		local final = Vector2.new(h.Position.X.Offset, h.Position.Y.Offset)
		local tpos = Vector2.new(UI.tHolder.Position.X.Offset, UI.tHolder.Position.Y.Offset)
		local dir = tpos - final
		dir = dir.Magnitude > 1 and dir.Unit * 60 or Vector2.zero
		h.Position = UDim2.fromOffset(final.X + dir.X, final.Y + dir.Y)
		UI.scale.Scale = UI.base * 0.7
		UI.panel.GroupTransparency, UI.under.GroupTransparency = 1, 1
		Animate.tween(h, { Position = UDim2.fromOffset(final.X, final.Y) }, 0.5, "Quint")
		Animate.tween(UI.scale, { Scale = UI.base }, 0.5, "Expo")
		Animate.tween(UI.panel, { GroupTransparency = 0 }, 0.35, "Sine")
		Animate.tween(UI.under, { GroupTransparency = 0 }, 0.45, "Sine")
	else
		Animate.tween(UI.scale, { Scale = UI.base * 0.8 }, 0.3, "Quint", Enum.EasingDirection.In)
		Animate.tween(UI.panel, { GroupTransparency = 1 }, 0.28, "Sine")
		Animate.tween(UI.under, { GroupTransparency = 1 }, 0.28, "Sine")
		task.delay(0.32, function()
			if not Store:Get("open") and h.Parent then h.Visible = false end
		end)
	end
end

function UI.setCollapsed(on)
	Store:Set("collapsed", on)
	Sound.play(on and "close" or "open")
	Animate.tween(UI.holder, { Size = UDim2.fromOffset(W, on and HEADER or H) }, 0.4, "Quint")
	UI.minBtn.Text = on and "+" or "-"
	local cur = Vector2.new(UI.holder.Position.X.Offset, UI.holder.Position.Y.Offset)
	local c = Drag.clamp(cur, UI.panelSize())
	if (c - cur).Magnitude > 0.5 then
		Animate.tween(UI.holder, { Position = UDim2.fromOffset(c.X, c.Y) }, 0.4, "Quint")
	end
end

function UI.placeAll()
	if not UI.holder then return end
	local vp, S = UI.viewport(), Config.ToggleSize
	local pc = Pos.panel and Vector2.new(Pos.panel.x * vp.X, Pos.panel.y * vp.Y) or vp / 2
	pc = Drag.clamp(pc, UI.panelSize())
	UI.holder.Position = UDim2.fromOffset(pc.X, pc.Y)
	local tc = Pos.toggle and Vector2.new(Pos.toggle.x * vp.X, Pos.toggle.y * vp.Y)
		or Vector2.new(vp.X - (S / 2 + 16), vp.Y * 0.42)
	tc = Drag.clamp(tc, Vector2.new(S, S))
	UI.tHolder.Position = UDim2.fromOffset(tc.X, tc.Y)
end

function UI.relayout()
	if not UI.holder then return end
	local vp = UI.viewport()
	UI.base = math.clamp(math.min((vp.X - 16) / W, (vp.Y - 16) / H), 0.45, 1)
	if Store:Get("open") and UI.scale then UI.scale.Scale = UI.base end
	-- [FIX] guard hostScale
	if UI.hostScale then
		local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
		UI.hostScale.Scale = mobile and 0.85 or math.min(1, vp.X / 700)
	end
	UI.placeAll()
	local activeP = Shader.active and Shader.byName[Shader.active]
	if UI.lbTop and activeP and activeP.letterbox then UI.setLetterbox(true) end
end

function UI.destroy()
	UiC.run()
	UI.gui, UI.holder = nil, nil
	table.clear(UI.sliders)
	table.clear(UI.cards)
	table.clear(UI.pages)
	table.clear(UI.tabs)
	UI.tab, UI.activeSlider = nil, nil
end

