function UI.switch(parent, default, onToggle)
	local hit = Util.new("TextButton", {
		BackgroundTransparency = 1, Text = "", Size = UDim2.fromOffset(44, 44), AutoButtonColor = false,
	}, parent)
	local track = Util.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(40, 22), BackgroundColor3 = default and C.electric or C.midnight, BorderSizePixel = 0,
	}, hit)
	corner(track, 11)
	local st = stroke(track, 1.5, default and C.magenta or C.electric, 0.3)
	local knob = Util.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = default and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16), BackgroundColor3 = default and C.magenta or C.lavender, BorderSizePixel = 0,
	}, track)
	corner(knob, 8)
	local api = { on = default, hit = hit }
	function api.set(on, silent)
		api.on = on
		Animate.tween(knob, {
			Position = on and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = on and C.magenta or C.lavender
		}, 0.25, "Quint")
		Animate.tween(track, { BackgroundColor3 = on and C.electric or C.midnight }, 0.25, "Sine")
		Animate.tween(st, { Color = on and C.magenta or C.electric }, 0.25, "Sine")
		if not silent and onToggle then onToggle(on) end
	end
	hit.Activated:Connect(function()
		Sound.play(api.on and "toggleOff" or "toggleOn")
		api.set(not api.on)
	end)
	hit.MouseEnter:Connect(function() Sound.play("hover") Util.cursor(true) end)
	hit.MouseLeave:Connect(function() Util.cursor(false) end)
	return api
end

