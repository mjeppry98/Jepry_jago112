	local lastSfx = 0
	function api.set(v, fire, instant)
		v = math.clamp(math.floor(v / o.step + 0.5) * o.step, o.min, o.max)
		local a = (v - o.min) / (o.max - o.min)
		val.Text = string.format("%." .. o.dec .. "f", v)
		if instant then
			fill.Size, knob.Position = UDim2.fromScale(a, 1), UDim2.fromScale(a, 0.5)
		else
			Animate.tween(fill, { Size = UDim2.fromScale(a, 1) }, 0.12, "Sine")
			Animate.tween(knob, { Position = UDim2.fromScale(a, 0.5) }, 0.12, "Sine")
		end
		if fire then
			if Store:Get(o.key) ~= v and os.clock() - lastSfx > 0.06 then
				lastSfx = os.clock() Sound.play("slider")
			end
			Store:Set(o.key, v)
			Shader.requestRefresh()
		end
	end
	local function fromInput(input)
		local a = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		api.set(o.min + (o.max - o.min) * a, true, true)
	end
	hit.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			UI.activeSlider = { input = input, update = fromInput, finish = function()
				UI.activeSlider = nil
				if o.scroller then o.scroller.ScrollingEnabled = true end
				Animate.tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.15, "Quint")
			end }
			if o.scroller then o.scroller.ScrollingEnabled = false end
			Animate.tween(knob, { Size = UDim2.fromOffset(20, 20) }, 0.15, "Quint")
			fromInput(input)
		end
	end)
	hit.MouseEnter:Connect(function() Util.cursor(true) end)
	hit.MouseLeave:Connect(function() Util.cursor(false) end)
	api.set(Store:Get(o.key), false, true)
	UI.sliders[o.key] = api
	return api
end

function UI.notify(title, msg, kind)
	local host = UI.toastHost
	if not host or not host.Parent then return end
	if kind ~= "error" and not Store:Get("toasts") then return end
	local kids = host:GetChildren()
	local count = 0
	for _, k in ipairs(kids) do if k:IsA("Frame") then count += 1 end end
	if count >= 4 then
		for _, k in ipairs(kids) do if k:IsA("Frame") then k:Destroy() break end end
	end
	local accent = kind == "error" and C.danger or (kind == "success" and C.lavender or C.magenta)
	UI.toastId = (UI.toastId or 0) + 1
	local wrap = Util.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = UI.toastId }, host)
	local toast = Util.new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1), Position = UDim2.new(1.2, 0, 0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, wrap)
	corner(toast, 10)
	grad(toast, { C.deep, C.midnight, C.indigo }, 0)
	local bar = Util.new("Frame", { Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = accent, BorderSizePixel = 0 }, toast)
	local t = label(toast, string.upper(title), 12, accent, Enum.Font.GothamBold)
	t.Position, t.Size = UDim2.new(0, 14, 0, 8), UDim2.new(1, -22, 0, 16)
	local m = label(toast, msg, 12, C.text, Enum.Font.Gotham)
	m.Position, m.Size = UDim2.new(0, 14, 0, 28), UDim2.new(1, -22, 0, 18)
	m.TextTruncate = Enum.TextTruncate.AtEnd
	toast.Parent = wrap
	local st = stroke(wrap, 1, accent, 0.5)
	st.Enabled = false
	Animate.tween(toast, { Position = UDim2.new(0, 0, 0, 0) }, 0.45, "Expo")
	Sound.play(kind == "error" and "error" or "notify")
	task.delay(3, function()
		if not toast.Parent then return end
		Animate.tween(toast, { Position = UDim2.new(1.2, 0, 0, 0), GroupTransparency = 1 }, 0.4, "Quint", Enum.EasingDirection.In)
		task.delay(0.45, function() if wrap.Parent then wrap:Destroy() end end)
	end)
end

function UI.setLetterbox(on)
	local top, bot = UI.lbTop, UI.lbBot
	if not top or not top.Parent then return end
	local vp = UI.viewport()
	local h = on and math.floor(vp.Y * 0.1) or 0
	Animate.tween(top, { Size = UDim2.new(1, 0, 0, h) }, 0.6, "Quint")
	Animate.tween(bot, { Size = UDim2.new(1, 0, 0, h) }, 0.6, "Quint")
end

function UI.setTab(name, silent)
	if UI.tab == name then return end
	local oldName = UI.tab
	UI.tab = name
	local old, new = UI.pages[oldName], UI.pages[name]
	if old then
		Animate.tween(old, { GroupTransparency = 1 }, 0.18, "Sine")
		task.delay(0.2, function() if UI.tab ~= oldName and old.Parent then old.Visible = false end end)
	end
	new.Visible = true
	new.GroupTransparency = old and 1 or 0
	if old then Animate.tween(new, { GroupTransparency = 0 }, 0.3, "Quint") end
	for n, t in pairs(UI.tabs) do
		Animate.tween(t.btn, { TextColor3 = n == name and C.text or C.sub }, 0.2, "Sine")
	end
	Animate.tween(UI.indicator, { Position = UDim2.new(0, 2, 0, UI.tabs[name].cy) }, 0.35, "Expo")
	if not silent then Sound.play("click") end
end

