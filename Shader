local LMAP = {
	{ "Ambient", "amb", "c" }, { "OutdoorAmbient", "out", "c" }, { "Brightness", "br", "n" }, { "ClockTime", "clock", "n" },
	{ "ColorShift_Top", "top", "c" }, { "ColorShift_Bottom", "bot", "c" }, { "EnvironmentDiffuseScale", "diff", "n" },
	{ "EnvironmentSpecularScale", "spec", "n" }, { "FogColor", "fog", "c" }, { "FogStart", "fs", "n" }, { "FogEnd", "fe", "n" },
}

Shader.list, Shader.byName, Shader.fx, Shader.stash = {}, {}, {}, {}
Shader.active, Shader.orig, Shader.lastTarget = nil, nil, nil
Shader.transitionUntil, Shader.restoreUntil, Shader.scanOn = 0, 0, false

function Shader.compile()
	for _, r in ipairs(RAW) do
		local p = {}
		for k, v in pairs(BASE) do p[k] = v end
		for k, v in pairs(r) do p[k] = v end
		for _, ck in ipairs(COLOR_KEYS) do p[ck] = hex(p[ck]) end
		for i, t in ipairs(p.thumb) do p.thumb[i] = hex(t) end
		table.insert(Shader.list, p)
		Shader.byName[p.name] = p
	end
end

function Shader.snapshot()
	local o = {}
	for _, m in ipairs(LMAP) do
		local ok, v = pcall(function() return Lighting[m[1]] end)
		if ok then o[m[1]] = v end
	end
	pcall(function() o.GlobalShadows = Lighting.GlobalShadows end)
	Shader.orig = o
end

function Shader.ensureFx()
	local fx = Shader.fx
	local function mk(class, key, props)
		local e = fx[key]
		if e and e.Parent == Lighting then return end
		if e then pcall(e.Destroy, e) end
		for _, c in ipairs(Lighting:GetChildren()) do
			if c.Name == "NeonSuite_" .. key then pcall(c.Destroy, c) end
		end
		e = Instance.new(class)
		e.Name = "NeonSuite_" .. key
		for k, v in pairs(props) do pcall(function() e[k] = v end) end
		e.Parent = Lighting
		fx[key] = e
	end
	mk("ColorCorrectionEffect", "CC", { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = Color3.new(1, 1, 1) })
	mk("BloomEffect", "Bloom", { Intensity = 0, Size = 24, Threshold = 2 })
	mk("BlurEffect", "Blur", { Size = 0 })
	mk("DepthOfFieldEffect", "DOF", { FarIntensity = 0, FocusDistance = 50, InFocusRadius = 30, NearIntensity = 0 })
	mk("SunRaysEffect", "Rays", { Intensity = 0, Spread = 0.2 })
	mk("Atmosphere", "Atmo", { Density = 0, Offset = 0, Color = Color3.fromRGB(199, 199, 199), Decay = Color3.fromRGB(106, 106, 106), Glare = 0, Haze = 0 })
end

function Shader.stashAtmo()
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("Atmosphere") and c ~= Shader.fx.Atmo and c.Name ~= "NeonSuite_Atmo" then
			table.insert(Shader.stash, c)
			pcall(function() c.Parent = nil end)
		end
	end
end
function Shader.restoreAtmo()
	for _, c in ipairs(Shader.stash) do pcall(function() c.Parent = Lighting end) end
	table.clear(Shader.stash)
end
function Shader.destroyFx()
	for k, e in pairs(Shader.fx) do
		pcall(e.Destroy, e)
		Shader.fx[k] = nil
	end
	for _, c in ipairs(Lighting:GetChildren()) do
		if string.sub(c.Name, 1, 10) == "NeonSuite_" then pcall(c.Destroy, c) end
	end
end

local function neutralFx()
	return {
		CC = { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = Color3.new(1, 1, 1) },
		Bloom = { Intensity = 0 }, Blur = { Size = 0 }, DOF = { FarIntensity = 0, NearIntensity = 0 },
		Rays = { Intensity = 0 }, Atmo = { Density = 0, Glare = 0, Haze = 0 },
	}
end

function Shader.target(p)
	local o, S = Shader.orig, Store
	local k = S:Get("intensity")
	local kc = math.clamp(k, 0, 1)
	local L = {}
	for _, m in ipairs(LMAP) do
		local prop, key, kind = m[1], m[2], m[3]
		local ov = o[prop]
		if ov ~= nil then
			if p.useOrig then L[prop] = ov
			elseif kind == "c" then L[prop] = ov:Lerp(p[key], kc)
			else L[prop] = Util.lerp(ov, p[key], kc) end
		end
	end
	local fx = {
		CC = {
			Brightness = p.ccB * k + S:Get("brightness"), Contrast = p.ccC * k + S:Get("contrast"),
			Saturation = p.ccS * k + S:Get("saturation"), TintColor = Color3.new(1, 1, 1):Lerp(p.tint, kc),
		},
		Bloom = { Intensity = math.max(0, p.bl * k * S:Get("bloom")), Size = p.bs, Threshold = p.bt },
		Blur = { Size = math.max(0, p.blur * k + S:Get("blur")) },
		DOF = { FarIntensity = p.dofF * kc, FocusDistance = p.dofD, InFocusRadius = p.dofR, NearIntensity = p.dofN * kc },
		Rays = { Intensity = math.clamp(p.ray * k, 0, 1), Spread = p.rsp },
		Atmo = {
			Density = math.clamp(p.ad * k, 0, 1), Offset = p.ao, Color = p.ac, Decay = p.adc,
			Glare = math.max(0, p.ag * k), Haze = math.max(0, p.ah * k),
		},
	}
	return { L = L, fx = fx }
end

function Shader.tweenTo(T, dur)
	for prop, val in pairs(T.L) do
		pcall(function() Animate.tween(Lighting, { [prop] = val }, dur, "Sine") end)
	end
	for key, props in pairs(T.fx) do
		local e = Shader.fx[key]
		if e then pcall(function() Animate.tween(e, props, dur, "Sine") end) end
	end
end

function Shader.apply(name, quiet, dur)
	local p = Shader.byName[name]
	if not p then return end
	dur = dur or 0.4
	if not Shader.orig or (not Shader.active and os.clock() > Shader.restoreUntil) then Shader.snapshot() end
	Shader.ensureFx()
	Shader.stashAtmo()
	Shader.active = name
	local T = Shader.target(p)
	Shader.lastTarget = T
	Shader.transitionUntil = os.clock() + dur + 0.1
	Shader.tweenTo(T, dur)
	pcall(function() Lighting.GlobalShadows = p.sh end)
	UI.setLetterbox(p.letterbox == true)
	Shader.scanOn = p.scan == true
	Store:Set("shader", name)
	if not quiet then
		Sound.play("shaderApply")
		UI.notify("Shader applied", name, "success")
	end
end

function Shader.requestRefresh()
	if Shader.refreshPending then return end
	Shader.refreshPending = true
	task.delay(0.07, function()
		Shader.refreshPending = false
		if Shader.active and not NeonSuite._unloading then Shader.apply(Shader.active, true, 0.15) end
	end)
end

function Shader.disable(quiet)
	if not Shader.active then return end
	Shader.active, Shader.lastTarget, Shader.scanOn = nil, nil, false
	local o, dur = Shader.orig or {}, 0.4
	Shader.restoreUntil = os.clock() + dur + 0.1
	for prop, val in pairs(o) do
		if prop ~= "GlobalShadows" then pcall(function() Animate.tween(Lighting, { [prop] = val }, dur, "Sine") end) end
	end
	pcall(function() if o.GlobalShadows ~= nil then Lighting.GlobalShadows = o.GlobalShadows end end)
	for key, props in pairs(neutralFx()) do
		local e = Shader.fx[key]
		if e then pcall(function() Animate.tween(e, props, dur, "Sine") end) end
	end
	UI.setLetterbox(false)
	Store:Set("shader", false)
	task.delay(dur + 0.05, function()
		if not Shader.active then
			Shader.destroyFx()
			Shader.restoreAtmo()
		end
	end)
	if not quiet then
		Sound.play("toggleOff")
		UI.notify("Shader off", "Lighting restored", "info")
	end
end

function Shader.restoreImmediate()
	local o = Shader.orig
	if o then
		for prop, val in pairs(o) do pcall(function() Lighting[prop] = val end) end
	end
	Shader.destroyFx()
	Shader.restoreAtmo()
	Shader.active = nil
end

function Shader.init()
	Shader.compile()
	Shader.snapshot()
	for _, c in ipairs(Lighting:GetChildren()) do
		if string.sub(c.Name, 1, 10) == "NeonSuite_" then pcall(c.Destroy, c) end
	end
end

local function differs(a, b)
	if typeof(a) == "Color3" then return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) > 0.03 end
	if type(a) == "number" then return math.abs(a - b) > math.max(0.02, math.abs(b) * 0.02) end
	return a ~= b
end
function Shader.watch()
	if not Shader.active or os.clock() < Shader.transitionUntil then return end
	Shader.ensureFx()
	Shader.stashAtmo()
	local T = Shader.lastTarget
	if not T then return end
	for prop, val in pairs(T.L) do
		local ok, cur = pcall(function() return Lighting[prop] end)
		if ok and differs(cur, val) then pcall(function() Lighting[prop] = val end) end
	end
	for key, props in pairs(T.fx) do
		local e = Shader.fx[key]
		if e then
			for prop, val in pairs(props) do
				local ok, cur = pcall(function() return e[prop] end)
				if ok and differs(cur, val) then pcall(function() e[prop] = val end) end
			end
		end
	end
	-- [FIX] sebelumnya `p.GlobalShadows` (selalu nil). Sekarang pakai `p.sh`.
	local p = Shader.byName[Shader.active]
	if p and p.sh ~= nil then pcall(function() Lighting.GlobalShadows = p.sh end) end
end

function Shader.aurora(t)
	local p = Shader.active and Shader.byName[Shader.active]
	if not p or not p.aurora or os.clock() < Shader.transitionUntil or not Shader.lastTarget then return end
	local kc = math.clamp(Store:Get("intensity"), 0, 1)
	local h = 0.45 + 0.25 * (0.5 + 0.5 * math.sin(t * 0.35))
	local a, b = Color3.fromHSV(h, 0.7, 1), Color3.fromHSV((h + 0.2) % 1, 0.7, 0.9)
	local o, L = Shader.orig, Shader.lastTarget.L
	L.ColorShift_Top = o.ColorShift_Top:Lerp(a, kc)
	L.ColorShift_Bottom = o.ColorShift_Bottom:Lerp(b, kc)
	L.FogColor = o.FogColor:Lerp(Color3.fromHSV(h, 0.6, 0.25), kc)
	pcall(function()
		Lighting.ColorShift_Top, Lighting.ColorShift_Bottom, Lighting.FogColor = L.ColorShift_Top, L.ColorShift_Bottom, L.FogColor
		local tint = Color3.new(1, 1, 1):Lerp(a:Lerp(Color3.new(1, 1, 1), 0.75), kc)
		Shader.lastTarget.fx.CC.TintColor = tint
		Shader.fx.CC.TintColor = tint
		Shader.lastTarget.fx.Atmo.Color = a
		Shader.fx.Atmo.Color = a
	end)
end

