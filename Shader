--// UTIL
Util.hex = hex
function Util.new(class, props, parent)
	local o = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			pcall(function() o[k] = v end)
		end
	end
	if parent then o.Parent = parent end
	return o
end
function Util.lerp(a, b, t) return a + (b - a) * t end
function Util.seq(cols)
	local n, kp = #cols, {}
	for i, c in ipairs(cols) do kp[i] = ColorSequenceKeypoint.new((i - 1) / (n - 1), c) end
	return ColorSequence.new(kp)
end

local cursorDepth, savedIcon = 0, nil
function Util.cursor(on, icon)
	if UIS.TouchEnabled and not UIS.MouseEnabled then return end
	pcall(function()
		if on then
			if cursorDepth == 0 then savedIcon = UIS.MouseIcon end
			cursorDepth += 1
			UIS.MouseIcon = icon or "rbxasset://SystemCursors/PointingHand"
		else
			cursorDepth = math.max(0, cursorDepth - 1)
			if cursorDepth == 0 then UIS.MouseIcon = savedIcon or "" end
		end
	end)
end
function Util.cursorReset()
	cursorDepth = 0
	pcall(function() UIS.MouseIcon = savedIcon or "" end)
end

--// CLEANUP REGISTRY
function Cleanup.new()
	local self = { items = {} }
	function self.add(x) table.insert(self.items, x) return x end
	function self.run()
		for i = #self.items, 1, -1 do
			local x = self.items[i]
			pcall(function()
				local t = typeof(x)
				if t == "RBXScriptConnection" then x:Disconnect()
				elseif t == "Instance" then x:Destroy()
				elseif t == "thread" then task.cancel(x)
				elseif t == "function" then x()
				elseif t == "table" then
					if x.Destroy then x:Destroy() elseif x.Disconnect then x:Disconnect() end
				end
			end)
		end
		table.clear(self.items)
	end
	return self
end
local MainC, UiC = Cleanup.new(), Cleanup.new()

--// SIGNAL / EVENT BUS
Signal.__index = Signal
function Signal.new() return setmetatable({ _h = {} }, Signal) end
function Signal:Connect(fn)
	local h = { fn = fn }
	table.insert(self._h, h)
	return { Disconnect = function()
		h.dead = true
		local i = table.find(self._h, h)
		if i then table.remove(self._h, i) end
	end }
end
function Signal:Fire(...)
	for _, h in ipairs(table.clone(self._h)) do
		if not h.dead then task.spawn(h.fn, ...) end
	end
end
function Signal:Destroy() table.clear(self._h) end
Signal.Bus = {}
function Signal.On(name, fn)
	Signal.Bus[name] = Signal.Bus[name] or Signal.new()
	return Signal.Bus[name]:Connect(fn)
end
function Signal.Emit(name, ...)
	if Signal.Bus[name] then Signal.Bus[name]:Fire(...) end
end

--// REACTIVE STATE
local State = {}
State.__index = State
function State.new(init) return setmetatable({ _d = init, _s = Signal.new() }, State) end
function State:Get(k) return self._d[k] end
function State:Set(k, v)
	if self._d[k] == v then return end
	self._d[k] = v
	self._s:Fire(k, v)
end
function State:Subscribe(fn) return self._s:Connect(fn) end

local DEF = {
	sfx = true, sfxVol = 1, ambient = true, reduced = false, toasts = true, snap = false, save = true,
	intensity = 1, brightness = 0, contrast = 0, saturation = 0, bloom = 1, blur = 0,
	shader = false, open = false, collapsed = false, toggleHidden = false,
}
Store = State.new(table.clone(DEF))
local PERSIST_KEYS = { "sfx", "sfxVol", "ambient", "reduced", "toasts", "snap", "save", "intensity",
	"brightness", "contrast", "saturation", "bloom", "blur", "shader", "toggleHidden" }
local Pos = {}

--// PERSISTENCE
function Persist.load()
	if not Caps.writefile then return end
	local ok, raw = pcall(function()
		if isfile(Config.SaveFile) then return readfile(Config.SaveFile) end
	end)
	if not ok or not raw then return end
	local ok2, d = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok2 or type(d) ~= "table" then return end
	for _, k in ipairs(PERSIST_KEYS) do
		local v = d[k]
		if v ~= nil and type(v) == type(DEF[k]) and k ~= "shader" then Store._d[k] = v end
	end
	if type(d.shader) == "string" then Persist.savedShader = d.shader end
	if type(d.pos) == "table" then
		for _, k in ipairs({ "panel", "toggle" }) do
			local p = d.pos[k]
			if type(p) == "table" and type(p.x) == "number" and type(p.y) == "number" then
				Pos[k] = { x = math.clamp(p.x, 0, 1), y = math.clamp(p.y, 0, 1) }
			end
		end
	end
end
function Persist.save()
	if not Caps.writefile or not Config.SavePosition or not Store:Get("save") or Persist.pending then return end
	Persist.pending = true
	task.delay(0.6, function()
		Persist.pending = false
		if NeonSuite._unloading then return end
		local d = { v = 1, pos = Pos }
		for _, k in ipairs(PERSIST_KEYS) do d[k] = Store:Get(k) end
		pcall(function() writefile(Config.SaveFile, HttpService:JSONEncode(d)) end)
	end)
end

--// SOUND MANAGER
Sound.cache, Sound.last = {}, {}
function Sound.init()
	pcall(function() local _ = SoundService.RespectFilteringEnabled end)
	local grp = Util.new("SoundGroup", { Name = "NeonSuite_SFX", Volume = 1 }, SoundService)
	MainC.add(grp)
	Sound.group = grp
	for name, cfg in pairs(Config.Sfx) do
		local s = Util.new("Sound", {
			Name = name, SoundId = "rbxassetid://" .. cfg.id, Volume = cfg.vol,
			PlaybackSpeed = cfg.speed or 1, SoundGroup = grp,
		}, grp)
		if cfg.pitch and cfg.pitch ~= 1 then
			Util.new("PitchShiftSoundEffect", { Octave = cfg.pitch }, s)
		end
		Sound.cache[name] = s
	end
	Sound.refreshVolume()
end
function Sound.refreshVolume()
	if Sound.group then Sound.group.Volume = Store:Get("sfx") and Store:Get("sfxVol") or 0 end
end
function Sound.play(name)
	if not Store:Get("sfx") then return end
	local s, now = Sound.cache[name], os.clock()
	if not s or (Sound.last[name] and now - Sound.last[name] < 0.05) then return end
	Sound.last[name] = now
	pcall(function() s.TimePosition = 0 s:Play() end)
end

--// ANIMATE MANAGER
local EASE = { Quint = Enum.EasingStyle.Quint, Sine = Enum.EasingStyle.Sine, Expo = Enum.EasingStyle.Expo }
Animate.active = {}
function Animate.tween(inst, props, dur, style, dir)
	if Store:Get("reduced") then dur = math.min(dur, 0.01) end
	local tw = TweenService:Create(inst, TweenInfo.new(dur, EASE[style or "Quint"], dir or Enum.EasingDirection.Out), props)
	Animate.active[tw] = true
	tw.Completed:Once(function() Animate.active[tw] = nil end)
	tw:Play()
	return tw
end
function Animate.stopAll()
	for tw in pairs(Animate.active) do pcall(function() tw:Cancel() end) end
	table.clear(Animate.active)
end

--// DRAG MANAGER
function Drag.viewport() return UI.viewport() end
function Drag.clamp(v, size)
	local vp, M, half = Drag.viewport(), Config.Margin, size / 2
	local minx, maxx, miny, maxy = M + half.X, vp.X - M - half.X, M + half.Y, vp.Y - M - half.Y
	if maxx < minx then minx, maxx = vp.X / 2, vp.X / 2 end
	if maxy < miny then miny, maxy = vp.Y / 2, vp.Y / 2 end
	return Vector2.new(math.clamp(v.X, minx, maxx), math.clamp(v.Y, miny, maxy))
end
function Drag.make(handle, target, o)
	o = o or {}
	local dragging, input0, mouse0, pos0, goal, cur, moved, hb = false, nil, nil, nil, nil, nil, 0, nil
	local function sizeV() return o.size() end
	local function setPos(v) target.Position = UDim2.fromOffset(v.X, v.Y) end
	local function snapGoal(g)
		if not (o.snap and o.snap()) then return g end
		local vp, half, M, T = Drag.viewport(), sizeV() / 2, Config.Margin, 28
		local x, y = g.X, g.Y
		if x - half.X - M < T then x = M + half.X elseif vp.X - (x + half.X) - M < T then x = vp.X - M - half.X end
		if y - half.Y - M < T then y = M + half.Y elseif vp.Y - (y + half.Y) - M < T then y = vp.Y - M - half.Y end
		return Vector2.new(x, y)
	end
	local function step(dt)
		cur = cur:Lerp(goal, 1 - math.exp(-dt * 24))
		setPos(cur)
		if not dragging and (cur - goal).Magnitude < 0.4 then
			cur = goal
			setPos(cur)
			if hb then hb:Disconnect() hb = nil end
			if o.onEnd then o.onEnd(cur, moved) end
		end
	end
	local function finish()
		if not dragging then return end
		dragging = false
		Util.cursor(false)
		if moved < 6 then
			if o.onClick then o.onClick() end
		else
			goal = snapGoal(goal)
		end
	end
	handle.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch) and not dragging then
			dragging, input0, moved = true, input, 0
			mouse0 = Vector2.new(input.Position.X, input.Position.Y)
			pos0 = Vector2.new(target.Position.X.Offset, target.Position.Y.Offset)
			goal, cur = pos0, pos0
			Util.cursor(true, "rbxasset://SystemCursors/ClosedHand")
			Sound.play("drag")
			if not hb then hb = RunService.Heartbeat:Connect(step) end
		end
	end)
	MainC.add(UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input == input0) then
			local d = Vector2.new(input.Position.X, input.Position.Y) - mouse0
			moved = math.max(moved, d.Magnitude)
			if moved >= 6 then goal = Drag.clamp(pos0 + d, sizeV()) end
		end
	end))
	MainC.add(UIS.InputEnded:Connect(function(input)
		if dragging and (input == input0 or (input.UserInputType == Enum.UserInputType.MouseButton1
			and input0.UserInputType == Enum.UserInputType.MouseButton1)) then
			finish()
		end
	end))
	MainC.add(function() if hb then hb:Disconnect() end end)
end

