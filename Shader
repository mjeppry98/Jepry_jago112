function UI.mount(gui)
	local tries = {}
	if Caps.gethui then table.insert(tries, function() return gethui() end) end
	table.insert(tries, function() return CoreGui end)
	table.insert(tries, function() return getLocalPlayer():WaitForChild("PlayerGui", 10) end)
	for _, f in ipairs(tries) do
		local ok, p = pcall(f)
		if ok and p then
			local ok2 = pcall(function() gui.Parent = p end)
			if ok2 and gui.Parent ~= nil then return true end
		end
	end
	return false
