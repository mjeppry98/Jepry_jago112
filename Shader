--// CORE
local loopT, acc, fpsN, fpsT, watchT, dogT = 0, 0, 0, 0, 0, 0

function Core.loop(dt)
	loopT += dt
	acc += dt
	fpsN += 1
	fpsT += dt
	if fpsT >= 0.5 then
		UI.fps = fpsN / fpsT
		fpsN, fpsT = 0, 0
		if UI.fpsLabel and Store:Get("open") then
			UI.fpsLabel.Text = string.format("%d FPS", math.floor(UI.fps + 0.5))
		end
	end
	if acc < 1 / 30 then return end
	acc = 0
	local t = loopT
	local anim = Store:Get("ambient") and not Store:Get("reduced")
	if anim then
		if Store:Get("open") and UI.borderGrad then
			UI.borderGrad.Rotation = (t * 45) % 360
			UI.glowStroke.Transparency = 0.8 + 0.1 * math.sin(t * 1.6)
			UI.titleStroke.Transparency = 0.5 + 0.25 * math.sin(t * 1.6)
			UI.scanline.Position = UDim2.new(0, 0, (t * 0.12) % 1, 0)
			for i, l in ipairs(UI.hLines) do
				l.Position = UDim2.new(0, 0, ((i - 1) / #UI.hLines + t * 0.03) % 1, 0)
			end
			for i, l in ipairs(UI.vLines) do
				l.Position = UDim2.new(((i - 1) / #UI.vLines + t * 0.02) % 1, 0, 0, 0)
			end
		end
		if UI.tGlow and UI.tHolder.Visible then
			UI.tGlow.BackgroundTransparency = 0.78 + 0.12 * math.sin(t * 2.4)
			UI.tStrokeGrad.Rotation = (t * 60) % 360
		end
		if Shader.scanOn and UI.scanBar then
			UI.scanBar.Visible = true
			UI.scanBar.Position = UDim2.new(0, 0, (t * 0.18) % 1, 0)
		elseif UI.scanBar then
			UI.scanBar.Visible = false
		end
		Shader.aurora(t)
	elseif UI.scanBar then
		UI.scanBar.Visible = false
	end
	watchT += 1 / 30
	if watchT >= 0.75 then
		watchT = 0
		pcall(Shader.watch)
	end
	dogT += 1 / 30
	if dogT >= 1.5 then
		dogT = 0
		-- [FIX] IsDescendantOf(game) bisa false meski GUI valid di gethui.
		if UI.gui and UI.gui.Parent == nil then
			local ok = pcall(UI.mount, UI.gui)
			if not ok or UI.gui.Parent == nil then
				local wasOpen = Store:Get("open")
				UI.destroy()
				Store:Set("open", false)
				UI.build()
				if wasOpen then UI.setOpen(true) end
			end
		end
	end
end

function Core.runBoot()
	local steps = {
		{ "INITIALIZING CORE", 0.15 }, { "MOUNTING AUDIO", 0.3 }, { "COMPILING SHADERS", 0.55 },
		{ "BINDING POST EFFECTS", 0.75 }, { "SYNCING STATE", 0.9 }, { "READY", 1 },
	}
	for _, s in ipairs(steps) do
		if NeonSuite._unloading or not UI.boot or not UI.boot.Parent then return end
		UI.bootText.Text = s[1]
		Animate.tween(UI.bootFill, { Size = UDim2.fromScale(s[2], 1) }, 0.25, "Quint")
		task.wait(0.22)
	end
	task.wait(0.15)
	if UI.boot and UI.boot.Parent then
		Animate.tween(UI.boot, { GroupTransparency = 1 }, 0.4, "Sine")
		task.wait(0.45)
		if UI.boot then UI.boot.Visible = false end
	end
end

function Core.bind()
	MainC.add(RunService.Heartbeat:Connect(function(dt)
		local ok = pcall(Core.loop, dt)
		if not ok and Config.Debug then warn("[NeonSuite] loop error") end
	end))
	MainC.add(UIS.InputChanged:Connect(function(input)
		local a = UI.activeSlider
		if a and (input.UserInputType == Enum.UserInputType.MouseMovement or input == a.input) then
			a.update(input)
		end
	end))
	MainC.add(UIS.InputEnded:Connect(function(input)
		local a = UI.activeSlider
		if a and (input == a.input or (input.UserInputType == Enum.UserInputType.MouseButton1
			and a.input.UserInputType == Enum.UserInputType.MouseButton1)) then
			a.finish()
		end
	end))
	MainC.add(UIS.InputBegan:Connect(function(input, gp)
		if UIS:GetFocusedTextBox() then return end
		if input.KeyCode == Config.Hotkeys.Toggle then
			UI.setOpen(not Store:Get("open"))
		elseif input.KeyCode == Config.Hotkeys.HideToggle then
			Store:Set("toggleHidden", not Store:Get("toggleHidden"))
		end
	end))
	MainC.add(Store:Subscribe(function(k, v)
		if k == "sfx" or k == "sfxVol" then Sound.refreshVolume() end
		if k == "toggleHidden" and UI.tHolder then
			if v then
				Animate.tween(UI.tScale, { Scale = 0 }, 0.3, "Quint", Enum.EasingDirection.In)
				task.delay(0.32, function()
					if Store:Get("toggleHidden") and UI.tHolder then UI.tHolder.Visible = false end
				end)
			else
				UI.tHolder.Visible = true
				Animate.tween(UI.tScale, { Scale = 1 }, 0.4, "Expo")
			end
		end
		for _, pk in ipairs(PERSIST_KEYS) do
			if pk == k then Persist.save() break end
		end
	end))
	-- [FIX] Guard LocalPlayer
	local lp = getLocalPlayer()
	if lp then
		MainC.add(lp.CharacterAdded:Connect(function()
			task.wait(0.5)
			if UI.gui and UI.gui.Parent == nil then pcall(UI.mount, UI.gui) end
			Shader.watch()
		end))
	end
	local cam = Workspace.CurrentCamera
	if cam then
		MainC.add(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() UI.relayout() end))
	end
end

function Core.Unload()
	if NeonSuite._unloading then return end
	NeonSuite._unloading = true
	pcall(Shader.restoreImmediate)
	pcall(Util.cursorReset)
	pcall(Animate.stopAll)
	UiC.run()
	MainC.run()
	if genv.__NeonSuite == NeonSuite then genv.__NeonSuite = nil end
end
NeonSuite.Unload = Core.Unload

function Core.start()
	pcall(Persist.load)
	Sound.init()
	Shader.init()
	UI.build()
	Core.bind()
	task.spawn(function()
		UI.setOpen(true)
		Core.runBoot()
		local saved = Persist.savedShader
		if saved and Shader.byName[saved] then Shader.apply(saved, true, 0.8) end
		UI.notify(Config.Name, "Ready. RightShift toggles the panel.", "info")
	end)
end

