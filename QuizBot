refreshHistory = function()
    if not ExtrasTab then return end
    for _, card in ipairs(historyCards) do
        if card and card.Destroy then pcall(function() card:Destroy() end) end
    end
    table.clear(historyCards)

    if #State.quizHistory == 0 then
        local c = addTextCard(ExtrasTab, "📜 History", "No quizzes have been played yet.")
        if c then table.insert(historyCards, c) end
        return
    end
    local limit = math.min(#State.quizHistory, 10)
    for i = 1, limit do
        local h = State.quizHistory[i]
        local text = string.format(
            "🏆 Winner: %s\n📂 %s | 🎯 %s\n📅 %s | 📊 %d questions",
            h.winner or "—", h.category or "?", h.difficulty or "?",
            h.date or "—", h.totalQuestions or 0
        )
        local card = addTextCard(ExtrasTab, "#" .. i, text)
        if card then table.insert(historyCards, card) end
    end
end

refreshStats = function()
    if not ExtrasTab then return end
    for _, card in ipairs(statsCards) do
        if card and card.Destroy then pcall(function() card:Destroy() end) end
    end
    table.clear(statsCards)

    local entries = {}
    for userId, stats in pairs(State.playerStats) do
        local p = Players:GetPlayerByUserId(userId)
        local name = p and p.Name or ("User" .. userId)
        table.insert(entries, { name = name, stats = stats })
    end
    if #entries == 0 then
        local c = addTextCard(ExtrasTab, "🏅 Stats", "No player statistics recorded yet.")
        if c then table.insert(statsCards, c) end
        return
    end
    table.sort(entries, function(a, b)
        return (a.stats.correct or 0) > (b.stats.correct or 0)
    end)
    for i, e in ipairs(entries) do
        local s = e.stats
        local text = string.format(
            "👤 %s\n🎮 Games: %d | ✅ Correct: %d\n⭐ Best Score: %d | 🔥 Best Streak: %d",
            e.name, s.games or 0, s.correct or 0, s.bestScore or 0, s.bestStreak or 0
        )
        local card = addTextCard(ExtrasTab, "#" .. i, text)
        if card then table.insert(statsCards, card) end
    end
end

