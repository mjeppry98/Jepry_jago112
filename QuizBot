local function buildKeyOptions()
    local opts = {}
    for i, entry in ipairs(State.savedApiKeys) do
        table.insert(opts, string.format("%d. %s", i, entry.label))
    end
    if #opts == 0 then opts = { "No keys saved" } end
    return opts
end

local function buildCurrentOption()
    if State.activeApiKeyIndex == 0 or #State.savedApiKeys == 0 then
        return { "No keys saved" }
    end
    local entry = State.savedApiKeys[State.activeApiKeyIndex]
    return { string.format("%d. %s", State.activeApiKeyIndex, entry.label) }
end

