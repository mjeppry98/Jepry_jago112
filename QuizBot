local function broadcast(text)
    local ok = pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channels = TextChatService:FindFirstChild("TextChannels")
            if channels then
                local general = channels:FindFirstChild("RBXGeneral")
                if general then
                    general:DisplaySystemMessage(text)
                    return true
                end
                for _, ch in ipairs(channels:GetChildren()) do
                    if ch:IsA("TextChannel") then
                        ch:DisplaySystemMessage(text)
                        return true
                    end
                end
            end
        end
        return false
    end)
    if ok then return end
    pcall(function() StarterGui:SetCore("ChatMakeSystemMessage", { Text = text }) end)
end

local function callMistral(messages, useJson)
    local activeKey = getActiveKey()
    if not activeKey or activeKey == "" then return false, "No active API key selected." end
    local body = HttpService:JSONEncode({
        model           = State.lastModelUsed,
        messages        = messages,
        temperature     = 0.9,
        response_format = useJson and { type = "json_object" } or nil,
    })
    local res = httpRequest({
        Url     = MISTRAL_ENDPOINT,
        Method  = "POST",
        Headers = {
            ["Content-Type"]  = "application/json",
            ["Authorization"] = "Bearer " .. tostring(activeKey),
        },
        Body = body,
    })
    local success, respBody, code = parseHttpResponse(res)
    if not success then return false, "HTTP " .. tostring(code) .. " — " .. tostring(respBody) end
    pcall(function()
        local decoded = HttpService:JSONDecode(respBody)
        if decoded.usage then
            State.lastCallPrompt     = decoded.usage.prompt_tokens or 0
            State.lastCallCompletion = decoded.usage.completion_tokens or 0
        end
    end)
    State.lastFetched = getTimestamp()
    return true, respBody
end

local function fetchModels()
    local activeKey = getActiveKey()
    if not activeKey or activeKey == "" then return false, 0 end
    local res = httpRequest({
        Url     = MISTRAL_MODELS_ENDPOINT,
        Method  = "GET",
        Headers = { ["Authorization"] = "Bearer " .. tostring(activeKey) },
    })
    local success, respBody = parseHttpResponse(res)
    if not success then return false, 0 end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(respBody) end)
    if not ok or not decoded.data then return false, 0 end
    return true, #decoded.data
end

local function generateQuestions(category, difficulty)
    local prompt = string.format([[
Generate %d multiple-choice quiz questions.
Category: %s
Difficulty: %s
Rules:
- Each question must be unique, varied, and randomized.
- Exactly 4 choices per question.
- Provide the correct answer as index 0-3.
Return ONLY JSON matching: {"questions":[{"question":"...","choices":["a","b","c","d"],"answer":0}, ...]}
]], State.totalQuestions, category, difficulty)
    local ok, body = callMistral({
        { role = "system", content = "You are a quiz generator. Output strictly valid JSON." },
        { role = "user",   content = prompt }
    }, true)
    if not ok then return nil, body end
    local decoded = HttpService:JSONDecode(body)
    local content = decoded.choices[1].message.content
    local ok2, parsed = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 or not parsed.questions then return nil, "Failed to parse questions." end
    return parsed.questions
end

