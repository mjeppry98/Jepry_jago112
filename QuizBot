local function tallyVotes()
    local counts = {}
    for _, choice in pairs(State.votes) do
        counts[choice] = (counts[choice] or 0) + 1
    end
    local best, bestN = nil, 0
    for k, n in pairs(counts) do
        if n > bestN then best, bestN = k, n end
    end
    return best
end

local function calculatePoints(userId)
    local points = 1
    if State.speedBonusEnabled and State.firstAnswererId == userId then
        points = points + 1
    end
    if State.streakBonusEnabled then
        local stats = State.playerStats[userId]
        local streak = stats and stats.streak or 0
        if streak >= 3 then
            points = points + 1
        end
    end
    return points
end

local function handleChat(speaker, message)
    local num = tonumber(message:match("^%s*(%d+)%s*$"))
    if not num then return end

    if State.phase == "votingCategory" then
        local total = #getAllCategories()
        if num >= 1 and num <= total and not State.votes[speaker.UserId] then
            State.votes[speaker.UserId] = num
            broadcast("🗳️ " .. speaker.Name .. " voted.")
        end
    elseif State.phase == "votingDifficulty" then
        if num >= 1 and num <= #DIFFICULTIES and not State.votes[speaker.UserId] then
            State.votes[speaker.UserId] = num
            broadcast("🗳️ " .. speaker.Name .. " voted.")
        end
    elseif State.phase == "quiz" then
        if num >= 1 and num <= 4 and not State.answers[speaker.UserId] then
            State.answers[speaker.UserId] = num - 1
            local q = State.questions[State.currentIndex]
            if not q then return end

            local correct = ((num - 1) == q.answer)
            if correct and not State.firstAnswererId then
                State.firstAnswererId = speaker.UserId
            end

            if not State.playerStats[speaker.UserId] then
                State.playerStats[speaker.UserId] = {
                    games = 0, correct = 0, bestScore = 0, bestStreak = 0, streak = 0
                }
            end
            local ps = State.playerStats[speaker.UserId]

            if correct then
                ps.correct = ps.correct + 1
                ps.streak  = ps.streak + 1
                if ps.streak > ps.bestStreak then ps.bestStreak = ps.streak end

                local pts = calculatePoints(speaker.UserId)
                State.scores[speaker.UserId] = (State.scores[speaker.UserId] or 0) + pts
                local bonusText = pts > 1 and (" (+" .. (pts - 1) .. " bonus)") or ""
                broadcast("✅ " .. speaker.Name .. " answered correctly!" .. bonusText)
                if speaker == localPlayer then playSound(SOUND.correct) end
            else
                ps.streak = 0
                broadcast("❌ Wrong — " .. speaker.Name)
                if speaker == localPlayer then playSound(SOUND.wrong) end
            end
        end
    end
end

