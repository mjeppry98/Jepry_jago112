end

startQuizFlow = function()
    if running then broadcast("⚠️ Quiz already running.") return end
    running = true

    State.questions      = {}
    State.currentIndex   = 0
    State.scores         = {}
    State.answers        = {}
    State.votes          = {}
    State.skipRequested  = false
    State.endRequested   = false
    State.firstAnswererId = nil

    local ok, err = pcall(function()
        if State.mode == "Direct" then
            if not State.category then State.category = "Science" end
            if not State.difficulty then State.difficulty = "Medium" end
            State.phase = "generating"
            refreshUI()
            broadcast("══════════════════════════")
            broadcast("🎯 HOST SELECTION")
            broadcast("══════════════════════════")
            broadcast("📂 Category: " .. State.category)
            broadcast("🎯 Difficulty: " .. State.difficulty)
            task.wait(2)
        else
            State.phase = "votingCategory"
            State.votes = {}
            local allCats = getAllCategories()
            broadcast("══════════════════════════")
            broadcast("📊 VOTING: CATEGORY (" .. State.voteTime .. "s)")
            broadcast("══════════════════════════")
            task.wait(0.3)
            for i, c in ipairs(allCats) do broadcast("  " .. i .. ". " .. c) end
            broadcast("💬 Type the NUMBER to vote!")
            task.wait(State.voteTime)

            local catIdx      = tallyVotes() or 1
            local chosenLabel = allCats[catIdx] or allCats[1]
            State.category    = getCategoryRaw(chosenLabel)
            broadcast("✅ Category: " .. chosenLabel)
            task.wait(2)

            State.phase = "votingDifficulty"
            State.votes = {}
            broadcast("══════════════════════════")
            broadcast("📊 VOTING: DIFFICULTY (" .. State.voteTime .. "s)")
            broadcast("══════════════════════════")
            task.wait(0.3)
            for i, d in ipairs(DIFFICULTIES) do broadcast("  " .. i .. ". " .. d) end
            broadcast("💬 Type the NUMBER to vote!")
            task.wait(State.voteTime)

            local diffIdx     = tallyVotes() or 2
            State.difficulty  = DIFFICULTIES_RAW[DIFFICULTIES[diffIdx]] or "Medium"
            broadcast("✅ Difficulty: " .. DIFFICULTIES[diffIdx])
            task.wait(2)
        end

        State.phase = "generating"
        refreshUI()
        broadcast("⏳ Generating " .. State.totalQuestions .. " questions...")
        broadcast("   (This may take 10-30 seconds)")
        local qs, err2 = generateQuestions(State.category, State.difficulty)
        if not qs then
            broadcast("❌ Failed to generate quiz: " .. tostring(err2))
            State.phase = "idle"
            running     = false
            refreshUI()
            return
        end

        if State.shuffleQuestions then
            for i = #qs, 2, -1 do
                local j = math.random(i)
                qs[i], qs[j] = qs[j], qs[i]
            end
            broadcast("🎲 Questions have been shuffled.")
        end

        State.questions        = qs
        State.lastGeneratedQuiz = qs
        refreshAPIInfo()
        broadcast("🎉 Quiz is ready! Answer with 1-4.")
        task.wait(2)

        State.phase = "quiz"
        for i = 1, #qs do
            if State.endRequested then break end

            State.currentIndex    = i
            State.answers         = {}
            State.skipRequested   = false
            State.firstAnswererId = nil

            local q = qs[i]
            broadcast("──────────────────────────")
            broadcast("❓ Question " .. i .. "/" .. #qs .. " [" .. State.category .. " | " .. State.difficulty .. "]")
            task.wait(0.2)
            broadcast(q.question)
            task.wait(0.2)
            for k, c in ipairs(q.choices) do
                broadcast("  " .. k .. ". " .. c)
            end

            local endT = tick() + State.questionTime
            while tick() < endT do
                if State.skipRequested or State.endRequested then break end
                local allDone = true
                for _, p in ipairs(Players:GetPlayers()) do
                    if not State.answers[p.UserId] then allDone = false break end
                end
                if allDone then break end
                task.wait(0.4)
            end
            task.wait(1)

            broadcast("✅ Answer: " .. (q.answer + 1) .. ". " .. q.choices[q.answer + 1])
            refreshUI()
            task.wait(2)
        end

        State.phase = "leaderboard"
        broadcast("══════════════════════════")
        broadcast("🏆  FINAL LEADERBOARD  🏆")
        broadcast("══════════════════════════")

        local list = {}
        for userId, sc in pairs(State.scores) do
            local p = Players:GetPlayerByUserId(userId)
            table.insert(list, {
                name   = p and p.Name or ("User" .. userId),
                score  = sc,
                userId = userId,
            })
        end
        table.sort(list, function(a, b) return a.score > b.score end)

        for i, e in ipairs(list) do
            local medal = i == 1 and "🥇" or i == 2 and "🥈" or i == 3 and "🥉" or ("#" .. i)
            broadcast("  " .. medal .. "  " .. e.name .. " — " .. e.score .. "/" .. State.totalQuestions)
        end
        broadcast("🏁 Quiz complete!")

        for userId, sc in pairs(State.scores) do
            if not State.playerStats[userId] then
                State.playerStats[userId] = { games = 0, correct = 0, bestScore = 0, bestStreak = 0, streak = 0 }
            end
            local ps = State.playerStats[userId]
            ps.games = ps.games + 1
            if sc > ps.bestScore then ps.bestScore = sc end
        end

        local winnerName = list[1] and list[1].name or "—"
        table.insert(State.quizHistory, 1, {
            date           = getTimestamp(),
            category       = State.category,
            difficulty     = State.difficulty,
            totalQuestions = State.totalQuestions,
            winner         = winnerName,
            scores         = list,
        })
        if #State.quizHistory > 30 then State.quizHistory[31] = nil end

        pcall(saveHistoryToFile)
        if refreshHistory then pcall(refreshHistory) end
        if refreshStats   then pcall(refreshStats)   end
    end)

    if not ok then
        warn("[QuizBot] startQuizFlow error: " .. tostring(err))
        broadcast("❌ Quiz error: " .. tostring(err))
        Window:Notify({ title = "❌ Quiz Error", content = tostring(err), duration = 10 })
    end

    State.phase = "idle"
    running     = false
    if refreshUI then refreshUI() end
end

if not State.category then State.category = "Science" end
if not State.difficulty then State.difficulty = "Medium" end

