local function getRequestFunc()
    for _, name in ipairs({"request","http_request","httprequest","secure_request","async_request","fetch"}) do
        local ok, fn = pcall(function() return rawget(getgenv(), name) end)
        if ok and type(fn) == "function" then return fn end
    end
    for _, ns in ipairs({"syn","fluxus","http","KRNL","wave","electron","solara","delta","comet","seliware","Celery","macsploit","coco","JJSploit","Vega","Swift","Xeno","AWP"}) do
        local ok, tbl = pcall(function() return rawget(getgenv(), ns) end)
        if ok and type(tbl) == "table" then
            for _, meth in ipairs({"request","http_request","httprequest","Request","HttpRequest"}) do
                local ok2, fn = pcall(function() return rawget(tbl, meth) end)
                if ok2 and type(fn) == "function" then return fn end
            end
        end
    end
    return nil
end

local _requestFn = getRequestFunc()

local function httpRequest(params)
    if not _requestFn then warn("[QuizBot] No HTTP executor function found."); return nil end
    local ok, res = pcall(_requestFn, params)
    if not ok then warn("[QuizBot] HTTP error: " .. tostring(res)); return nil end
    return res
end

local function parseHttpResponse(res)
    if not res then return false, "", nil end
    local bodyStr = res.Body or res.body or res.content or res.text or res.data or ""
    if type(bodyStr) ~= "string" then bodyStr = tostring(bodyStr) end
    local code    = res.StatusCode or res.status_code or res.status or res.Status
    local success = res.Success or res.success
    if success == nil then success = (code == 200) end
    return success, bodyStr, code
end

