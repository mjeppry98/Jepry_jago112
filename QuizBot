refreshExtrasStatus = function()
    if not (extrasStatusCard and extrasStatusCard.Set) then return end
    local trackedPlayers = 0
    for _ in pairs(State.playerStats) do trackedPlayers = trackedPlayers + 1 end
    local text = string.format(
        "⚡ Speed Bonus: %s\n🔥 Streak Bonus: %s\n🎲 Shuffle: %s\n💾 Auto-Save: %s\n📜 History Entries: %d\n🏅 Tracked Players: %d",
        State.speedBonusEnabled  and "✅ ON" or "❌ OFF",
        State.streakBonusEnabled and "✅ ON" or "❌ OFF",
        State.shuffleQuestions   and "✅ ON" or "❌ OFF",
        State.autoSaveConfig     and "✅ ON" or "❌ OFF",
        #State.quizHistory,
        trackedPlayers
    )
    pcall(function() extrasStatusCard:Set(text) end)
end

refreshUI = function()
    local bonusText = ""
    if State.speedBonusEnabled  then bonusText = bonusText .. "⚡" end
    if State.streakBonusEnabled then bonusText = bonusText .. "🔥" end
    if State.shuffleQuestions   then bonusText = bonusText .. "🎲" end

    if homeOverviewCard and homeOverviewCard.Set then
        local text = string.format(
            "📌 Status: %s\n" ..
            "🎮 Mode: %s\n" ..
            "📂 Category: %s\n" ..
            "🎯 Difficulty: %s\n" ..
            "📈 Progress: %d / %d\n" ..
            "⚡ Bonuses: %s",
            State.phase,
            getModeLabel(),
            State.category or "—",
            State.difficulty or "—",
            State.currentIndex,
            State.totalQuestions,
            (bonusText ~= "" and bonusText or "none")
        )
